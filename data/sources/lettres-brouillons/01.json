 "lettre": 1,
 "phrases": [
  {
   "zh": "早！",
   "pinyin": "zǎo",
   "fr": "Bonjour, de bon matin !",
   "en": "Good morning, bright and early!"
  },
  {
   "zh": "天明，是一大早。",
   "pinyin": "tiān míng shì yī dà zǎo",
   "fr": "Le jour se lève : il est très tôt.",
   "en": "Day is breaking: it is very early."
  },
  {
   "zh": "一大是天，人人是从。",
   "pinyin": "yī dà shì tiān rén rén shì cóng",
   "fr": "Un et grand font le ciel ; un homme et un homme font suivre.",
   "en": "One and big make sky; a person and a person make follow."
  },
  {
   "zh": "月月是朋，日月是明。",
   "pinyin": "yuè yuè shì péng rì yuè shì míng",
   "fr": "Une lune et une lune font l'ami ; le soleil et la lune font la clarté.",
   "en": "Moon and moon make friend; sun and moon make bright."
  },
  {
   "zh": "日十是早。",
   "pinyin": "rì shí shì zǎo",
   "fr": "Le soleil sur dix fait tôt.",
   "en": "Sun over ten makes early."
  },
  {
   "zh": "天天有日，月月有月。",
   "pinyin": "tiān tiān yǒu rì yuè yuè yǒu yuè",
   "fr": "Chaque jour a son soleil, chaque mois sa lune.",
   "en": "Every day has its sun, every month its moon."
  },
  {
   "zh": "人人有明天。",
   "pinyin": "rén rén yǒu míng tiān",
   "fr": "Chacun a un lendemain.",
   "en": "Everyone has a tomorrow."
  },
  {
   "zh": "明天有月？",
   "pinyin": "míng tiān yǒu yuè",
   "fr": "Demain, y aura-t-il la lune ?",
   "en": "Will there be a moon tomorrow?"
  }
 ],
