{
 "lettre": 2,
 "phrases": [
  {
   "zh": "好朋友：",
   "pinyin": "hǎo péng you",
   "fr": "Mon bon ami,",
   "en": "Dear friend,"
  },
  {
   "zh": "天有星星，又大又明。",
   "pinyin": "tiān yǒu xīng xing yòu dà yòu míng",
   "fr": "Le ciel est plein d'étoiles, grandes et claires.",
   "en": "The sky is full of stars, big and bright."
  },
  {
   "zh": "门口有一女子。",
   "pinyin": "mén kǒu yǒu yī nǚ zǐ",
   "fr": "À la porte, il y a une jeune femme.",
   "en": "At the door there is a young woman."
  },
  {
   "zh": "女子问：「学生？」",
   "pinyin": "nǚ zǐ wèn xué sheng",
   "fr": "Elle me demande : « Un élève ? »",
   "en": "She asks me: “A student?”"
  },
  {
   "zh": "是！一只学生！",
   "pinyin": "shì yī zhī xué sheng",
   "fr": "Oui ! Un élève à plumes !",
   "en": "Yes! A feathered student!"
  },
  {
   "zh": "天天学，好好学。",
   "pinyin": "tiān tiān xué hǎo hǎo xué",
   "fr": "J'apprends chaque jour, et j'apprends bien.",
   "en": "I study every day, and I study well."
  },
  {
   "zh": "明天又学。",
   "pinyin": "míng tiān yòu xué",
   "fr": "Demain, j'apprends encore.",
   "en": "Tomorrow, I study again."
  },
  {
   "zh": "好朋友，是学生？",
   "pinyin": "hǎo péng you shì xué sheng",
   "fr": "Et toi, mon ami, tu es élève ?",
   "en": "And you, dear friend, are you a student?"
  }
 ],
