 "phrases": [
  {
   "zh": "好朋友：",
   "pinyin": "hǎo péng you",
   "fr": "Mon bon ami,",
   "en": "Dear friend,"
  },
  {
   "zh": "今天，山里。",
   "pinyin": "jīn tiān shān lǐ",
   "fr": "Aujourd'hui : la montagne.",
   "en": "Today: up in the mountains."
  },
  {
   "zh": "山好高，月好小。",
   "pinyin": "shān hǎo gāo yuè hǎo xiǎo",
   "fr": "La montagne est si haute, la lune si petite.",
   "en": "The mountain is so high, the moon so small."
  },
  {
   "zh": "山里有古门，古门有中文：「山高月小」。",
   "pinyin": "shān lǐ yǒu gǔ mén gǔ mén yǒu zhōng wén shān gāo yuè xiǎo",
   "fr": "Dans la montagne, il y a une porte ancienne, et sur la porte, du chinois : « Montagne haute, lune petite ».",
   "en": "In the mountains there is an ancient gate, with Chinese on it: “High mountain, small moon.”"
  },
  {
   "zh": "一只学生念：「山高月小。」",
   "pinyin": "yī zhī xué sheng niàn shān gāo yuè xiǎo",
   "fr": "L'élève à plumes lit à voix haute : « Montagne haute, lune petite. »",
   "en": "The feathered student reads it aloud: “High mountain, small moon.”"
  },
  {
   "zh": "中文好玩！",
   "pinyin": "zhōng wén hǎo wán",
   "fr": "Le chinois, c'est amusant !",
   "en": "Chinese is fun!"
  },
  {
   "zh": "好朋友，中文好学？",
   "pinyin": "hǎo péng you zhōng wén hǎo xué",
   "fr": "Mon ami, le chinois, ça s'apprend bien ?",
   "en": "Dear friend, is Chinese easy to learn?"
  }
 ],
