 "phrases": [
  {
   "zh": "好朋友：",
   "pinyin": "hǎo péng you",
   "fr": "Mon bon ami,",
   "en": "Dear friend,"
  },
  {
   "zh": "今天天气好。",
   "pinyin": "jīn tiān tiān qì hǎo",
   "fr": "Aujourd'hui, il fait beau.",
   "en": "The weather is fine today."
  },
  {
   "zh": "一大早，开门，见山！",
   "pinyin": "yī dà zǎo kāi mén jiàn shān",
   "fr": "Très tôt, j'ouvre la porte : la montagne !",
   "en": "Very early, I open the door: the mountain!"
  },
  {
   "zh": "女儿有水果，一只学生也有。",
   "pinyin": "nǚ ér yǒu shuǐ guǒ yī zhī xué sheng yě yǒu",
   "fr": "La fille de M. Wang a des fruits, l'élève à plumes aussi.",
   "en": "Mr Wang's daughter has fruit, and so does the feathered student."
  },
  {
   "zh": "山里电少，星星好明。",
   "pinyin": "shān lǐ diàn shǎo xīng xing hǎo míng",
   "fr": "Dans la montagne, il y a peu d'électricité, et les étoiles sont si claires.",
   "en": "There is little electricity in the mountains, and the stars are so bright."
  },
  {
   "zh": "一只学生好开心。",
   "pinyin": "yī zhī xué sheng hǎo kāi xīn",
   "fr": "L'élève à plumes est très content.",
   "en": "The feathered student is very happy."
  },
  {
   "zh": "好朋友，今天开心？",
   "pinyin": "hǎo péng you jīn tiān kāi xīn",
   "fr": "Mon ami, tu es content aujourd'hui ?",
   "en": "Dear friend, are you happy today?"
  }
