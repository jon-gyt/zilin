{
 "lettre": 12,
 "phrases": [
  {
   "zh": "好朋友：",
   "pinyin": "hǎo péng you",
   "fr": "Mon bon ami,",
   "en": "Dear friend,"
  },
  {
   "zh": "我下山了，飞了三天。",
   "pinyin": "wǒ xià shān le fēi le sān tiān",
   "fr": "Je suis descendu de la montagne, et j'ai volé trois jours.",
   "en": "I came down the mountain and flew for three days."
  },
  {
   "zh": "今天，我又见王先生、女儿！",
   "pinyin": "jīn tiān wǒ yòu jiàn wáng xiān sheng nǚ ér",
   "fr": "Aujourd'hui, je revois M. Wang et sa fille !",
   "en": "Today I see Mr Wang and his daughter again!"
  },
  {
   "zh": "女儿问：「一只学生，西山好玩？」",
   "pinyin": "nǚ ér wèn yī zhī xué sheng xī shān hǎo wán",
   "fr": "Elle me demande : « Élève à plumes, c'était bien, les Monts de l'Ouest ? »",
   "en": "She asks me: “Feathered student, were the Western Hills fun?”"
  },
  {
   "zh": "我：「太好玩了！」",
   "pinyin": "wǒ tài hǎo wán le",
   "fr": "Moi : « Formidable ! »",
   "en": "Me: “So much fun!”"
  },
  {
   "zh": "中午，王先生有面，也有肉。",
   "pinyin": "zhōng wǔ wáng xiān sheng yǒu miàn yě yǒu ròu",
   "fr": "À midi, M. Wang a des nouilles, et de la viande aussi.",
   "en": "At noon Mr Wang has noodles, and meat too."
  },
  {
   "zh": "明天，我再飞，去南方。",
   "pinyin": "míng tiān wǒ zài fēi qù nán fāng",
   "fr": "Demain, je reprends mon vol, vers le sud.",
   "en": "Tomorrow I fly off again, to the south."
  },
  {
   "zh": "好朋友，也去南方？",
   "pinyin": "hǎo péng you yě qù nán fāng",
   "fr": "Mon ami, tu viens aussi au sud ?",
   "en": "Dear friend, are you coming south too?"
  }
 ],
