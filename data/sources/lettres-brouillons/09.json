{
 "lettre": 9,
 "phrases": [
  {
   "zh": "好朋友：",
   "pinyin": "hǎo péng you",
   "fr": "Mon bon ami,",
   "en": "Dear friend,"
  },
  {
   "zh": "上午，我出门；中午，我上了西山。",
   "pinyin": "shàng wǔ wǒ chū mén zhōng wǔ wǒ shàng le xī shān",
   "fr": "Le matin, je suis parti ; à midi, j'étais en haut des Monts de l'Ouest.",
   "en": "In the morning I set out; at noon I reached the top of the Western Hills."
  },
  {
   "zh": "山上有老人。",
   "pinyin": "shān shàng yǒu lǎo rén",
   "fr": "Là-haut, il y a un vieil homme.",
   "en": "Up there lives an old man."
  },
  {
   "zh": "老人一百了！",
   "pinyin": "lǎo rén yī bǎi le",
   "fr": "Il a cent ans !",
   "en": "He is a hundred years old!"
  },
  {
   "zh": "老人问：「一只学生，也学中文？」",
   "pinyin": "lǎo rén wèn yī zhī xué sheng yě xué zhōng wén",
   "fr": "Il me demande : « Un élève à plumes ? Toi aussi, tu apprends le chinois ? »",
   "en": "He asks me: “A feathered student? You are learning Chinese too?”"
  },
  {
   "zh": "我：「是！天天学。」",
   "pinyin": "wǒ shì tiān tiān xué",
   "fr": "Moi : « Oui ! Chaque jour. »",
   "en": "Me: “Yes! Every day.”"
  },
  {
   "zh": "老人：「好！我也天天学。」",
   "pinyin": "lǎo rén hǎo wǒ yě tiān tiān xué",
   "fr": "Lui : « Bien ! Moi aussi, j'apprends chaque jour. »",
   "en": "Him: “Good! I study every day too.”"
  },
  {
   "zh": "好朋友，老了也学？",
   "pinyin": "hǎo péng you lǎo le yě xué",
   "fr": "Mon ami, quand tu seras vieux, tu apprendras encore ?",
   "en": "Dear friend, will you still study when you are old?"
  }
 ],
