{
 "lettre": 10,
 "phrases": [
  {
   "zh": "好朋友：",
   "pinyin": "hǎo péng you",
   "fr": "Mon bon ami,",
   "en": "Dear friend,"
  },
  {
   "zh": "山上两天，我好开心。",
   "pinyin": "shān shàng liǎng tiān wǒ hǎo kāi xīn",
   "fr": "Deux jours sur la montagne : je suis si content.",
   "en": "Two days on the mountain: I am so happy."
  },
  {
   "zh": "中午，老人有面。",
   "pinyin": "zhōng wǔ lǎo rén yǒu miàn",
   "fr": "À midi, le vieil homme a des nouilles.",
   "en": "At noon, the old man has noodles."
  },
  {
   "zh": "面好长！",
   "pinyin": "miàn hǎo cháng",
   "fr": "Qu'elles sont longues !",
   "en": "They are so long!"
  },
  {
   "zh": "我也来一口。",
   "pinyin": "wǒ yě lái yī kǒu",
   "fr": "J'en prends une bouchée, moi aussi.",
   "en": "I have a bite too."
  },
  {
   "zh": "今天，老人问：「明天再来？」",
   "pinyin": "jīn tiān lǎo rén wèn míng tiān zài lái",
   "fr": "Aujourd'hui, il me demande : « Tu reviens demain ? »",
   "en": "Today he asks me: “Will you come again tomorrow?”"
  },
  {
   "zh": "我：「再来！再见！」",
   "pinyin": "wǒ zài lái zài jiàn",
   "fr": "Moi : « Je reviendrai ! Au revoir ! »",
   "en": "Me: “I will come again! Goodbye!”"
  },
  {
   "zh": "好朋友，也来一口？",
   "pinyin": "hǎo péng you yě lái yī kǒu",
   "fr": "Mon ami, tu en prends une bouchée aussi ?",
   "en": "Dear friend, will you have a bite too?"
  }
 ],
