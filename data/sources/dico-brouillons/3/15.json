    "L3-0594": {"glose": "personnel, employés", "acceptions": [["N", "personnel, employés, agents"]], "exemples": [["工作人员都很热情。", "Gōngzuò rényuán dōu hěn rèqíng.", "Le personnel est très aimable."]]},
    "L3-0595": {"reprise": true, "exemples": [["我一下就认出了他。", "Wǒ yīxià jiù rènchū le tā.", "Je l'ai reconnu tout de suite."]]},
