    "L3-0619": {"glose": "équipement, installations", "acceptions": [["N", "équipement, installations, matériel"]], "exemples": [["这个医院的设备很新。", "Zhège yīyuàn de shèbèi hěn xīn.", "Le matériel de cet hôpital est tout neuf."]]},
