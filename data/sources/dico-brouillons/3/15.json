    "L3-0617": {"glose": "monter, augmenter", "acceptions": [["V", "monter, augmenter, s'élever"]], "exemples": [["今天的气温上升了。", "Jīntiān de qìwēn shàngshēng le.", "Les températures ont grimpé aujourd'hui."]]},
