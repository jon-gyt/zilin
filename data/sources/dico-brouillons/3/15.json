    "L3-0591": {"glose": "yuan, monnaie chinoise", "acceptions": [["N", "yuan, renminbi : monnaie chinoise"]], "exemples": [["这个一共一百块人民币。", "Zhège yīgòng yībǎi kuài rénmínbì.", "Ça fait cent yuans en tout."]]},
    "L3-0592": {"glose": "foule", "acceptions": [["N", "foule, multitude"]], "exemples": [["他很快就在人群中不见了。", "Tā hěn kuài jiù zài rénqún zhōng bùjiàn le.", "Il a vite disparu dans la foule."]]},
