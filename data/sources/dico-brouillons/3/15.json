    "L3-0585": {"glose": "aimer passionnément", "acceptions": [["V", "aimer passionnément, être très attaché à"]], "exemples": [["他热爱自己的工作。", "Tā rè'ài zìjǐ de gōngzuò.", "Il adore son travail."]]},
    "L3-0586": {"glose": "chaleureux, enthousiaste, animé", "acceptions": [["Adj", "chaleureux, enthousiaste, animé"]], "exemples": [["大家热烈欢迎新同学。", "Dàjiā rèliè huānyíng xīn tóngxué.", "Tout le monde a réservé un accueil enthousiaste aux nouveaux élèves."]]},
    "L3-0587": {"glose": "talent, personne compétente", "acceptions": [["N", "talent, personne compétente"]], "exemples": [["公司需要更多的人才。", "Gōngsī xūyào gèng duō de réncái.", "L'entreprise a besoin de plus de gens qualifiés."]]},
    "L3-0588": {"reprise": true, "exemples": [["这是一个人工湖。", "Zhè shì yī ge réngōng hú.", "Ce lac a été creusé par l'homme."]]},
    "L3-0589": {"glose": "humanité, genre humain", "acceptions": [["N", "humanité, genre humain"]], "exemples": [["水对人类很重要。", "Shuǐ duì rénlèi hěn zhòngyào.", "L'eau est essentielle à l'homme."]]},
    "L3-0590": {"glose": "peuple", "acceptions": [["N", "peuple, population"]], "exemples": [["人民的生活越来越好。", "Rénmín de shēnghuó yuèláiyuè hǎo.", "La vie des gens s'améliore sans cesse."]]},
