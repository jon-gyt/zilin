  "entrees": {
    "L3-0579": {"glose": "manquer de", "acceptions": [["V", "manquer de, être à court de"]], "exemples": [["这里缺少老师。", "Zhèli quēshǎo lǎoshī.", "On manque d'enseignants ici."]]},
    "L3-0580": {"glose": "garantir, assurer", "acceptions": [["V", "garantir, assurer, veiller à"]], "exemples": [["我们要确保大家的安全。", "Wǒmen yào quèbǎo dàjiā de ānquán.", "Nous devons veiller à la sécurité de tous."]]},
    "L3-0581": {"glose": "fixer, déterminer ; certain, sûr", "acceptions": [["V", "fixer, déterminer, confirmer"], ["Adj", "certain, sûr, arrêté"]], "exemples": [["时间还没确定。", "Shíjiān hái méi quèdìng.", "L'heure n'est pas encore fixée."], ["你确定吗？", "Nǐ quèdìng ma?", "Tu en es sûr ?"]]},
    "L3-0582": {"glose": "vraiment, en effet ; vrai, sûr", "acceptions": [["Adv", "vraiment, en effet"], ["Adj", "vrai, sûr, fiable"]], "exemples": [["这个菜确实很好吃。", "Zhège cài quèshí hěn hǎochī.", "Ce plat est vraiment bon."]]},
