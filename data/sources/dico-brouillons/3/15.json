    "L3-0583": {"glose": "jupe, robe", "acceptions": [["N", "jupe, robe"]], "exemples": [["她穿了一条红裙子。", "Tā chuān le yī tiáo hóng qúnzi.", "Elle porte une jupe rouge."]]},
