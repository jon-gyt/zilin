    "L3-0605": {"glose": "facile ; enclin à", "acceptions": [["Adj", "facile"], ["Adj", "enclin à, susceptible de"]], "exemples": [["这个问题很容易。", "Zhège wèntí hěn róngyì.", "Cette question est simple."], ["冬天容易感冒。", "Dōngtiān róngyì gǎnmào.", "En hiver, on attrape vite froid."]]},
