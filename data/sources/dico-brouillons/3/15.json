    "品": {"glose": "goûter, apprécier ; article, produit", "acceptions": [["V", "goûter, déguster, apprécier"], ["Suffix", "suffixe d'objet : article, produit (artisanat)"], ["N", "qualité, caractère"]], "exemples": [["这些工艺品很漂亮。", "Zhèxiē gōngyìpǐn hěn piàoliang.", "Ces objets d'artisanat sont très beaux."], ["你品一下这个茶。", "Nǐ pǐn yīxià zhège chá.", "Goûte donc ce thé."]]},
    "L3-0612": {"glose": "marchandise, produit", "acceptions": [["N", "marchandise, produit, article"]], "exemples": [["这家店的商品很便宜。", "Zhè jiā diàn de shāngpǐn hěn piányi.", "Tout est bon marché dans ce magasin."]]},
