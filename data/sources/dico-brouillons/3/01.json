{
  "niveau": "3",
  "lot": "01",
  "entrees": {
    "L3-0001": {"glose": "bonté, amour d'autrui", "acceptions": [["N", "bonté, compassion envers les autres"]], "exemples": [["她是一个很有爱心的人。", "Tā shì yī ge hěn yǒu àixīn de rén.", "Elle est très bonne envers les autres."]]},
    "L3-0002": {"glose": "organiser, prévoir ; programme", "acceptions": [["V", "organiser, arranger, prévoir"], ["N", "organisation, programme prévu"]], "exemples": [["明天的工作我已经安排好了。", "Míngtiān de gōngzuò wǒ yǐjīng ānpái hǎo le.", "J'ai déjà tout prévu pour le travail de demain."], ["你周末有什么安排？", "Nǐ zhōumò yǒu shénme ānpái?", "Qu'est-ce que tu fais ce week-end ?"]]},
    "L3-0003": {"glose": "installer, monter", "acceptions": [["V", "installer, monter (un appareil, un logiciel)"]], "exemples": [["新空调明天来安装。", "Xīn kōngtiáo míngtiān lái ānzhuāng.", "On vient poser le nouveau climatiseur demain."]]},
    "按": {"glose": "appuyer ; selon, d'après", "acceptions": [["V", "appuyer sur, presser"], ["Prep", "selon, d'après, suivant"]], "exemples": [["你按一下这里就开了。", "Nǐ àn yīxià zhèli jiù kāi le.", "Appuie ici et ça s'ouvre."], ["我们按老师说的做。", "Wǒmen àn lǎoshī shuō de zuò.", "On fait comme le professeur a dit."]]},
    "L3-0005": {"glose": "selon, conformément à", "acceptions": [["Prep", "selon, conformément à, d'après"]], "exemples": [["请按照要求写。", "Qǐng ànzhào yāoqiú xiě.", "Écrivez en suivant les consignes, s'il vous plaît."]]},
    "把": {"glose": "introduit l'objet ; classif. à manche", "acceptions": [["Prep", "introduit l'objet placé devant le verbe"], ["M", "classificateur des objets à poignée : chaise, couteau, parapluie"], ["V", "tenir, saisir"]], "exemples": [["请把门关上。", "Qǐng bǎ mén guān shang.", "Ferme la porte, s'il te plaît."], ["我买了一把椅子。", "Wǒ mǎi le yī bǎ yǐzi.", "J'ai acheté une chaise."]]},
    "握": {"glose": "serrer, tenir dans la main", "acceptions": [["V", "serrer, tenir dans la main"]], "exemples": [["他握着我的手。", "Tā wò zhe wǒ de shǒu.", "Il me tenait la main."]]},
    "L3-0008": {"glose": "saisir ; assurance, certitude", "acceptions": [["V", "saisir (une occasion), maîtriser"], ["N", "assurance, certitude de réussir"]], "exemples": [["这次考试我没有把握。", "Zhè cì kǎoshì wǒ méiyou bǎwò.", "Je ne suis pas sûr de réussir cet examen."], ["你要把握这个机会。", "Nǐ yào bǎwò zhège jīhui.", "Il faut que tu saisisses cette chance."]]},
    "L3-0010": {"reprise": true, "exemples": [["冬天的白菜很便宜。", "Dōngtiān de báicài hěn piányi.", "En hiver, le chou chinois ne coûte pas cher."]]},
    "L3-0011": {"glose": "classe (d'élèves)", "acceptions": [["N", "classe, groupe d'élèves"]], "exemples": [["我们班级有三十个学生。", "Wǒmen bānjí yǒu sānshí ge xuésheng.", "Notre classe compte trente élèves."]]},
    "搬": {"glose": "déplacer, transporter ; déménager", "acceptions": [["V", "déplacer, transporter (un objet lourd)"], ["V", "déménager"]], "exemples": [["你能帮我搬一下桌子吗？", "Nǐ néng bāng wǒ bān yīxià zhuōzi ma?", "Tu peux m'aider à déplacer la table ?"]]},
    "L3-0013": {"glose": "déménager", "acceptions": [["V", "déménager, changer de logement"]], "exemples": [["我们下个月搬家。", "Wǒmen xià ge yuè bānjiā.", "Nous déménageons le mois prochain."]]},
    "L3-0015": {"glose": "s'occuper de, faire (une démarche)", "acceptions": [["V", "s'occuper de, traiter, effectuer (une démarche)"]], "exemples": [["我明天去办理手续。", "Wǒ míngtiān qù bànlǐ shǒuxù.", "Demain, je vais faire les formalités."]]},
    "保": {"glose": "protéger, garder ; garantir", "acceptions": [["V", "protéger, préserver ; garantir"]], "exemples": [["我保你喜欢。", "Wǒ bǎo nǐ xǐhuan.", "Je te promets que ça va te plaire."]]},
    "L3-0017": {"glose": "agent de sécurité, gardien", "acceptions": [["N", "agent de sécurité, vigile, gardien"]], "exemples": [["门口有两个保安。", "Ménkǒu yǒu liǎng ge bǎo'ān.", "Il y a deux vigiles à l'entrée."]]},
    "持": {"glose": "tenir ; maintenir, soutenir", "acceptions": [["V", "tenir en main ; maintenir, soutenir"]], "exemples": [["他每天坚持跑步。", "Tā měitiān jiānchí pǎobù.", "Il court tous les jours, sans faute."]]},
    "L3-0018": {"glose": "maintenir, garder", "acceptions": [["V", "maintenir, garder (un état)"]], "exemples": [["请保持安静。", "Qǐng bǎochí ānjìng.", "Silence, s'il vous plaît."]]},
    "存": {"glose": "déposer, mettre de côté ; exister", "acceptions": [["V", "déposer, mettre de côté (argent, bagages)"], ["V", "exister, subsister"]], "exemples": [["我把钱存在银行里。", "Wǒ bǎ qián cún zài yínháng li.", "J'ai mis mon argent à la banque."]]},
    "L3-0019": {"glose": "conserver, sauvegarder", "acceptions": [["V", "conserver, garder ; enregistrer (un fichier)"]], "exemples": [["别忘了保存文件。", "Bié wàng le bǎocún wénjiàn.", "N'oublie pas d'enregistrer le fichier."]]},
    "L3-0020": {"glose": "protéger", "acceptions": [["V", "protéger, préserver"]], "exemples": [["我们要保护环境。", "Wǒmen yào bǎohù huánjìng.", "Nous devons respecter l'environnement."]]},
    "L3-0021": {"glose": "garder, conserver ; réserver", "acceptions": [["V", "garder, conserver ; réserver (un avis)"]], "exemples": [["这里还保留着很多老房子。", "Zhèli hái bǎoliú zhe hěn duō lǎo fángzi.", "Beaucoup de vieilles maisons sont encore debout ici."]]},
    "险": {"glose": "dangereux, périlleux ; danger", "acceptions": [["Adj", "dangereux, périlleux"], ["N", "danger, risque"]], "exemples": [["这条路很险。", "Zhè tiáo lù hěn xiǎn.", "Cette route n'est pas sûre."]]},
    "L3-0022": {"glose": "assurance ; sûr, sans risque", "acceptions": [["N", "assurance"], ["Adj", "sûr, sans risque, prudent"]], "exemples": [["你买保险了吗？", "Nǐ mǎi bǎoxiǎn le ma?", "Tu as pris une assurance ?"], ["这样做比较保险。", "Zhèyàng zuò bǐjiào bǎoxiǎn.", "C'est plus prudent de faire comme ça."]]},
    "证": {"glose": "certificat, carte ; preuve", "acceptions": [["N", "certificat, carte, pièce justificative"], ["V", "prouver, attester"]], "exemples": [["这个证你要带好。", "Zhège zhèng nǐ yào dài hǎo.", "Garde bien ce papier sur toi."]]},
    "L3-0023": {"glose": "garantir, promettre ; garantie", "acceptions": [["V", "garantir, promettre"], ["N", "garantie"]], "exemples": [["我保证下次不这样了。", "Wǒ bǎozhèng xià cì bù zhèyàng le.", "Je te jure que ça ne se reproduira pas."]]},
    "L3-0025": {"glose": "se présenter à son arrivée", "acceptions": [["V", "se présenter, signaler son arrivée, s'enregistrer"]], "exemples": [["新同学明天去学校报到。", "Xīn tóngxué míngtiān qù xuéxiào bàodào.", "Les nouveaux élèves se présentent à l'école demain."]]},
    "L3-0026": {"glose": "relater (presse) ; reportage", "acceptions": [["V", "rendre compte, relater (presse, télévision)"], ["N", "reportage, article"]], "exemples": [["报纸上有一篇关于他的报道。", "Bàozhǐ shang yǒu yī piān guānyú tā de bàodào.", "Le journal a publié un article sur lui."]]},
    "L3-0027": {"glose": "rapport, exposé ; signaler", "acceptions": [["N", "rapport, exposé"], ["V", "rendre compte, signaler"]], "exemples": [["我今天要写一个报告。", "Wǒ jīntiān yào xiě yī ge bàogào.", "Je dois rédiger un rapport aujourd'hui."]]},
    "L3-0029": {"glose": "le nord (d'un pays, d'une région)", "acceptions": [["N", "la partie nord, le nord (d'un pays, d'une région)"]], "exemples": [["他住在中国北部。", "Tā zhù zài Zhōngguó běibù.", "Il habite dans le nord de la Chine."]]},
    "L3-0031": {"glose": "derrière ; dans le dos", "acceptions": [["N", "derrière, à l'arrière ; en cachette, dans le dos"]], "exemples": [["别在背后说别人。", "Bié zài bèihòu shuō biéren.", "Ne dis pas de mal des gens en leur absence."]]},
    "被": {"glose": "par (passif) ; couverture", "acceptions": [["Prep", "par : marque le passif"], ["N", "couverture, couette"]], "exemples": [["我的钱包被人拿走了。", "Wǒ de qiánbāo bèi rén ná zǒu le.", "Quelqu'un a pris mon portefeuille."]]},
    "L3-0033": {"glose": "couette, couverture", "acceptions": [["N", "couette, couverture de lit"]], "exemples": [["这条被子很暖和。", "Zhè tiáo bèizi hěn nuǎnhuo.", "Cette couette tient bien chaud."]]},
    "L3-0034": {"reprise": true, "exemples": [["我本来想去，后来没时间了。", "Wǒ běnlái xiǎng qù, hòulái méi shíjiān le.", "Je voulais y aller, mais finalement je n'ai pas eu le temps."]]},
    "领": {"glose": "conduire, mener ; recevoir ; col", "acceptions": [["V", "conduire, guider, mener"], ["V", "recevoir, aller chercher (ce qui est dû)"], ["N", "col (d'un vêtement)"]], "exemples": [["他领我们去看房间。", "Tā lǐng wǒmen qù kàn fángjiān.", "Il nous a emmenés voir la chambre."], ["下午去领书。", "Xiàwǔ qù lǐng shū.", "Cet après-midi, on va chercher les livres."]]},
    "L3-0035": {"glose": "savoir-faire, compétence", "acceptions": [["N", "savoir-faire, compétence, talent"]], "exemples": [["他的本领很大。", "Tā de běnlǐng hěn dà.", "Il sait faire beaucoup de choses."]]},
    "L3-0036": {"glose": "capacité, talent", "acceptions": [["N", "capacité, talent, habileté"]], "exemples": [["有本事你自己做。", "Yǒu běnshi nǐ zìjǐ zuò.", "Si tu en es capable, fais-le toi-même."]]},
    "较": {"glose": "relativement, plutôt ; comparer", "acceptions": [["Adv", "relativement, plutôt"], ["V", "comparer : langue écrite"]], "exemples": [["这里的东西较贵。", "Zhèli de dōngxi jiào guì.", "Ici, les choses sont plutôt chères."]]},
    "L3-0037": {"glose": "assez, plutôt ; comparer", "acceptions": [["Adv", "assez, relativement"], ["V", "comparer"]], "exemples": [["今天比较热。", "Jīntiān bǐjiào rè.", "Il fait assez chaud aujourd'hui."], ["你比较一下这两个。", "Nǐ bǐjiào yīxià zhè liǎng ge.", "Compare un peu ces deux-là."]]},
    "L3-0038": {"glose": "proportion, part", "acceptions": [["N", "proportion, part, ratio"]], "exemples": [["我们班男生的比例很高。", "Wǒmen bān nánshēng de bǐlì hěn gāo.", "Il y a beaucoup de garçons dans notre classe."]]},
    "赛": {"glose": "rivaliser ; compétition", "acceptions": [["V", "rivaliser, faire la course"], ["N", "match, compétition"]], "exemples": [["我们赛一下，看谁跑得快。", "Wǒmen sài yīxià, kàn shéi pǎo de kuài.", "Faisons la course, pour voir qui court le plus vite."]]},
    "L3-0039": {"glose": "match, compétition ; concourir", "acceptions": [["N", "match, compétition"], ["V", "concourir, disputer un match"]], "exemples": [["今天晚上有足球比赛。", "Jīntiān wǎnshang yǒu zúqiú bǐsài.", "Il y a un match de foot ce soir."]]},
    "L3-0040": {"glose": "inévitable, nécessaire", "acceptions": [["Adj", "inévitable, nécessaire, logique"]], "exemples": [["这是必然的结果。", "Zhè shì bìrán de jiéguǒ.", "C'était un résultat inévitable."]]},
    "L3-0041": {"glose": "nécessaire ; nécessité", "acceptions": [["Adj", "nécessaire, indispensable"], ["N", "nécessité, utilité"]], "exemples": [["没有必要再说了。", "Méiyou bìyào zài shuō le.", "Inutile d'en dire plus."]]},
    "化": {"glose": "transformer, fondre ; -iser", "acceptions": [["Suffix", "suffixe : -iser, -isation (moderniser)"], ["V", "fondre ; se transformer"]], "exemples": [["中国的现代化很快。", "Zhōngguó de xiàndàihuà hěn kuài.", "La Chine se modernise vite."], ["雪化了。", "Xuě huà le.", "La neige a fondu."]]},
    "L3-0042": {"glose": "changement ; changer, évoluer", "acceptions": [["N", "changement, évolution"], ["V", "changer, évoluer"]], "exemples": [["这几年北京变化很大。", "Zhè jǐ nián Běijīng biànhuà hěn dà.", "Pékin a beaucoup changé ces dernières années."]]},
    "L3-0043": {"glose": "devenir, se changer en", "acceptions": [["V", "devenir, se transformer en"]], "exemples": [["雨变为雪了。", "Yǔ biànwéi xuě le.", "La pluie s'est changée en neige."]]},
    "标": {"glose": "marquer, indiquer ; marque, signe", "acceptions": [["V", "marquer, indiquer"], ["N", "marque, signe"]], "exemples": [["请把重要的地方标出来。", "Qǐng bǎ zhòngyào de dìfang biāo chulai.", "Marque les passages importants, s'il te plaît."]]},
    "L3-0044": {"glose": "titre (d'un article, d'un texte)", "acceptions": [["N", "titre (d'un article, d'un texte)"]], "exemples": [["这篇文章的标题很好。", "Zhè piān wénzhāng de biāotí hěn hǎo.", "Cet article a un bon titre."]]},
    "L3-0045": {"glose": "norme, critère ; correct, standard", "acceptions": [["N", "norme, critère"], ["Adj", "correct, conforme, standard"]], "exemples": [["他的普通话很标准。", "Tā de pǔtōnghuà hěn biāozhǔn.", "Il parle un mandarin impeccable."]]},
    "达": {"glose": "atteindre, parvenir à", "acceptions": [["V", "atteindre, arriver à ; exprimer"]], "exemples": []}
  }
}
