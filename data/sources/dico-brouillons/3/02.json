{
  "niveau": "3",
  "lot": "02",
  "entrees": {
    "L3-0046": {"glose": "exprimer", "acceptions": [["V", "exprimer (une idée, un sentiment)"]], "exemples": [["我不知道怎么表达我的想法。", "Wǒ bù zhīdao zěnme biǎodá wǒ de xiǎngfa.", "Je ne sais pas comment dire ce que je pense."]]},
