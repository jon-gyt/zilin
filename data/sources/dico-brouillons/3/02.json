    "L3-0047": {"glose": "formulaire, tableau", "acceptions": [["N", "formulaire, tableau, grille"]], "exemples": [["请写一下这个表格。", "Qǐng xiě yīxià zhège biǎogé.", "Remplis ce formulaire, s'il te plaît."]]},
    "L3-0048": {"glose": "surface ; apparence", "acceptions": [["N", "surface, face extérieure"], ["N", "apparence, dehors"]], "exemples": [["他表面上很高兴。", "Tā biǎomiàn shang hěn gāoxìng.", "En apparence, il a l'air content."]]},
    "L3-0049": {"glose": "montrer, indiquer clairement", "acceptions": [["V", "montrer, indiquer clairement, prouver"]], "exemples": [["这表明他是对的。", "Zhè biǎomíng tā shì duì de.", "Cela prouve qu'il avait raison."]]},
    "L3-0050": {"glose": "se montrer, se comporter ; conduite", "acceptions": [["V", "montrer, manifester ; se comporter"], ["N", "comportement, conduite, performance"]], "exemples": [["他在比赛中表现很好。", "Tā zài bǐsài zhōng biǎoxiàn hěn hǎo.", "Il a très bien joué pendant le match."]]},
    "演": {"glose": "jouer (un rôle), représenter", "acceptions": [["V", "jouer, interpréter (un rôle) ; représenter"]], "exemples": [["他在电影里演一个老师。", "Tā zài diànyǐng li yǎn yī ge lǎoshī.", "Dans le film, il joue un professeur."]]},
    "L3-0051": {"glose": "jouer, se produire ; spectacle", "acceptions": [["V", "se produire, jouer, présenter (un numéro)"], ["N", "spectacle, représentation"]], "exemples": [["晚上我们去看表演。", "Wǎnshang wǒmen qù kàn biǎoyǎn.", "Ce soir, nous allons voir un spectacle."]]},
    "并": {"glose": "pas du tout ; et, de plus ; réunir", "acceptions": [["Adv", "absolument (pas) : renforce une négation"], ["Conj", "et, et de plus"], ["V", "réunir, mettre ensemble"]], "exemples": [["这个问题并不难。", "Zhège wèntí bìng bù nán.", "Cette question n'est pas du tout difficile."], ["他同意了，并马上去做了。", "Tā tóngyì le, bìng mǎshàng qù zuò le.", "Il a accepté et s'y est mis tout de suite."]]},
    "L3-0053": {"glose": "et, de plus, en outre", "acceptions": [["Conj", "et, de plus, en outre"]], "exemples": [["这个菜好吃，并且不贵。", "Zhège cài hǎochī, bìngqiě bù guì.", "Ce plat est bon, et en plus il n'est pas cher."]]},
