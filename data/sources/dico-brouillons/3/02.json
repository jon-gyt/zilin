    "L3-0056": {"glose": "inutile de, pas besoin de", "acceptions": [["Adv", "inutile de, pas besoin de"]], "exemples": [["你不必来接我。", "Nǐ bùbì lái jiē wǒ.", "Ce n'est pas la peine de venir me chercher."]]},
    "断": {"glose": "casser, rompre ; couper", "acceptions": [["V", "se casser, se rompre"], ["V", "couper, interrompre"]], "exemples": [["他的腿断了。", "Tā de tuǐ duàn le.", "Il s'est cassé la jambe."], ["电话断了。", "Diànhuà duàn le.", "La communication a été coupée."]]},
    "L3-0057": {"glose": "sans cesse, continuellement", "acceptions": [["Adv", "sans cesse, continuellement"], ["V", "ne pas cesser, se poursuivre"]], "exemples": [["他的汉语不断进步。", "Tā de Hànyǔ bùduàn jìnbù.", "Son chinois progresse de jour en jour."]]},
