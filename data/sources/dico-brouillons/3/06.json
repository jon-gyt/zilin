    "L3-0209": {"glose": "photocopier", "acceptions": [["V", "photocopier"]], "exemples": [["请帮我复印两张。", "Qǐng bāng wǒ fùyìn liǎng zhāng.", "Fais-moi deux copies, s'il te plaît."]]},
