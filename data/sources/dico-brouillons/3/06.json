    "L3-0217": {"glose": "vite, sans tarder", "acceptions": [["Adv", "vite, sans tarder, en hâte"]], "exemples": [["下雨了，赶紧回家吧。", "Xià yǔ le, gǎnjǐn huí jiā ba.", "Il pleut, rentrons vite."]]},
