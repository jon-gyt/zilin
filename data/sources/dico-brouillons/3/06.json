    "L3-0206": {"glose": "père", "acceptions": [["N", "père"]], "exemples": [["我父亲今年六十岁。", "Wǒ fùqin jīnnián liùshí suì.", "Mon père a soixante ans cette année."]]},
    "付": {"glose": "payer, régler", "acceptions": [["V", "payer, régler ; remettre"]], "exemples": [["我来付钱。", "Wǒ lái fù qián.", "C'est moi qui paie."]]},
    "负": {"glose": "porter, assumer ; perdre ; négatif", "acceptions": [["V", "porter, assumer (une charge)"], ["V", "perdre (un match)"], ["Adj", "négatif, moins"]], "exemples": [["我们队一胜一负。", "Wǒmen duì yī shèng yī fù.", "Notre équipe a une victoire et une défaite."]]},
