    "迷": {"glose": "se passionner ; s'égarer ; fan", "acceptions": [["V", "se passionner pour, être fou de"], ["V", "se perdre, s'égarer"], ["N", "fan, passionné"]], "exemples": [["他迷上了电脑游戏。", "Tā mí shang le diànnǎo yóuxì.", "Il est devenu accro aux jeux vidéo."], ["我迷路了。", "Wǒ mílù le.", "Je me suis perdu."]]},
