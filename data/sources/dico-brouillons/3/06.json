    "L3-0202": {"glose": "nier, démentir", "acceptions": [["V", "nier, démentir"]], "exemples": [["他否认自己说过这句话。", "Tā fǒurèn zìjǐ shuō guo zhè jù huà.", "Il affirme ne jamais avoir dit cela."]]},
