  "entrees": {
    "L3-0165": {"glose": "membre d'une équipe, joueur", "acceptions": [["N", "membre d'une équipe, joueur, équipier"]], "exemples": [["我们队有十个队员。", "Wǒmen duì yǒu shí ge duìyuán.", "Notre équipe compte dix joueurs."]]},
    "L3-0166": {"glose": "traiter, se comporter envers", "acceptions": [["V", "traiter, se comporter envers, aborder"]], "exemples": [["他对待工作很认真。", "Tā duìdài gōngzuò hěn rènzhēn.", "Il prend son travail très au sérieux."]]},
    "L3-0167": {"glose": "l'autre partie, l'autre", "acceptions": [["N", "l'autre partie, l'autre, l'interlocuteur"]], "exemples": [["他们都很了解对方。", "Tāmen dōu hěn liǎojiě duìfāng.", "Ils se connaissent très bien l'un l'autre."]]},
    "L3-0168": {"glose": "adversaire, rival", "acceptions": [["N", "adversaire, rival, concurrent"]], "exemples": [["这次比赛的对手很强。", "Zhè cì bǐsài de duìshǒu hěn qiáng.", "L'équipe d'en face est très forte cette fois."]]},
