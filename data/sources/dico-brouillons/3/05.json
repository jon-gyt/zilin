    "L3-0171": {"glose": "publier ; exprimer publiquement", "acceptions": [["V", "publier (un article)"], ["V", "exprimer, formuler (publiquement)"]], "exemples": [["他在报纸上发表了一篇文章。", "Tā zài bàozhǐ shang fābiǎo le yī piān wénzhāng.", "Il a fait paraître un article dans le journal."]]},
    "L3-0172": {"glose": "émettre, envoyer", "acceptions": [["V", "émettre (un son, une lumière) ; envoyer"]], "exemples": [["手机发出了声音。", "Shǒujī fāchū le shēngyīn.", "Le téléphone a sonné."]]},
