    "L3-0318": {"glose": "extrêmement, on ne peut plus", "acceptions": [["Adv", "extrêmement, au plus haut point : après un adjectif"]], "exemples": [["今天热极了。", "Jīntiān rè jí le.", "Il fait une chaleur terrible aujourd'hui."]]},
