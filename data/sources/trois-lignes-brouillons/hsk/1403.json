 "lignes": [
  {
   "zh": "下班的时候，很多人涌进了地铁站。",
   "pinyin": "xià bān de shí hou hěn duō rén yǒng jìn le dì tiě zhàn",
   "fr": "À la sortie du travail, la foule s'engouffre dans le métro.",
   "en": "After work, crowds pour into the subway station."
  },
  {
   "zh": "这首诗歌咏了家乡的美景。",
   "pinyin": "zhè shǒu shī gē yǒng le jiā xiāng de měi jǐng",
   "fr": "Ce poème chante les beaux paysages du pays natal.",
   "en": "This poem celebrates the beauty of the hometown."
  },
  {
   "zh": "海上波涛汹涌。",
   "pinyin": "hǎi shàng bō tāo xiōng yǒng",
   "fr": "La mer est déchaînée.",
   "en": "The sea is surging."
  }
