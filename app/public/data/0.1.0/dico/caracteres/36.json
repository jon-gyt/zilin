":["qún"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["尹","口","羊"],"sources":["cjk-decomp"]},"mots":["L3-0584","L3-0592","L5-0613","L5-0614","L7-0451","L7-1641"],"chemin":{},"sens":{"statut":"relu","glose":"groupe, troupeau ; foule","acceptions":[{"categorie":"M","fr":"classificateur des groupes : troupeau, bande"},{"categorie":"N","fr":"groupe, foule"}]},"exemples":[{"zh":"山上有一群羊。","pinyin":"Shān shang yǒu yī qún yáng.","fr":"Il y a un troupeau de moutons sur la montagne.","statut":"relu"}],"origine":null},"裙":{"c":"裙","pinyin":"qún","lectures":["qún"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["衤","尹","口"],"sources":["cjk-decomp"]},"mots":["L3-0583"],"chemin":{},"sens":{"statut":"relu","glose":"jupe, robe","acceptions":[{"categorie":"N","fr":"jupe, robe"}]},"exemples":[],"origine":null},"然":{"c":"然","pinyin":"rán","lectures":["rán"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["月","犬","灬"],"sources":["cjk-decomp"]},"mots":["L2-0100","L2-0229","L2-0459","L2-0510","L3-0040","L3-0139","L3-0276","L3-0603","L3-0727","L3-0778","L3-0961","L4-0055","L4-0369","L4-0415","L4-0597","L4-0866","L5-0416","L5-0536","L5-0761","L6-0798","L6-0940","L7-0297","L7-1357","L7-1422","L7-1640","L7-1720","L7-1780","L7-2118","L7-2574","L7-2797","L7-2842","L7-2922","L7-3879","L7-4008","L7-4888","L7-4895","L7-4977","L7-5443","L7-5560","L7-5561","L7-5589"],"chemin":{},"sens":{"statut":"relu","glose":"ainsi ; suffixe d'adverbe","acceptions":[{"categorie":"Adv","fr":"ainsi, de cette manière"},{"categorie":"Suffix","fr":"suffixe d'adjectif ou d'adverbe"}]},"exemples":[],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi glose 然 par « brûler » : le feu, 灬, et 肰, la viande de chien, pour le son. On lit 月, la viande, et 犬, le chien, au-dessus du feu. Emprunté pour dire « ainsi », il a laissé « brûler » à 燃, qui ajoute un 火.","en":"The Shuowen jiezi glosses 然 as “to burn”: fire, 灬, and 肰, dog meat, for the sound. You read 月, meat, and 犬, dog, above the fire. Borrowed to mean “so, thus”, it left “to burn” to 燃, which adds a 火.","roles":{"月":"forme","犬":"forme","灬":"sens"}}},"燃":{"c":"燃","pinyin":"rán","lectures":["rán"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["火","月","犬","灬"],"sources":["cjk-decomp"]},"mots":["L4-0598","L4-0599","L5-0201","L7-3414","L7-3415","L7-3416"],"chemin":{},"sens":{"statut":"relu","glose":"brûler, allumer","acceptions":[{"categorie":"V","fr":"brûler, allumer"}]},"exemples":[],"origine":null},"染":{"c":"染","pinyin":"rǎn","lectures":["rǎn"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["氵","九","木"],"sources":["cjk-decomp"]},"mots":["L5-0615","L5-0798","L7-0587","L7-0588","L7-1262","L7-1263"],"chemin":{},"sens":{"statut":"relu","glose":"teindre ; contaminer","acceptions":[{"categorie":"V","fr":"teindre"},{"categorie":"V","fr":"contaminer ; attraper (une maladie, un défaut)"}]},"exemples":[{"zh":"她把头发染成了红色。","pinyin":"Tā bǎ tóufa rǎn chéng le hóngsè.","fr":"Elle s'est teint les cheveux en roux.","statut":"relu"}],"origine":null},"嚷":{"c":"嚷","pinyin":"rǎng","lectures":["rǎng","rāng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["口","衣","口","口","𠀎"],"sources":["cjk-decomp"]},"mots":["L7-3417"],"chemin":{},"sens":{"statut":"relu","glose":"crier, brailler","acceptions":[{"categorie":"V","fr":"crier, brailler"},{"categorie":"V","fr":"faire du tapage, se plaindre bruyamment","pinyin":"rāng"}]},"exemples":[{"zh":"别在这里大声嚷！","pinyin":"Bié zài zhèli dàshēng rǎng!","fr":"Ne hurle pas comme ça ici !","statut":"relu"}],"origine":null},"壤":{"c":"壤","pinyin":"rǎng","lectures":["rǎng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["土","衣","口","口","𠀎"],"sources":["cjk-decomp"]},"mots":["L7-4182"],"chemin":{},"sens":{"statut":"relu","glose":"terre, sol","acceptions":[{"categorie":"N","fr":"terre, sol ; territoire"}]},"exemples":[],"origine":null},"攘":{"c":"攘","pinyin":"rǎng","lectures":["rǎng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["扌","衣","口","口","𠀎"],"sources":["cjk-decomp"]},"mots":["L7-4421"],"chemin":{},"sens":{"statut":"relu","glose":"repousser ; agité, en désordre","acceptions":[{"categorie":"V","fr":"repousser, chasser"},{"categorie":"Adj","fr":"agité, en désordre"}]},"exemples":[],"origine":null},"让":{"c":"让","pinyin":"ràng","lectures":["ràng"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["讠","上"],"sources":["cjk-decomp"]},"mots":["L2-0460","L5-1049","L6-0684","L7-3418","L7-4202"],"chemin":{"lire":88},"sens":{"statut":"relu","glose":"laisser, céder, faire faire","acceptions":[]},"exemples":[{"zh":"让我看看。","pinyin":"Ràng wǒ kànkan.","fr":"Montre-moi.","statut":"relu"},{"zh":"妈妈不让我出去。","pinyin":"Māma bù ràng wǒ chūqu.","fr":"Maman ne me permet pas de sortir.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"La forme traditionnelle 讓 est un composé idéo-phonétique : 言, la parole, donne le sens, et 襄 donne le son. Le Shuowen jiezi le glose par « se faire des reproches » ; les sens de « céder », puis de « laisser, faire faire », se sont imposés ensuite. La forme simplifiée 让 remplace 襄 par 上, bien plus simple, qui rime avec ràng.","en":"The traditional form 讓 is a phono-semantic compound: 言, speech, gives the meaning, and 襄 gives the sound. The Shuowen jiezi glosses it as “to reproach one another”; the senses of “to yield”, and later “to let, to make someone do”, took over afterwards. The simplified 让 swaps 襄 for the far simpler 上, which rhymes with ràng.","roles":{"讠":"sens","上":"forme"}}},"饶":{"c":"饶","pinyin":"ráo","lectures":["ráo"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["饣","𭠍","兀"],"sources":["cjk-decomp","surcharge"]},"mots":["L7-3419","L7-3420"],"chemin":{},"sens":{"statut":"relu","glose":"pardonner, épargner ; abondant","acceptions":[{"categorie":"V","fr":"pardonner, épargner, faire grâce"},{"categorie":"Adj","fr":"abondant, riche"}]},"exemples":[{"zh":"这次就饶了你吧。","pinyin":"Zhè cì jiù ráo le nǐ ba.","fr":"Pour cette fois, je passe l'éponge.","statut":"relu"}],"origine":null},"扰":{"c":"扰","pinyin":"rǎo","lectures":["rǎo"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["扌","尤"],"sources":["cjk-decomp"]},"mots":["L5-0158","L5-0259","L5-0455","L7-3421","L7-3520"],"chemin":{},"sens":{"statut":"relu","glose":"déranger, troubler","acceptions":[{"categorie":"V","fr":"déranger, troubler, perturber"}]},"exemples":[{"zh":"外面的声音干扰了我的工作。","pinyin":"Wàimian de shēngyīn gānrǎo le wǒ de gōngzuò.","fr":"Le bruit du dehors m'a gêné dans mon travail.","statut":"relu"}],"origine":null},"绕":{"c":"绕","pinyin":"rào","lectures":["rào","rǎo"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["纟","𭠍","兀"],"sources":["cjk-decomp","surcharge"]},"mots":["L5-0616","L5-0788","L7-1753","L7-3422"],"chemin":{},"sens":{"statut":"relu","glose":"contourner ; enrouler","acceptions":[{"categorie":"V","fr":"contourner, faire un détour"},{"categorie":"V","fr":"enrouler, tourner autour de"}]},"exemples":[{"zh":"前面修路，我们绕过去吧。","pinyin":"Qiánmian xiū lù, wǒmen rào guòqu ba.","fr":"Il y a des travaux devant, faisons un détour.","statut":"relu"}],"origine":null},"惹":{"c":"惹","pinyin":"rě","lectures":["rě"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["卄","𠂇","口","心"],"sources":["cjk-decomp"]},"mots":["L7-3423"],"chemin":{},"sens":{"statut":"relu","glose":"provoquer, s'attirer ; agacer","acceptions":[{"categorie":"V","fr":"provoquer, s'attirer (des ennuis)"},{"categorie":"V","fr":"agacer, taquiner, offenser"}]},"exemples":[{"zh":"你别惹他生气。","pinyin":"Nǐ bié rě tā shēngqì.","fr":"Ne le mets pas en colère.","statut":"relu"}],"origine":null},"热":{"c":"热","pinyin":"rè","lectures":["rè"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["扌","丸","灬"],"sources":["cjk-decomp"]},"mots":["L1-0304","L2-0461","L3-0585","L3-0586","L4-0600","L4-0601","L5-0365","L5-0617","L5-0618","L6-0685","L6-0686","L6-0687","L6-0688","L7-1026","L7-1832","L7-2358","L7-2475","L7-3316","L7-3424","L7-3425","L7-3426","L7-3427","L7-3428","L7-3429","L7-4777","L7-5529"],"chemin":{"hsk":186},"sens":{"statut":"relu","glose":"chaud ; réchauffer","acceptions":[{"categorie":"Adj","fr":"chaud"},{"categorie":"V","fr":"chauffer, réchauffer"}]},"exemples":[{"zh":"水很热，别喝。","pinyin":"Shuǐ hěn rè, bié hē.","fr":"L'eau est brûlante, ne la bois pas.","statut":"relu"},{"zh":"这个菜热一下再吃。","pinyin":"Zhège cài rè yīxià zài chī.","fr":"Réchauffe ce plat avant de le manger.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi écrit 熱 et le glose « chaud » : le feu, 火, et 埶 pour le son. Le feu est aujourd'hui les quatre points du bas, 灬. Simplifié, 埶 devient 执, écrit 扌 et 丸, qui ne donne plus le son de rè.","en":"The Shuowen jiezi writes 熱 and glosses it as “warm”: fire, 火, and 埶 for the sound. The fire is now the four dots at the bottom, 灬. Simplified, 埶 becomes 执, written 扌 and 丸, which no longer gives the sound of rè.","roles":{"扌":"forme","丸":"forme","灬":"sens"}}},"人":{"c":"人","pinyin":"rén","lectures":["rén"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0027","L1-0029","L1-0123","L1-0171","L1-0208","L1-0264","L1-0280","L1-0305","L2-0003","L2-0096","L2-0218","L2-0238","L2-0325","L2-0462","L2-0463","L2-0464","L2-0471","L2-0624","L2-0685","L2-0745","L3-0159","L3-0230","L3-0300","L3-0563","L3-0587","L3-0588","L3-0589","L3-0590","L3-0591","L3-0592","L3-0593","L3-0594","L3-0680","L4-0087","L4-0179","L4-0252","L4-0524","L4-0590","L4-0602","L4-0639","L5-0024","L5-0255","L5-0354","L5-0425","L5-0501","L5-0619","L5-0620","L5-0621","L5-0622","L5-0723","L6-0082","L6-0247","L6-0254","L6-0292","L6-0302","L6-0462","L6-0570","L6-0689","L6-0904","L6-0963","L6-0989","L6-1094","L7-0292","L7-0394","L7-0463","L7-0515","L7-0543","L7-0589","L7-0600","L7-0726","L7-0727","L7-0731","L7-0758","L7-0904","L7-1025","L7-1413","L7-1558","L7-1596","L7-1682","L7-1691","L7-2089","L7-2284","L7-2440","L7-2536","L7-2642","L7-2702","L7-2722","L7-2826","L7-2941","L7-2957","L7-2961","L7-2990","L7-3119","L7-3175","L7-3260","L7-3353","L7-3430","L7-3431","L7-3432","L7-3433","L7-3434","L7-3435","L7-3436","L7-3437","L7-3438","L7-3439","L7-3440","L7-3441","L7-3442","L7-3443","L7-3444","L7-3445","L7-3446","L7-3447","L7-3448","L7-3449","L7-3459","L7-3526","L7-3624","L7-3673","L7-3790","L7-3969","L7-3981","L7-4040","L7-4135","L7-4239","L7-4291","L7-4310","L7-4333","L7-4474","L7-4569","L7-4925","L7-4978","L7-4988","L7-4989","L7-5043","L7-5068","L7-5090","L7-5337","L7-5427","L7-5455","L7-5483"],"chemin":{"hsk":1,"lire":1},"sens":{"statut":"relu","glose":"personne, homme","acceptions":[]},"exemples":[{"zh":"这里有很多人。","pinyin":"Zhèli yǒu hěn duō rén.","fr":"Il y a beaucoup de monde ici.","statut":"relu"},{"zh":"他是中国人。","pinyin":"Tā shì Zhōngguórén.","fr":"Il est chinois.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 人 dessine un homme debout vu de profil, le buste un peu penché, les bras tombant vers l'avant. Le Shuowen jiezi y lit la forme des bras et des jambes. Au fil des écritures, la silhouette s'est réduite à deux traits obliques qui s'appuient l'un sur l'autre.","en":"On oracle bones, 人 draws a standing man seen in profile, body slightly bent, arms hanging forward. The Shuowen jiezi reads it as the shape of arms and legs. Over the centuries the figure was pared down to two slanting strokes leaning on each other.","roles":{}}},"仁":{"c":"仁","pinyin":"rén","lectures":["rén"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["亻","二"],"sources":["cjk-decomp"]},"mots":["L7-2005","L7-3450"],"chemin":{},"sens":{"statut":"relu","glose":"bonté, humanité ; amande","acceptions":[{"categorie":"N","fr":"bonté, humanité, bienveillance"},{"categorie":"N","fr":"amande, noyau (de fruit)"}]},"exemples":[{"zh":"他对别人很仁慈。","pinyin":"Tā duì biérén hěn réncí.","fr":"Il est très bon envers les autres.","statut":"relu"}],"origine":null},"忍":{"c":"忍","pinyin":"rěn","lectures":["rěn"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["刃","心"],"sources":["cjk-decomp"]},"mots":["L5-0623","L5-0624","L5-0625","L7-0337","L7-3451","L7-3452","L7-3453","L7-3476"],"chemin":{},"sens":{"statut":"relu","glose":"supporter, endurer ; se retenir","acceptions":[{"categorie":"V","fr":"supporter, endurer"},{"categorie":"V","fr":"se retenir, se contenir"}]},"exemples":[{"zh":"我忍了很久，最后还是说了。","pinyin":"Wǒ rěn le hěn jiǔ, zuìhòu háishi shuō le.","fr":"Je me suis retenu longtemps, mais j'ai fini par le dire.","statut":"relu"}],"origine":null},"任":{"c":"任","pinyin":"rèn","lectures":["rèn","rén"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["亻","壬"],"sources":["cjk-decomp"]},"mots":["L3-0598","L3-0599","L3-0600","L3-0601","L3-0802","L3-0879","L3-0938","L4-0159","L7-0544","L7-1984","L7-2257","L7-2600","L7-3135","L7-3257","L7-3457","L7-3458","L7-3459","L7-3460","L7-3461","L7-3571","L7-3669","L7-4496","L7-5432"],"chemin":{},"sens":{"statut":"relu","glose":"nommer, occuper ; quel que soit","acceptions":[{"categorie":"V","fr":"nommer, occuper (une fonction) ; laisser libre"},{"categorie":"Conj","fr":"quel que soit, peu importe"},{"categorie":"N","fr":"Ren : nom de famille","pinyin":"rén"}]},"exemples":[{"zh":"他任校长三年了。","pinyin":"Tā rèn xiàozhǎng sān nián le.","fr":"Il est directeur depuis trois ans.","statut":"relu"},{"zh":"任你怎么说，他都不听。","pinyin":"Rèn nǐ zěnme shuō, tā dōu bù tīng.","fr":"Quoi que tu dises, il n'écoute pas.","statut":"relu"}],"origine":null},"认":{"c":"认","pinyin":"rèn","lectures":["rèn"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["讠","人"],"sources":["cjk-decomp"]},"mots":["L1-0306","L1-0307","L2-0465","L3-0202","L3-0595","L3-0596","L3-0597","L4-0091","L4-0596","L5-0282","L5-0626","L5-0627","L6-0690","L7-0196","L7-3454","L7-3455","L7-3456"],"chemin":{"hsk":93,"lire":95},"sens":{"statut":"relu","glose":"reconnaître, connaître","acceptions":[]},"exemples":[{"zh":"我认不出他了。","pinyin":"Wǒ rèn bu chū tā le.","fr":"Je ne l'ai pas reconnu.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"La forme traditionnelle 認 est un composé idéo-phonétique : 言, la parole, pour le sens, et 忍 (rěn) pour le son. La simplification a réduit 言 à 讠 et remplacé 忍 par 人, plus simple et proche par le son. Le ton diffère toutefois : 人 se lit rén, 认 se lit rèn.","en":"The traditional form 認 is a sound-meaning compound: 言, speech, gives the meaning and 忍 (rěn) gives the sound. Simplification reduced 言 to 讠 and replaced 忍 with 人, which is easier to write and sounds close. The tones still differ: 人 is rén, 认 is rèn.","roles":{"讠":"sens","人":"son"}}},"韧":{"c":"韧","pinyin":"rèn","lectures":["rèn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["韦","刃"],"sources":["cjk-decomp"]},"mots":["L7-1965","L7-3462"],"chemin":{},"sens":{"statut":"relu","glose":"souple et résistant, tenace","acceptions":[{"categorie":"Adj","fr":"souple et résistant, tenace"}]},"exemples":[{"zh":"这种材料很有韧性。","pinyin":"Zhè zhǒng cáiliào hěn yǒu rènxìng.","fr":"Ce matériau est très résistant.","statut":"relu"}],"origine":null},"扔":{"c":"扔","pinyin":"rēng","lectures":["rēng"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["扌","乃"],"sources":["cjk-decomp"]},"mots":["L5-0628"],"chemin":{},"sens":{"statut":"relu","glose":"jeter, lancer","acceptions":[{"categorie":"V","fr":"jeter, lancer ; se débarrasser de"}]},"exemples":[{"zh":"别把垃圾扔在地上。","pinyin":"Bié bǎ lājī rēng zài dìshang.","fr":"Ne jette pas tes déchets par terre.","statut":"relu"}],"origine":null},"仍":{"c":"仍","pinyin":"réng","lectures":["réng"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["亻","乃"],"sources":["cjk-decomp"]},"mots":["L3-0602","L3-0603","L5-0629"],"chemin":{},"sens":{"statut":"relu","glose":"toujours, encore","acceptions":[{"categorie":"Adv","fr":"toujours, encore, malgré tout"}]},"exemples":[{"zh":"他仍在那里工作。","pinyin":"Tā réng zài nàli gōngzuò.","fr":"Il y travaille encore.","statut":"relu"}],"origine":null},"日":{"c":"日","pinyin":"rì","lectures":["rì"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0308","L1-0309","L1-0331","L1-0414","L2-0290","L2-0466","L2-0467","L3-0604","L4-0603","L4-0604","L5-0280","L5-0403","L6-0421","L6-0444","L6-0460","L6-0591","L6-0691","L6-0692","L7-0627","L7-0757","L7-1152","L7-1240","L7-1535","L7-1913","L7-2916","L7-3144","L7-3463","L7-3464","L7-3465","L7-3466","L7-3467","L7-3468","L7-3469","L7-4270","L7-4414","L7-4696","L7-4864","L7-5084","L7-5103","L7-5207"],"chemin":{"hsk":6,"lire":5},"sens":{"statut":"relu","glose":"soleil, jour","acceptions":[]},"exemples":[{"zh":"今天是几月几日？","pinyin":"Jīntiān shì jǐ yuè jǐ rì?","fr":"Nous sommes le combien ?","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 日 est un cercle, souvent anguleux parce que gravé au couteau, avec un point ou un trait en son centre. Le Shuowen jiezi en fait l'astre plein, qui ne décroît jamais, à l'inverse de la lune. Au pinceau, le cercle est devenu un rectangle et le point un trait horizontal.","en":"On oracle bones, 日 is a circle, often angular because it was cut with a knife, with a dot or a stroke at its centre. The Shuowen jiezi describes it as the full orb that never wanes, unlike the moon. With the brush, the circle became a rectangle and the dot a horizontal stroke.","roles":{}}},"容":{"c":"容","pinyin":"róng","lectures":["róng"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["宀","谷"],"sources":["cjk-decomp"]},"mots":["L3-0506","L3-0605","L4-0819","L6-0368","L6-0572","L6-0892","L7-0091","L7-0289","L7-0639","L7-0640","L7-1985","L7-2467","L7-3473","L7-3474","L7-3475","L7-3476","L7-3477","L7-3478","L7-5305","L7-5590"],"chemin":{},"sens":{"statut":"relu","glose":"contenir ; tolérer ; visage","acceptions":[{"categorie":"V","fr":"contenir ; tolérer"},{"categorie":"N","fr":"visage, apparence"}]},"exemples":[],"origine":null},"溶":{"c":"溶","pinyin":"róng","lectures":["róng"],"niv