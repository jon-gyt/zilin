 果 once gave the sound, which was closer in Old Chinese. The Shuowen jiezi glosses it as “to test, to examine”. The meaning shifted from a set task that was then checked, to a lesson, and finally to a class.","roles":{"讠":"sens","果":"forme"}}},"啃":{"c":"啃","pinyin":"kěn","lectures":["kěn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["口","止","月"],"sources":["cjk-decomp"]},"mots":["L7-2405"],"chemin":{},"sens":{"statut":"relu","glose":"ronger, grignoter","acceptions":[{"categorie":"V","fr":"ronger, grignoter, mordiller"},{"categorie":"V","fr":"potasser, s'acharner sur (un livre)"}]},"exemples":[{"zh":"小狗在啃骨头。","pinyin":"Xiǎo gǒu zài kěn gǔtou.","fr":"Le chiot ronge un os.","statut":"relu"}],"origine":null},"垦":{"c":"垦","pinyin":"kěn","lectures":["kěn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["艮","土"],"sources":["cjk-decomp"]},"mots":["L7-2336"],"chemin":{},"sens":{"statut":"relu","glose":"défricher","acceptions":[{"categorie":"V","fr":"défricher, cultiver (une terre)"}]},"exemples":[{"zh":"这些地都是他们一点点垦出来的。","pinyin":"Zhèxiē dì dōu shì tāmen yīdiǎndiǎn kěn chūlai de.","fr":"Ces terres, ils les ont défrichées petit à petit.","statut":"relu"}],"origine":null},"恳":{"c":"恳","pinyin":"kěn","lectures":["kěn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["艮","心"],"sources":["cjk-decomp"]},"mots":["L7-0456","L7-2404"],"chemin":{},"sens":{"statut":"relu","glose":"sincère ; prier instamment","acceptions":[{"categorie":"Adj","fr":"sincère"},{"categorie":"V","fr":"prier instamment"}]},"exemples":[],"origine":null},"肯":{"c":"肯","pinyin":"kěn","lectures":["kěn"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["止","月"],"sources":["cjk-decomp"]},"mots":["L5-0446","L6-0511","L7-0283"],"chemin":{},"sens":{"statut":"relu","glose":"consentir, vouloir bien","acceptions":[{"categorie":"V","fr":"consentir à, vouloir bien, accepter de"}]},"exemples":[{"zh":"他不肯告诉我。","pinyin":"Tā bù kěn gàosu wǒ.","fr":"Il refuse de me le dire.","st