-4695","L7-5057"],"chemin":{"lire":109},"sens":{"statut":"relu","glose":"pouvoir, possible, mais","acceptions":[]},"exemples":[{"zh":"你可来了！","pinyin":"Nǐ kě lái le!","fr":"Te voilà enfin !","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi glose 可 par « consentir » et y voit 口, la bouche qui dit oui, avec un trait crochu, 丂 (kǎo), qui donnait un son proche. Ce trait crochu se lit aujourd'hui comme 丁, qui enveloppe 口. Du oui prononcé, le sens s'est étendu à « pouvoir » et à « possible ».","en":"The Shuowen jiezi glosses 可 as “to consent” and sees in it 口, the mouth that says yes, with a hooked stroke, 丂 (kǎo), which gave a similar sound. That hooked stroke now reads as 丁, wrapped around 口. From a spoken yes, the meaning widened to “can” and “possible”.","roles":{"丁":"forme","口":"sens"}}},"渴":{"c":"渴","pinyin":"kě","lectures":["kě"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["氵","日","勹","人","𠃊"],"sources":["cjk-decomp","surcharge"]},"mots":["L1-0198","L5-0440"],"chemin":{"hsk":108},"sens":{"statut":"relu","glose":"avoir soif","acceptions":[{"categorie":"Adj","fr":"assoiffé, qui a soif"}]},"exemples":[{"zh":"我很渴，想喝水。","pinyin":"Wǒ hěn kě, xiǎng hē shuǐ.","fr":"Je voudrais de l'eau, je meurs de soif.","statut":"relu"},{"zh":"你渴不渴？","pinyin":"Nǐ kě bu kě?","fr":"Tu as soif ?","statut":"relu"}],"origine":null},"克":{"c":"克","pinyin":"kè","lectures":["kè"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["十","口","儿"],"sources":["cjk-decomp"]},"mots":["L2-0323","L2-0434","L3-0417","L4-0580","L7-2395","L7-2396","L7-3169","L7-4007","L7-4668"],"chemin":{},"sens":{"statut":"relu","glose":"gramme","acceptions":[{"categorie":"M","fr":"gramme"}]},"exemples":[{"zh":"我要五百克肉。","pinyin":"Wǒ yào wǔbǎi kè ròu.","fr":"Je voudrais cinq cents grammes de viande.","statut":"relu"}],"origine":null},"刻":{"c":"刻","pinyin":"kè","lectures":["kè"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["亥","刂"],"sources":["cjk-