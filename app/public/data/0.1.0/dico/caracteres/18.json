"L5-0035","L5-0036","L5-0487","L5-1045"],"chemin":{"hsk":660,"lire":653},"sens":{"statut":"relu","glose":"compiler ; recueil, album","acceptions":[{"categorie":"V","fr":"compiler, rassembler (des textes)"},{"categorie":"N","fr":"recueil, volume ; album (de musique)"}]},"exemples":[{"zh":"这是她的第一张专辑。","pinyin":"Zhè shì tā de dì-yī zhāng zhuānjí.","fr":"C'est son premier album.","statut":"relu"}],"origine":null},"集":{"c":"集","pinyin":"jí","lectures":["jí"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["隹","木"],"sources":["cjk-decomp"]},"mots":["L3-0319","L3-0320","L4-0360","L5-0360","L5-0696","L6-0415","L7-0323","L7-0524","L7-1804","L7-1896","L7-1897","L7-1898","L7-1899","L7-1900","L7-2041","L7-2298","L7-2860","L7-3933","L7-5272","L7-5322"],"chemin":{"hsk":384,"lire":380},"sens":{"statut":"relu","glose":"rassembler ; marché ; épisode","acceptions":[{"categorie":"V","fr":"rassembler, réunir"},{"categorie":"N","fr":"marché (de village), foire"},{"categorie":"M","fr":"classificateur des épisodes, des volumes"}]},"exemples":[{"zh":"这个电视剧有三十集。","pinyin":"Zhège diànshìjù yǒu sānshí jí.","fr":"Cette série compte trente épisodes.","statut":"relu"}],"origine":null},"几":{"c":"几","pinyin":"jǐ","lectures":["jǐ","jī"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0165","L4-0349","L7-1848","L7-2630"],"chemin":{"hsk":25,"lire":28},"sens":{"statut":"relu","glose":"combien, quelques, petite table","acceptions":[]},"exemples":[{"zh":"你家有几口人？","pinyin":"Nǐ jiā yǒu jǐ kǒu rén?","fr":"Vous êtes combien dans ta famille ?","statut":"relu"},{"zh":"我买了几本书。","pinyin":"Wǒ mǎi le jǐ běn shū.","fr":"J'ai acheté quelques livres.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi décrit 几 comme le dessin d'une petite table basse, sur laquelle on s'accoude quand on est assis. Le sens courant, « combien, quelques », vient d'un autre caractère, 幾, que la simplification a confondu avec 几 parce que tous deux se lisent ji. Le petit meuble survit dans quelques mots, comme 茶几, la table basse.","en":"The Shuowen jiezi describes 几 as the picture of a small low table, the kind one leans on while seated. Its everyday meaning, “how many, a few”, comes from another character, 幾, which simplification merged with 几 because both are read ji. The small piece of furniture survives in a few words, such as 茶几, a coffee table.","roles":{}}},"己":{"c":"己","pinyin":"jǐ","lectures":["jǐ"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L2-0751","L7-3614","L7-3969","L7-5347"],"chemin":{"hsk":119,"lire":202},"sens":{"statut":"relu","glose":"soi, soi-même","acceptions":[{"categorie":"Pron","fr":"soi, soi-même"}]},"exemples":[],"origine":{"statut":"relu","etiquette":"mnemotechnique","fr":"Pour s'en souvenir : 己 ressemble à un fil qui se replie trois fois sur lui-même. Ce qui se replie sur soi, c'est soi-même : 自己. Ne pas le confondre avec 已, « déjà », ni avec 巳, dont la boucle est fermée.","en":"As a memory aid: 己 looks like a thread folding back on itself three times. What folds back on itself is oneself: 自己. Do not mix it up with 已, “already”, or with 巳, whose loop is closed.","roles":{}}},"挤":{"c":"挤","pinyin":"jǐ","lectures":["jǐ"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["扌","文","丨","丨"],"sources":["cjk-decomp","surcharge"]},"mots":["L5-0361","L7-1902","L7-5029"],"chemin":{"hsk":661,"lire":654},"sens":{"statut":"relu","glose":"se presser ; bondé ; presser","acceptions":[{"categorie":"V","fr":"se presser, se bousculer ; presser (un tube, un fruit)"},{"categorie":"Adj","fr":"bondé, encombré"}]},"exemples":[{"zh":"早上的地铁太挤了。","pinyin":"Zǎoshang de dìtiě tài jǐ le.","fr":"Le métro du matin est bondé.","statut":"relu"}],"origine":null},"脊":{"c":"脊","pinyin":"jǐ","lectures":["jǐ","jí"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["⿰冫⿱丿丶","人","月"],"sources":["surcharge"]},"mots":["L7-1903"],"chemin":{"hsk":1073,"lire":1066},"sen