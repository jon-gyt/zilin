mantic compound: 木, wood, gives the meaning, and 几 gives the sound. It serves as the simplified form of 機, where 幾 gave the sound, and which the Shuowen jiezi defines as the device that controls a release. From a wooden trigger, the meaning broadened to machines, then to an opportunity to seize.","roles":{"木":"sens","几":"son"}}},"激":{"c":"激","pinyin":"jī","lectures":["jī"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["氵","白","方","𠂉","乂"],"sources":["cjk-decomp"]},"mots":["L4-0126","L4-0353","L4-0354","L6-0409","L7-1260","L7-1866","L7-1867","L7-1868","L7-1869","L7-1870","L7-1871","L7-1872"],"chemin":{"hsk":520,"lire":513},"sens":{"statut":"relu","glose":"exciter, stimuler ; violent","acceptions":[{"categorie":"V","fr":"exciter, stimuler, émouvoir"},{"categorie":"Adj","fr":"violent, vif"}]},"exemples":[],"origine":null},"畸":{"c":"畸","pinyin":"jī","lectures":["jī"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["田","大","丁","口"],"sources":["cjk-decomp","surcharge"]},"mots":["L7-1865"],"chemin":{"hsk":1071,"lire":1064},"sens":{"statut":"relu","glose":"anormal, difforme","acceptions":[{"categorie":"Adj","fr":"anormal, difforme, irrégulier"}]},"exemples":[{"zh":"这种畸形的发展不能持续。","pinyin":"Zhè zhǒng jīxíng de fāzhǎn bù néng chíxù.","fr":"Un développement aussi déséquilibré ne peut pas durer.","statut":"relu"}],"origine":null},"积":{"c":"积","pinyin":"jī","lectures":["jī"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["禾","口","八"],"sources":["cjk-decomp"]},"mots":["L3-0313","L3-0489","L4-0352","L5-0758","L7-0704","L7-1350","L7-1857","L7-1858","L7-1859","L7-2547"],"chemin":{"hsk":382,"lire":378},"sens":{"statut":"relu","glose":"accumuler, amasser","acceptions":[{"categorie":"V","fr":"accumuler, amasser, entasser"}]},"exemples":[{"zh":"路上积了很多水。","pinyin":"Lù shang jī le hěn duō shuǐ.","fr":"Il y a de grosses flaques sur la route.","statut":"relu"}],"origine":null},"稽":{"c":"稽","pinyin":"jī","lectures":["jī","qǐ"],"niveau":7,"decomposition":