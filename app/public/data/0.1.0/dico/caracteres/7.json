rme"}}},"搭":{"c":"搭","pinyin":"dā","lectures":["dā"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["扌","卄","人","一","口"],"sources":["cjk-decomp","surcharge"]},"mots":["L6-0176","L6-0177","L6-0178","L7-0674","L7-0675"],"chemin":{},"sens":{"statut":"relu","glose":"dresser ; prendre (un transport)","acceptions":[{"categorie":"V","fr":"dresser, monter : une tente, un pont"},{"categorie":"V","fr":"prendre : un bus, un bateau ; profiter d'une voiture"},{"categorie":"V","fr":"joindre, associer"}]},"exemples":[{"zh":"我搭他的车回家。","pinyin":"Wǒ dā tā de chē huí jiā.","fr":"Il me ramène chez moi en voiture.","statut":"relu"}],"origine":null},"答":{"c":"答","pinyin":"dá","lectures":["dá","dā"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["⺮","人","一","口"],"sources":["cjk-decomp","surcharge"]},"mots":["L1-0155","L2-0085","L4-0135","L5-0015","L5-0151","L5-0152","L7-0677","L7-2121"],"chemin":{"hsk":98},"sens":{"statut":"relu","glose":"répondre","acceptions":[{"categorie":"V","fr":"répondre"}]},"exemples":[{"zh":"我问他，他不答。","pinyin":"Wǒ wèn tā, tā bù dá.","fr":"Je lui pose la question, il ne répond pas.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"mnemotechnique","fr":"Pour s'en souvenir : sous le bambou, ⺮, on lit 合, écrit 人, 一 et 口. 合 veut dire « s'ajuster », comme deux lamelles de bambou qui se répondent. Une réponse s'ajuste à la question : 答 veut dire « répondre ».","en":"As a memory aid: under bamboo, ⺮, you read 合, written 人, 一 and 口. 合 means “to fit together”, like two bamboo slips that match. An answer fits the question: 答 means “to reply”.","roles":{"⺮":"forme","人":"forme","一":"forme","口":"forme"}}},"达":{"c":"达","pinyin":"dá","lectures":["dá"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["辶","大"],"sources":["cjk-decomp"]},"mots":["L3-0046","L3-0124","L3-0143","L3-0173","L5-0133","L5-0150","L6-0213","L7-0388","L7-0676","L7-1847","L7-2675","L7-5358","L7-5490"],"chemin":{},"sens":{"statut":"relu","glose":"atteindre, parvenir 