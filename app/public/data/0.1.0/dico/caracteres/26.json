u ou yě"}]},"exemples":[{"zh":"他连喝了三杯水。","pinyin":"Tā lián hē le sān bēi shuǐ.","fr":"Il a bu trois verres d'eau coup sur coup.","statut":"relu"},{"zh":"他连饭都没吃。","pinyin":"Tā lián fàn dōu méi chī.","fr":"Il n'a même pas mangé.","statut":"relu"}],"origine":null},"敛":{"c":"敛","pinyin":"liǎn","lectures":["liǎn"],"niveau":7,"decomposition":null,"mots":["L7-3761"],"chemin":{"hsk":1470,"lire":1463},"sens":{"statut":"relu","glose":"rassembler ; retenir","acceptions":[{"categorie":"V","fr":"rassembler, recueillir ; retenir, contenir"}]},"exemples":[],"origine":null},"脸":{"c":"脸","pinyin":"liǎn","lectures":["liǎn"],"niveau":2,"decomposition":null,"mots":["L2-0351","L5-0474","L5-0475","L6-0891","L7-0518","L7-0902","L7-2614"],"chemin":{"hsk":345,"lire":342},"sens":{"statut":"relu","glose":"visage, figure","acceptions":[{"categorie":"N","fr":"visage, figure ; face, honneur"}]},"exemples":[{"zh":"你的脸怎么红了？","pinyin":"Nǐ de liǎn zěnme hóng le?","fr":"Pourquoi tu as rougi ?","statut":"relu"},{"zh":"快去洗脸。","pinyin":"Kuài qù xǐ liǎn.","fr":"Va vite te débarbouiller.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"mnemotechnique","fr":"Pour s'en souvenir : à gauche, 月, la chair, comme pour les parties du corps. À droite, 佥, « tous ensemble », écrit 人, 一 et le reste en dessous. Là où tous les traits de la tête se rassemblent : le visage.","en":"As a memory aid: on the left, 月, flesh, as for parts of the body. On the right, 佥, “all together”, written 人, 一 and the rest below. Where all the features of the head come together: the face.","roles":{}}},"恋":{"c":"恋","pinyin":"liàn","lectures":["liàn"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["亦","心"],"sources":["cjk-decomp"]},"mots":["L5-0476","L7-2616","L7-2678","L7-2848","L7-3679"],"chemin":{"hsk":678,"lire":671},"sens":{"statut":"relu","glose":"aimer, être attaché à","acceptions":[{"categorie":"V","fr":"aimer d'amour, être attaché à"}]},"exemples":[{"zh":"她很留恋在北京的日子。","pinyin":"Tā hěn liúliàn zài Běijīng de rìzi.","fr":"Elle regrette le temps passé à Pékin.","statut":"relu"}],"origine":null},"炼":{"c":"炼","pinyin":"liàn","lectures":["liàn"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["火","七","𠃌","八"],"sources":["cjk-decomp","surcharge"]},"mots":["L4-0205","L7-2615","L7-4053"],"chemin":{"hsk":537,"lire":530},"sens":{"statut":"relu","glose":"raffiner, fondre ; s'aguerrir","acceptions":[{"categorie":"V","fr":"raffiner, fondre un métal"},{"categorie":"V","fr":"s'exercer, s'aguerrir"}]},"exemples":[{"zh":"他每天早上锻炼身体。","pinyin":"Tā měi tiān zǎoshang duànliàn shēntǐ.","fr":"Il fait du sport tous les matins.","statut":"relu"}],"origine":null},"练":{"c":"练","pinyin":"liàn","lectures":["liàn"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["纟","七","𠃌","八"],"sources":["cjk-decomp","surcharge"]},"mots":["L2-0352","L2-0353","L3-0358","L3-0821","L4-0665","L7-2201","L7-2447","L7-3049","L7-4796"],"chemin":{"hsk":270,"lire":273},"sens":{"statut":"relu","glose":"s'entraîner, s'exercer","acceptions":[{"categorie":"V","fr":"s'entraîner, s'exercer"}]},"exemples":[{"zh":"他在练写字。","pinyin":"Tā zài liàn xiě zì.","fr":"Il s'exerce à écrire.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi écrit 練 et le glose « décreuser la soie » : 糸, le fil, et 柬 pour le son. On lave et on bat la soie encore et encore pour l'assouplir : de là « s'exercer ». Simplifié, 柬 prend une forme cursive, lue jiǎn, qui ne donne pas le son de liàn.","en":"The Shuowen jiezi writes 練 and glosses it as “degumming silk”: 糸, thread, and 柬 for the sound. Silk is washed and beaten again and again to soften it: hence “to practise”. Simplified, 柬 takes a cursive form, read jiǎn, which does not give the sound of liàn.","roles":{"纟":"sens","七":"forme","𠃌":"forme","八":"forme"}}},"链":{"c":"链","pinyin":"liàn","lectures":["liàn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["钅","辶","车"],"sources":["cjk-decomp"]},"mots":["L7-4546"],"chemin":{"hsk":1143,"lire":1136},"sens":{"statut":"relu","glose":"chaîne","acceptions":[{"categorie":"N","fr":"chaîne (maillons)"}]},"exemples":[],"origine":null},"凉":{"c":"凉","pinyin":"liáng","lectures":["liáng","liàng"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["冫","京"],"sources":["cjk-decomp"]},"mots":["L2-0354","L2-0355","L3-0454","L6-0541","L7-1771","L7-2620","L7-3180","L7-3341"],"chemin":{"hsk":270,"lire":274},"sens":{"statut":"relu","glose":"frais, froid","acceptions":[{"categorie":"Adj","fr":"frais, froid"}]},"exemples":[{"zh":"饭凉了。","pinyin":"Fàn liáng le.","fr":"Le repas a refroidi.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi écrit 涼 et le glose « léger » : l'eau, 水, et 京 pour le son. Une boisson légère, rafraîchissante : de là « frais ». La forme courante prend 冫, la glace ; 京, lu jīng, ne donne plus le son de liáng.","en":"The Shuowen jiezi writes 涼 and glosses it as “thin”: water, 水, and 京 for the sound. A light, refreshing drink: hence “cool”. The usual form takes 冫, ice; 京, read jīng, no longer gives the sound of liáng.","roles":{"冫":"sens","京":"forme"}}},"梁":{"c":"梁","pinyin":"liáng","lectures":["liáng"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["氵","刀","八","木"],"sources":["cjk-decomp"]},"mots":["L6-0654","L7-0926","L7-1903"],"chemin":{"hsk":819,"lire":812},"sens":{"statut":"relu","glose":"poutre ; pont","acceptions":[{"categorie":"N","fr":"poutre"},{"categorie":"N","fr":"pont"}]},"exemples":[],"origine":null},"粮":{"c":"粮","pinyin":"liáng","lectures":["liáng"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["米","艮","丶"],"sources":["cjk-decomp","surcharge"]},"mots":["L4-0478"],"chemin":{"hsk":538,"lire":531},"sens":{"statut":"relu","glose":"céréales, vivres","acceptions":[{"categorie":"N","fr":"céréales, grain, vivres"}]},"exemples":[],"origine":null},"良":{"c":"良","pinyin":"liáng","lectures":["liáng"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["艮","丶"],"sources":["cjk-decomp","surcharge"]},"mots":["L4-0476","L4-0616","L4-0893","L5-0061","L7-1238","L7-2617","L7-2618","L7-2619"],"chemin":{"hsk":538,"lire":531},"sens":{"statut":"relu","glose":"bon, excellent","acceptions":[{"categorie":"Adj","fr":"bon, excellent"}]},"exemples":[{"zh":"他是一个善良的人。","pinyin":"Tā shì yī ge shànliáng de rén.","fr":"C'est quelqu'un de bien.","statut":"relu"}],"origine":null},"两":{"c":"两","pinyin":"liǎng","lectures":["liǎng"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0215","L2-0356","L4-0479","L5-0477","L6-0542","L6-0543","L7-2621","L7-2622","L7-5074"],"chemin":{"hsk":70,"lire":67},"sens":{"statut":"relu","glose":"deux, les deux","acceptions":[]},"exemples":[{"zh":"我有两个哥哥。","pinyin":"Wǒ yǒu liǎng ge gēge.","fr":"J'ai deux grands frères.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"mnemotechnique","fr":"两 compte ce qui va par deux : deux personnes, deux jours, les deux côtés. Pour s'en souvenir : sous un trait horizontal, un cadre abrite deux petits 人 côte à côte. Deux personnes sous le même toit font une paire.","en":"两 counts things that come in twos: two people, two days, both sides. As a memory aid: under a horizontal stroke, a frame holds two small 人 side by side. Two people under one roof make a pair.","roles":{}}},"亮":{"c":"亮","pinyin":"liàng","lectures":["liàng"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["亠","口","冖","几"],"sources":["cjk-decomp"]},"mots":["L2-0357","L2-0416","L2-0698","L5-0507","L7-1670","L7-2623","L7-2624","L7-2625","L7-4539"],"chemin":{"hsk":271,"lire":274},"sens":{"statut":"relu","glose":"clair, brillant ; s'éclairer","acceptions":[{"categorie":"Adj","fr":"clair, lumineux, brillant"},{"categorie":"V","fr":"s'éclairer, s'allumer"}]},"exemples":[{"zh":"天亮了。","pinyin":"Tiān liàng le.","fr":"Le jour se lève.","statut":"relu"},{"zh":"房间里很亮。","pinyin":"Fángjiān li hěn liàng.","fr":"La pièce est très lumineuse.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"mnemotechnique","fr":"Pour s'en souvenir : en haut, le haut de 高, un pavillon élevé. En bas, 几, une personne qui s'y tient. Là-haut, en pleine lumière : 亮 veut dire « clair, brillant ».","en":"As a memory aid: at the top is the top of 高, a tall pavilion. Below it is 几, a person standing there. Up there, in full light: 亮 means “bright, shining”.","roles":{"亠":"forme","口":"forme","冖":"forme","几":"forme"}}},"谅":{"c":"谅","pinyin":"liàng","lectures":["liàng"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["讠","京"],"sources":["cjk-decomp"]},"mots":["L6-1008","L7-2626","L7-4059"],"chemin":{"hsk":820,"lire":813},"sens":{"statut":"relu","glose":"pardonner, comprendre ; sans doute","acceptions":[{"categorie":"V","fr":"pardonner, comprendre"},{"categorie":"Adv","fr":"sans doute, présumément"}]},"exemples":[],"origine":null},"辆":{"c":"辆","pinyin":"liàng","lectures":["liàng"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["车","两"],"sources":["cjk-decomp"]},"mots":["L2-0061","L2-0358"],"chemin":{"hsk":272,"lire":275},"sens":{"statut":"relu","glose":"classif. des véhicules","acceptions":[{"categorie":"M","fr":"classificateur des véhicules : voiture, vélo"}]},"exemples":[{"zh":"他买了一辆新车。","pinyin":"Tā mǎi le yī liàng xīn chē.","fr":"Il a acheté une voiture neuve.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"mnemotechnique","fr":"Pour s'en souvenir : à gauche, 车, le char. À droite, 两, « deux », qui se lit liǎng, la même syllabe que 辆, liàng. Un char monté sur deux roues : 辆 compte les véhicules.","en":"As a memory aid: on the left, 车, the cart. On the right, 两, “two”, read liǎng, the same syllable as 辆, liàng. A cart on two wheels: 辆 counts vehicles.","roles":{"车":"sens","两":"son"}}},"量":{"c":"量","pinyin":"liàng","lectures":["liàng","liáng"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["日","一","里"],"sources":["cjk-decomp","surcharge"]},"mots":["L2-0094","L2-0470","L3-0372","L3-0444","L3-0684","L4-0069","L4-0305","L4-04