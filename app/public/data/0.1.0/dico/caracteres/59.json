in":"zòng","lectures":["zòng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["米","宀","示"],"sources":["cjk-decomp"]},"mots":["L7-5592"],"chemin":{},"sens":{"statut":"relu","glose":"zongzi (riz gluant en feuilles)","acceptions":[{"categorie":"N","fr":"zongzi, riz gluant enveloppé de feuilles"}]},"exemples":[],"origine":null},"纵":{"c":"纵","pinyin":"zòng","lectures":["zòng"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["纟","人","人"],"sources":["cjk-decomp"]},"mots":["L6-0087","L7-1090","L7-5587","L7-5588","L7-5589","L7-5590","L7-5591"],"chemin":{},"sens":{"statut":"relu","glose":"vertical ; laisser libre ; même si","acceptions":[{"categorie":"Adj","fr":"vertical, dans le sens de la longueur"},{"categorie":"V","fr":"lâcher, laisser faire"},{"categorie":"Conj","fr":"même si : langue écrite"}]},"exemples":[],"origine":null},"走":{"c":"走","pinyin":"zǒu","lectures":["zǒu"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["土","龰"],"sources":["surcharge"]},"mots":["L1-0490","L1-0491","L2-0755","L2-0756","L2-0757","L5-0746","L6-0602","L6-1122","L7-0560","L7-0906","L7-4644","L7-5593","L7-5594","L7-5595","L7-5596","L7-5597","L7-5598"],"chemin":{"hsk":142,"lire":128},"sens":{"statut":"relu","glose":"marcher, aller, partir","acceptions":[]},"exemples":[{"zh":"你走得太快了。","pinyin":"Nǐ zǒu de tài kuài le.","fr":"Tu marches trop vite.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les bronzes, 走 montre un homme qui balance les bras en courant, au-dessus d'un pied 止, qui s'écrit aujourd'hui 龰, comme au bas de 足. Le Shuowen jiezi le glose par « courir vite », son premier sens, qui s'est affaibli ensuite en « marcher ». L'homme qui court, en haut, s'est raidi dans l'écriture en une forme proche de 土, sans rapport avec la terre.","en":"On bronzes, 走 shows a man swinging his arms as he runs, above a foot 止, now written 龰, as at the bottom of 足. The Shuowen jiezi glosses it as “to run fast”, its first meaning, which later softened to “to walk”. The running man at the top stiffened in writing into a shape like 土, which has nothing to do with earth.","roles":{"土":"forme","龰":"sens"}}},"奏":{"c":"奏","pinyin":"zòu","lectures":["zòu"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["𡗗","天"],"sources":["cjk-decomp"]},"mots":["L6-0446","L6-0932","L6-1123","L7-0082","L7-5599"],"chemin":{},"sens":{"statut":"relu","glose":"jouer (de la musique)","acceptions":[{"categorie":"V","fr":"jouer : un morceau de musique"},{"categorie":"V","fr":"présenter un rapport au trône"}]},"exemples":[{"zh":"乐队奏起了国歌。","pinyin":"Yuèduì zòu qǐ le guógē.","fr":"L'orchestre a entonné l'hymne national.","statut":"relu"}],"origine":null},"揍":{"c":"揍","pinyin":"zòu","lectures":["zòu"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["扌","𡗗","夭"],"sources":["cjk-decomp"]},"mots":["L7-5600"],"chemin":{},"sens":{"statut":"relu","glose":"frapper, rosser","acceptions":[{"categorie":"V","fr":"frapper, rosser, casser la figure (familier)"}]},"exemples":[{"zh":"他被人揍了一顿。","pinyin":"Tā bèi rén zòu le yī dùn.","fr":"Il s'est fait tabasser.","statut":"relu"}],"origine":null},"租":{"c":"租","pinyin":"zū","lectures":["zū"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["禾","且"],"sources":["cjk-decomp"]},"mots":["L2-0075","L2-0076","L2-0758","L3-0190","L6-1124","L7-5601"],"chemin":{},"sens":{"statut":"relu","glose":"louer","acceptions":[{"categorie":"V","fr":"louer : prendre ou donner en location"}]},"exemples":[{"zh":"我在北京租了一个房子。","pinyin":"Wǒ zài Běijīng zū le yī ge fángzi.","fr":"J'ai pris un appartement en location à Pékin.","statut":"relu"}],"origine":null},"卒":{"c":"卒","pinyin":"zú","lectures":["zú","cù"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["亠","人","人","十"],"sources":["cjk-decomp"]},"mots":["L7-4573"],"chemin":{},"sens":{"statut":"relu","glose":"soldat ; mourir","acceptions":[{"categorie":"N","fr":"soldat, fantassin"},{"categorie":"V","fr":"mourir, décéder"}]},"exemples":[],"o