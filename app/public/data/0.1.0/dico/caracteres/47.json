s":["L4-0132","L4-0736","L4-0807","L6-0121","L7-0116","L7-0402","L7-0873","L7-2345","L7-3334","L7-4556","L7-4557","L7-4558"],"chemin":{"hsk":585,"lire":578},"sens":{"statut":"relu","glose":"vendre, écouler ; annuler","acceptions":[{"categorie":"V","fr":"vendre, écouler"},{"categorie":"V","fr":"annuler, supprimer"}]},"exemples":[{"zh":"这本书销得很好。","pinyin":"Zhè běn shū xiāo de hěn hǎo.","fr":"Ce livre se vend très bien.","statut":"relu"}],"origine":null},"淆":{"c":"淆","pinyin":"xiáo","lectures":["xiáo"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["氵","乂","𠂇","月"],"sources":["cjk-decomp"]},"mots":["L7-1819"],"chemin":{"hsk":1354,"lire":1347},"sens":{"statut":"relu","glose":"mêler, confondre","acceptions":[{"categorie":"V","fr":"mêler, confondre, brouiller"}]},"exemples":[{"zh":"你不要混淆这两个概念。","pinyin":"Nǐ bù yào hùnxiáo zhè liǎng ge gàiniàn.","fr":"Ne confonds pas ces deux notions.","statut":"relu"}],"origine":null},"小":{"c":"小","pinyin":"xiǎo","lectures":["xiǎo"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0401","L1-0402","L1-0403","L1-0404","L1-0405","L1-0406","L1-0407","L2-0084","L2-0098","L2-0602","L2-0603","L2-0604","L2-0605","L2-0606","L2-0607","L2-0737","L4-0004","L4-0693","L4-0808","L4-0809","L4-0810","L5-0179","L5-0840","L6-0887","L6-0888","L6-0889","L7-0582","L7-0700","L7-0701","L7-0715","L7-2882","L7-4449","L7-4560","L7-4561","L7-4562","L7-4563","L7-4564","L7-4565","L7-4566","L7-4567","L7-4568","L7-4569","L7-4570","L7-4571","L7-4572","L7-4573","L7-4877"],"chemin":{"hsk":27,"lire":30},"sens":{"statut":"relu","glose":"petit, jeune","acceptions":[]},"exemples":[{"zh":"这个杯子太小了。","pinyin":"Zhège bēizi tài xiǎo le.","fr":"Ce verre est trop petit.","statut":"relu"},{"zh":"小王是我的同学。","pinyin":"Xiǎo Wáng shì wǒ de tóngxué.","fr":"Le petit Wang est dans ma classe.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 小 s'écrit de trois petits points, comme des grains minuscules. Le Shuowen jiezi le définit par la petitesse des choses et y lit un trait que 八 vient partager. Dans l'écriture actuelle, le point du milieu s'est allongé en un trait vertical à crochet, entre deux points qui s'écartent.","en":"On oracle bones, 小 is written as three small dots, like tiny grains. The Shuowen jiezi defines it as the smallness of things and reads it as a stroke split apart by 八. In today's script the middle dot has grown into a hooked vertical stroke, between two dots that spread outward.","roles":{}}},"晓":{"c":"晓","pinyin":"xiǎo","lectures":["xiǎo"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["日","𭠍","兀"],"sources":["cjk-decomp","surcharge"]},"mots":["L6-0890","L7-1942","L7-2104"],"chemin":{"hsk":866,"lire":859},"sens":{"statut":"relu","glose":"aube ; savoir","acceptions":[{"categorie":"N","fr":"aube, point du jour"},{"categorie":"V","fr":"savoir, comprendre"}]},"exemples":[],"origine":null},"啸":{"c":"啸","pinyin":"xiào","lectures":["xiào"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["口","肃"],"sources":["cjk-decomp"]},"mots":["L7-1554"],"chemin":{"hsk":1355,"lire":1348},"sens":{"statut":"relu","glose":"siffler, hurler (vent, animal)","acceptions":[{"categorie":"V","fr":"siffler, hurler (vent, bête sauvage)"}]},"exemples":[{"zh":"山里传来老虎的长啸。","pinyin":"Shān li chuánlái lǎohǔ de cháng xiào.","fr":"Le long rugissement d'un tigre monte de la montagne.","statut":"relu"}],"origine":null}}}
