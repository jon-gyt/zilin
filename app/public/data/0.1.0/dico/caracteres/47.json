nes it as moving forward in front, and analyses it as 儿 plus 之, an old form of that walking foot. In today's script, 𠂒 is what remains of the foot, and 儿 keeps the man's legs.","roles":{"𠂒":"sens","儿":"sens"}}},"掀":{"c":"掀","pinyin":"xiān","lectures":["xiān"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["扌","斤","欠"],"sources":["cjk-decomp"]},"mots":["L7-4481","L7-4482"],"chemin":{"hsk":1345,"lire":1338},"sens":{"statut":"relu","glose":"soulever, lever","acceptions":[{"categorie":"V","fr":"soulever, lever, retirer (un couvercle, un rideau)"}]},"exemples":[{"zh":"他掀开被子起床了。","pinyin":"Tā xiānkāi bèizi qǐchuáng le.","fr":"Il a repoussé la couette et s'est levé.","statut":"relu"}],"origine":null},"纤":{"c":"纤","pinyin":"xiān","lectures":["xiān","qiàn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["纟","千"],"sources":["cjk-decomp"]},"mots":["L7-1727","L7-4480"],"chemin":{"hsk":1345,"lire":1338},"sens":{"statut":"relu","glose":"fin, délicat ; fibre ; haler","acceptions":[{"categorie":"Adj","fr":"fin, menu, délicat"},{"categorie":"N","fr":"fibre"},{"categorie":"N","fr":"corde de halage","pinyin":"qiàn"}]},"exemples":[{"zh":"她的手指又白又纤细。","pinyin":"Tā de shǒuzhǐ yòu bái yòu xiānxì.","fr":"Elle a des doigts blancs et fins.","statut":"relu"}],"origine":null},"鲜":{"c":"鲜","pinyin":"xiān","lectures":["xiān","xiǎn"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["鱼","羊"],"sources":["cjk-decomp"]},"mots":["L4-0303","L4-0790","L4-0791","L4-0792","L4-0816","L5-0816","L7-0102","L7-4483","L7-4484","L7-4485"],"chemin":{"hsk":583,"lire":576},"sens":{"statut":"relu","glose":"frais ; savoureux ; vif","acceptions":[{"categorie":"Adj","fr":"frais"},{"categorie":"Adj","fr":"savoureux ; vif : couleur"},{"categorie":"Adj","fr":"rare","pinyin":"xiǎn"}]},"exemples":[{"zh":"这些鱼很鲜。","pinyin":"Zhèxiē yú hěn xiān.","fr":"Ces poissons viennent d'être pêchés.","statut":"relu"}],"origine":null},"咸":{"c":"咸","pinyin":"xián","lectures":["xián"],"niveau":4,"decomposi