atut":"relu","glose":"abandonner, rejeter","acceptions":[{"categorie":"V","fr":"abandonner, rejeter, jeter"}]},"exemples":[{"zh":"不要随便丢弃垃圾。","pinyin":"Bùyào suíbiàn diūqì lājī.","fr":"Ne jetez pas vos déchets n'importe où.","statut":"relu"}],"origine":null},"气":{"c":"气","pinyin":"qì","lectures":["qì"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0032","L1-0330","L1-0360","L2-0327","L2-0431","L2-0432","L3-0549","L4-0470","L4-0544","L4-0573","L4-0891","L4-0920","L5-0443","L5-0499","L5-0551","L5-0577","L5-0578","L5-0761","L5-0899","L6-0530","L6-0640","L6-0784","L6-0937","L7-0275","L7-0279","L7-0605","L7-0709","L7-1024","L7-1157","L7-1193","L7-1418","L7-1625","L7-2055","L7-2106","L7-2428","L7-2576","L7-2896","L7-3212","L7-3213","L7-3214","L7-3215","L7-3216","L7-3217","L7-3218","L7-3219","L7-3220","L7-3221","L7-3415","L7-3426","L7-3427","L7-3436","L7-3630","L7-3673","L7-3722","L7-4035","L7-4165","L7-4300","L7-4566","L7-4594","L7-4922","L7-5108","L7-5154","L7-5267","L7-5318","L7-5383"],"chemin":{"hsk":44,"lire":43},"sens":{"statut":"relu","glose":"air, gaz ; souffle ; se fâcher","acceptions":[{"categorie":"N","fr":"air, gaz ; souffle, haleine"},{"categorie":"V","fr":"mettre en colère ; se fâcher"}]},"exemples":[{"zh":"他气坏了。","pinyin":"Tā qì huài le.","fr":"Il était furieux.","statut":"relu"},{"zh":"今天天气不好。","pinyin":"Jīntiān tiānqì bù hǎo.","fr":"Il ne fait pas beau aujourd'hui.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 气 s'écrit de trois traits horizontaux, celui du milieu plus court, ce qui le distingue de 三. Le Shuowen jiezi y voit le dessin des vapeurs qui montent des nuages, d'où « souffle, air ». La forme traditionnelle 氣 a ajouté plus tard 米, le riz, et la forme simplifiée revient à 气 seul.","en":"On oracle bones, 气 is written with three horizontal strokes, the middle one shorter, which sets it apart from 三. The Shuowen jiezi sees in it a drawing of vapour rising from clouds, hence “breath, air”. The traditional form 氣 later added 米, rice, and the simplified form goes back to 气 alone.","roles":{}}},"汽":{"c":"汽","pinyin":"qì","lectures":["qì"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["氵","气"],"sources":["cjk-decomp"]},"mots":["L1-0290","L2-0188","L4-0574","L4-0575"],"chemin":{"hsk":96,"lire":95},"sens":{"statut":"relu","glose":"vapeur","acceptions":[]},"exemples":[],"origine":{"statut":"relu","etiquette":"atteste","fr":"汽 est un composé idéo-phonétique : 氵, l'eau, donne le sens, et 气 donne le son. Le Shuowen jiezi le glose par « eau tarie », un sens aujourd'hui perdu. Le mot désigne désormais la vapeur, l'eau passée à l'état de gaz, et entre dans 汽车, la voiture.","en":"汽 is a phono-semantic compound: 氵, water, gives the meaning, and 气 gives the sound. The Shuowen jiezi glosses it as “water run dry”, a sense now lost. Today it means steam, water turned into gas, and it appears in 汽车, a car.","roles":{"氵":"sens","气":"son"}}},"泣":{"c":"泣","pinyin":"qì","lectures":["qì"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["氵","立"],"sources":["cjk-decomp"]},"mots":["L7-2384","L7-2443"],"chemin":{},"sens":{"statut":"relu","glose":"pleurer (sans bruit) ; larmes","acceptions":[{"categorie":"V","fr":"pleurer, sangloter"},{"categorie":"N","fr":"larmes"}]},"exemples":[{"zh":"她低声哭泣。","pinyin":"Tā dīshēng kūqì.","fr":"Elle pleure doucement.","statut":"relu"}],"origine":null},"砌":{"c":"砌","pinyin":"qì","lectures":["qì","qiè"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["石","七","刀"],"sources":["cjk-decomp"]},"mots":["L7-0958"],"chemin":{},"sens":{"statut":"relu","glose":"maçonner, bâtir","acceptions":[{"categorie":"V","fr":"maçonner, bâtir en briques"}]},"exemples":[],"origine":null},"迄":{"c":"迄","pinyin":"qì","lectures":["qì"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["辶","𠂉","乙"],"sources":["cjk-decomp","surcharge"]},"mots":["L7-3222","L7-3223"],"chemin":{},"sens":{"statut":"relu","