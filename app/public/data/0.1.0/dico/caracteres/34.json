:null},"牵":{"c":"牵","pinyin":"qiān","lectures":["qiān"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["大","冖","牛"],"sources":["cjk-decomp"]},"mots":["L6-0644","L7-3244","L7-3245","L7-3246","L7-3247","L7-3248"],"chemin":{},"sens":{"statut":"relu","glose":"mener par la main ; impliquer","acceptions":[{"categorie":"V","fr":"tenir par la main, mener, tirer"},{"categorie":"V","fr":"impliquer, concerner"}]},"exemples":[{"zh":"妈妈牵着孩子的手过马路。","pinyin":"Māma qiān zhe háizi de shǒu guò mǎlù.","fr":"La mère traverse la rue en tenant son enfant par la main.","statut":"relu"}],"origine":null},"签":{"c":"签","pinyin":"qiān","lectures":["qiān"],"niveau":5,"decomposition":null,"mots":["L5-0579","L5-0580","L5-0581","L5-0582","L5-0583","L5-0584","L7-0204","L7-0510","L7-3251","L7-3252"],"chemin":{},"sens":{"statut":"relu","glose":"signer ; étiquette, bâtonnet","acceptions":[{"categorie":"V","fr":"signer, apposer sa signature"},{"categorie":"N","fr":"étiquette ; bâtonnet (de divination)"}]},"exemples":[{"zh":"请在这里签上你的名字。","pinyin":"Qǐng zài zhèli qiān shàng nǐ de míngzi.","fr":"Mets ton nom ici, s'il te plaît.","statut":"relu"}],"origine":null},"谦":{"c":"谦","pinyin":"qiān","lectures":["qiān"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["讠","兼"],"sources":["cjk-decomp"]},"mots":["L6-0646","L7-3250"],"chemin":{},"sens":{"statut":"relu","glose":"modeste, humble","acceptions":[{"categorie":"Adj","fr":"modeste, humble"}]},"exemples":[],"origine":null},"迁":{"c":"迁","pinyin":"qiān","lectures":["qiān"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["辶","千"],"sources":["cjk-decomp"]},"mots":["L6-0097","L7-0067","L7-0187","L7-3241","L7-3242","L7-3243"],"chemin":{},"sens":{"statut":"relu","glose":"déménager, transférer","acceptions":[{"categorie":"V","fr":"déménager, transférer ; changer"}]},"exemples":[{"zh":"他们家去年迁到了北京。","pinyin":"Tāmen jiā qùnián qiān dào le Běijīng.","fr":"Sa famille s'est installée à Pékin l'an dernier.","statut":"relu"}],"origine":null},"铅":{"c":"铅","pinyin":"qiān","lectures":["qiān","yán"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["钅","几","口"],"sources":["cjk-decomp"]},"mots":["L6-0645","L7-3249"],"chemin":{},"sens":{"statut":"relu","glose":"plomb ; mine de crayon","acceptions":[{"categorie":"N","fr":"plomb"},{"categorie":"N","fr":"mine de crayon"}]},"exemples":[{"zh":"铅对身体有害。","pinyin":"Qiān duì shēntǐ yǒuhài.","fr":"Ce métal est nocif pour la santé.","statut":"relu"}],"origine":null},"前":{"c":"前","pinyin":"qián","lectures":["qián"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["䒑","月","刂"],"sources":["surcharge"]},"mots":["L1-0291","L1-0292","L1-0293","L2-0379","L2-0435","L2-0654","L3-0118","L3-0499","L3-0551","L3-0552","L3-0553","L3-0554","L3-0700","L3-0825","L4-0577","L4-0578","L4-0950","L5-0184","L5-0275","L5-0529","L5-0585","L5-0586","L5-0815","L5-0831","L6-0167","L6-0647","L6-0648","L7-0408","L7-1322","L7-2409","L7-3253","L7-3254","L7-3255","L7-3256","L7-3257","L7-3258","L7-3259","L7-3260","L7-3261","L7-3262","L7-3263","L7-3264","L7-3265","L7-3466","L7-3652","L7-3718","L7-3914","L7-5034"],"chemin":{"hsk":107,"lire":119},"sens":{"statut":"relu","glose":"devant, avant","acceptions":[]},"exemples":[{"zh":"三年前我来到北京。","pinyin":"Sān nián qián wǒ láidào Běijīng.","fr":"Je suis arrivé à Pékin il y a trois ans.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi explique 歬, un pied 止 posé sur une barque 舟, par l'idée d'avancer sans marcher. On y a ajouté un couteau pour écrire « couper », mais cette forme a été prise pour « avant », et « couper » s'est alors écrit 剪, avec un second couteau 刀 dessous. Dans la forme actuelle, le pied est devenu 䒑, la barque 月, et le couteau 刂.","en":"The Shuowen jiezi explains 歬, a foot 止 set on a boat 舟, as moving forward without walking. A knife was added to write “to cut”, but that form was taken for “forward”, and “to cut” was then written 剪, with a second knife 刀 underneath. In today's form the foot has become 䒑, the boat 月, and the knife 刂.","roles":{"䒑":"forme","月":"forme","刂":"forme"}}},"潜":{"c":"潜","pinyin":"qián","lectures":["qián"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["氵","夫","夫","日"],"sources":["cjk-decomp"]},"mots":["L6-0649","L7-3269","L7-3270","L7-3271","L7-3272","L7-3273"],"chemin":{},"sens":{"statut":"relu","glose":"plonger ; caché, latent","acceptions":[{"categorie":"V","fr":"plonger, s'immerger"},{"categorie":"Adj","fr":"caché, latent"}]},"exemples":[],"origine":null},"虔":{"c":"虔","pinyin":"qián","lectures":["qián"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["虍","文"],"sources":["cjk-decomp"]},"mots":["L7-3266"],"chemin":{},"sens":{"statut":"relu","glose":"pieux, dévot","acceptions":[{"categorie":"Adj","fr":"pieux, dévot, respectueux"}]},"exemples":[],"origine":null},"钱":{"c":"钱","pinyin":"qián","lectures":["qián"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["钅","戋"],"sources":["cjk-decomp"]},"mots":["L1-0294","L1-0295","L3-0335","L5-0998","L6-0456","L6-0730","L6-1106","L7-0144","L7-2004","L7-2660","L7-2662","L7-3076","L7-3267","L7-3904","L7-4026","L7-5364"],"chemin":{"hsk":215,"lire":179},"sens":{"statut":"relu","glose":"argent, monnaie","acceptions":[]},"exemples":[{"zh":"你有钱吗？","pinyin":"Nǐ yǒu qián ma?","fr":"Tu as des sous ?","statut":"relu"},{"zh":"他没有钱买车。","pinyin":"Tā méiyou qián mǎi chē.","fr":"Il n'a pas les moyens d'acheter une voiture.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi range 钱 parmi les idéo-phonétiques : 金, le métal, devenu 钅, donne le sens, et 戋 en donnait le son, mais se lit aujourd'hui jiān, avec une autre initiale que qián. Il le glose comme un outil agricole en métal, une sorte de bêche. Le nom de l'outil est passé à la monnaie, peut-être parce que des pièces anciennes avaient la forme d'une bêche.","en":"The Shuowen jiezi classes 钱 as a phonetic compound: 金, metal, reduced to 钅, gives the meaning, and 戋 gave the sound, though it now reads jiān, with a different initial from qián. It glosses the word as a metal farming tool, a kind of spade. The tool's name passed to money, perhaps because some early coins were shaped like a spade.","roles":{"钅":"sens","戋":"forme"}}},"钳":{"c":"钳","pinyin":"qián","lectures":["qián"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["钅","甘"],"sources":["cjk-decomp"]},"mots":["L7-3268"],"chemin":{},"sens":{"statut":"relu","glose":"pince, tenailles ; serrer","acceptions":[{"categorie":"N","fr":"pince, tenailles"},{"categorie":"V","fr":"serrer, pincer ; contenir"}]},"exemples":[],"origine":null},"浅":{"c":"浅","pinyin":"qiǎn","lectures":["qiǎn","jiān"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["氵","戋"],"sources":["cjk-decomp"]},"mots":["L4-0579","L7-1306"],"chemin":{},"sens":{"statut":"relu","glose":"peu profond ; clair ; facile","acceptions":[{"categorie":"Adj","fr":"peu profond"},{"categorie":"Adj","fr":"clair, pâle ; simple, facile"}]},"exemples":[{"zh":"这里的水很浅。","pinyin":"Zhèli de shuǐ hěn qiǎn.","fr":"Ici, on a pied.","statut":"relu"}],"origine":null}}}
