iveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["门","夂","口"],"sources":["cjk-decomp"]},"mots":["L7-2981"],"chemin":{},"sens":{"statut":"relu","glose":"pavillon ; cabinet","acceptions":[{"categorie":"N","fr":"pavillon, belvédère ; cabinet (gouvernement)"}]},"exemples":[],"origine":null},"隔":{"c":"隔","pinyin":"gé","lectures":["gé"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["阝","鬲"],"sources":["cjk-decomp"]},"mots":["L4-0269","L4-0270","L5-0273","L7-1318","L7-1319","L7-2013","L7-3700"],"chemin":{},"sens":{"statut":"relu","glose":"séparer ; à intervalle de","acceptions":[{"categorie":"V","fr":"séparer, isoler"},{"categorie":"V","fr":"être à distance de, à intervalle de"}]},"exemples":[{"zh":"我家和他家隔着一条河。","pinyin":"Wǒ jiā hé tā jiā gé zhe yī tiáo hé.","fr":"Une rivière sépare nos deux maisons.","statut":"relu"}],"origine":null},"革":{"c":"革","pinyin":"gé","lectures":["gé","jí"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L5-0257","L6-0317","L7-0185","L7-1237","L7-1313"],"chemin":{},"sens":{"statut":"relu","glose":"cuir ; changer, réformer","acceptions":[{"categorie":"N","fr":"cuir"},{"categorie":"V","fr":"changer, réformer, révolutionner"}]},"exemples":[{"zh":"这是一次技术革新。","pinyin":"Zhè shì yī cì jìshù géxīn.","fr":"C'est une innovation technique.","statut":"relu"}],"origine":null},"个":{"c":"个","pinyin":"gè","lectures":["gè","gě"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0120","L2-0186","L3-0230","L3-0231","L3-0890","L4-0271","L4-0272","L4-0273","L4-0621","L4-0785","L5-0274","L7-1320","L7-1321","L7-4884"],"chemin":{"hsk":85,"lire":85},"sens":{"statut":"relu","glose":"classificateur général","acceptions":[]},"exemples":[{"zh":"我有两个妹妹。","pinyin":"Wǒ yǒu liǎng ge mèimei.","fr":"J'ai deux petites sœurs.","statut":"relu"},{"zh":"这个人是谁？","pinyin":"Zhège rén shì shéi?","fr":"Qui est cette personne ?","statut":"relu"}],"origine":{"statut":"relu","etiquette":"mnemotechnique","fr":"Pour s'en souvenir : en haut, deux traits en toit, comme 人, et dessous un seul trait vertical, une unité. On compte ainsi les choses et les personnes une à une, et 个 est le mot de compte le plus courant. Dans l'écriture simplifiée, 个 remplace aussi les anciens 個 et 箇.","en":"A way to remember it: two strokes forming a roof on top, like 人, and a single vertical stroke below, one unit. That is how people and things are counted, one by one, and 个 is the most common measure word. In simplified script, 个 also stands in for the older 個 and 箇.","roles":{}}},"各":{"c":"各","pinyin":"gè","lectures":["gè","gě"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["夂","口"],"sources":["cjk-decomp"]},"mots":["L3-0232","L3-0233","L3-0234","L3-0235","L3-0236","L4-0273","L7-1322","L7-1323"],"chemin":{},"sens":{"statut":"relu","glose":"chaque, chacun ; divers","acceptions":[{"categorie":"Pron","fr":"chaque, chacun ; divers"},{"categorie":"Adv","fr":"chacun de son côté"}]},"exemples":[{"zh":"各国的人都来了。","pinyin":"Gè guó de rén dōu lái le.","fr":"Des gens de tous les pays sont venus.","statut":"relu"},{"zh":"我们各做各的。","pinyin":"Wǒmen gè zuò gè de.","fr":"Chacun s'occupe de ses affaires.","statut":"relu"}],"origine":null},"给":{"c":"给","pinyin":"gěi","lectures":["gěi","jǐ"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["纟","人","一","口"],"sources":["cjk-decomp","surcharge"]},"mots":["L1-0121","L2-0270","L2-0508","L5-0199","L6-0326","L6-0416","L7-0265"],"chemin":{"hsk":139,"lire":105},"sens":{"statut":"relu","glose":"donner ; à, pour","acceptions":[{"categorie":"V","fr":"donner"},{"categorie":"Prep","fr":"à, pour : introduit celui qui reçoit ou profite"}]},"exemples":[{"zh":"妈妈给了我一本书。","pinyin":"Māma gěi le wǒ yī běn shū.","fr":"Maman m'a donné un livre.","statut":"relu"},{"zh":"我给你打电话。","pinyin":"Wǒ gěi nǐ dǎ diànhuà.","fr":"Je t'appelle.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi décrit 給 comme un composé idéo-phonétique : 糸, le fil, pour le sens, et 合 pour le son. Il le glose par « fournir ce qui manque », d'où le sens de « donner ». 合 se lit aujourd'hui hé, ou gě comme unité de mesure, et ne donne plus le son de gěi ; dans la forme simplifiée, 糸 est réduit à 纟.","en":"The Shuowen jiezi describes 給 as a sound-meaning compound: 糸, thread, gives the meaning and 合 gives the sound. Its gloss is “to supply what is lacking”, hence “to give”. 合 now reads hé, or gě as a unit of measure, and no longer gives the sound of gěi; in the simplified form, 糸 is reduced to 纟.","roles":{"纟":"sens","人":"forme","一":"forme","口":"forme"}}},"根":{"c":"根","pinyin":"gēn","lectures":["gēn"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["木","艮"],"sources":["cjk-decomp"]},"mots":["L3-0237","L4-0274","L4-0275","L7-1324","L7-1325","L7-1326","L7-1327","L7-1492","L7-5223","L7-5238"],"chemin":{},"sens":{"statut":"relu","glose":"racine ; classif. des objets longs","acceptions":[{"categorie":"N","fr":"racine ; origine"},{"categorie":"M","fr":"classificateur des objets longs et fins : baguette, corde"}]},"exemples":[{"zh":"给我一根筷子。","pinyin":"Gěi wǒ yī gēn kuàizi.","fr":"Passe-moi une baguette.","statut":"relu"}],"origine":null},"跟":{"c":"跟","pinyin":"gēn","lectures":["gēn"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["口","龰","艮"],"sources":["surcharge"]},"mots":["L1-0122","L5-0266","L5-0275","L5-0276","L7-1328","L7-1329","L7-1330"],"chemin":{"hsk":129,"lire":138},"sens":{"statut":"relu","glose":"suivre, avec, talon","acceptions":[]},"exemples":[{"zh":"我跟你一起去。","pinyin":"Wǒ gēn nǐ yīqǐ qù.","fr":"J'y vais avec toi.","statut":"relu"},{"zh":"请跟我来。","pinyin":"Qǐng gēn wǒ lái.","fr":"Suivez-moi, s'il vous plaît.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi définit 跟 comme le talon, avec 足, le pied, pour le sens, et 艮 gèn pour le son, proche de gēn. À gauche, 足 se décompose en 口 posé sur 龰. Du talon, le sens est passé à « suivre sur les talons », puis à « avec ».","en":"The Shuowen jiezi defines 跟 as the heel, with 足, foot, for the meaning, and 艮 gèn for the sound, close to gēn. On the left, 足 breaks down into 口 over 龰. From the heel the meaning moved to following at someone's heels, then to “with”.","roles":{"口":"sens","龰":"sens","艮":"son"}}},"耕":{"c":"耕","pinyin":"gēng","lectures":["gēng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["耒","井"],"sources":["cjk-decomp"]},"mots":["L7-1333"],"chemin":{},"sens":{"statut":"relu","glose":"labourer","acceptions":[{"categorie":"V","fr":"labourer, cultiver"}]},"exemples":[],"origine":null},"耿":{"c":"耿","pinyin":"gěng","lectures":["gěng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["耳","火"],"sources":["cjk-decomp"]},"mots":["L7-1334"],"chemin":{},"sens":{"statut":"relu","glose":"droit, loyal","acceptions":[{"categorie":"Adj","fr":"droit, loyal"}]},"exemples":[],"origine":null},"更":{"c":"更","pinyin":"gèng","lectures":["gèng","gēng"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L2-0187","L3-0238","L5-0277","L5-0278","L6-0044","L6-0318","L7-1331","L7-1332","L7-5557"],"chemin":{},"sens":{"statut":"relu","glose":"encore plus, davantage","acceptions":[{"categorie":"Adv","fr":"encore plus, davantage"}]},"exemples":[{"zh":"今天比昨天更冷。","pinyin":"Jīntiān bǐ zuótiān gèng lěng.","fr":"Il fait encore plus froid qu'hier.","statut":"relu"}],"origine":null},"供":{"c":"供","pinyin":"gōng","lectures":["gōng","gòng"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["亻","龷","八"],"sources":["cjk-decomp"]},"mots":["L4-0278","L4-0701","L6-0326","L7-1378","L7-1379","L7-1380","L7-1381","L7-1391"],"chemin":{},"sens":{"statut":"relu","glose":"fournir ; offrir en offrande","acceptions":[{"categorie":"V","fr":"fournir, approvisionner"},{"categorie":"V","fr":"offrir en offrande ; avouer","pinyin":"gòng"}]},"exemples":[{"zh":"学校给学生供午饭。","pinyin":"Xuéxiào gěi xuésheng gōng wǔfàn.","fr":"L'école donne le déjeuner aux élèves.","statut":"relu"}],"origine":null},"公":{"c":"公","pinyin":"gōng","lectures":["gōng"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["八","厶"],"sources":["cjk-decomp"]},"mots":["L2-0010","L2-0188","L2-0189","L2-0190","L2-0191","L2-0192","L2-0193","L2-0194","L2-0195","L3-0225","L3-0245","L3-0246","L3-0247","L3-0248","L3-0249","L4-0277","L4-0459","L5-0281","L5-0282","L5-0283","L5-0284","L6-0009","L6-0320","L6-0321","L6-0322","L6-0323","L6-0324","L7-0698","L7-1343","L7-1344","L7-1345","L7-1346","L7-1347","L7-1348","L7-1349","L7-1350","L7-1351","L7-1352","L7-1353","L7-1354","L7-1355","L7-1356","L7-1357","L7-1358","L7-1359","L7-1360","L7-1361","L7-1362","L7-1363","L7-1364","L7-1365","L7-1366","L7-1367","L7-4231","L7-5098","L7-5455"],"chemin":{},"sens":{"statut":"relu","glose":"public, commun ; mâle","acceptions":[{"categorie":"Adj","fr":"public, commun ; officiel"},{"categorie":"Adj","fr":"mâle, pour un animal"}]},"exemples":[{"zh":"这只鸡是公的。","pinyin":"Zhè zhī jī shì gōng de.","fr":"Ce poulet est un coq.","statut":"relu"}],"origine":null},"功":{"c":"功","pinyin":"gōng","lectures":["gōng"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["工","力"],"sources":["cjk-decomp"]},"mots":["L3-0089","L3-0250","L3-0251","L3-0252","L7-0976","L7-1368","L7-1369","L7-1370","L7-1371","L7-1372","L7-1373","L7-1374","L7-1860","L7-2589","L7-4454","L7-5041"],"chemin":{},"sens":{"statut":"relu","glose":"mérite, exploit ; effort","acceptions":[{"categorie":"N","fr":"mérite, exploit ; effort, travail"}]},"exemples":[{"zh":"他立了大功。","pinyin":"Tā lì le dà gōng.","fr":"Il a accompli un grand exploit.","statut":"relu"}],"origine":null},"宫":{"c":"宫","pinyin":"gōng","lectures":["gōng"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["宀","口","口"],"sources":["cjk-decomp"]},"mots":["L6-0327","L7-1382","L7-1383","L7-1775"],"chemin":{},"sens":{"statut":"relu","glose":"palais","acceptions":[{"categorie":"N","fr":"palais ; temple"}]},"exemples":[{"zh":"皇帝住在宫里。","pinyin":"Huángdì zhù zài gōng li.","fr":"L'empereur vit au palais.","statut":"relu"}],"origine":null},"工":{"c":"工","pinyin":"gōng","lectures":["gōng"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0123","L1-0124","L2-0086","L3-0239","L3-0240","L3-0241","L3-0242","L3-0243","L3-0244","L3-0328","L3-0588","L3-0870","L3-0911","L4-0276","L4-0655","L5-0279","L5-0280","L6-0005","L6-0275","L6-0319","L6-0583","L6-0664","L7-0733","L7-0916","L7-1335","L7-1336","L7-1337","L7-1338","L7-1339","L7-1340","L7-1341","L7-2323","L7-2335","L7-3027","L7-3321","L7-3433","L7-3691","L7-4952"],"chemin":{"hsk":12,"lire":26},"sens":{"statut":"relu","glose":"travail, ouvrier, industrie","acceptions":[]},"exemples":[],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 工 dessine un outil, que l'on identifie le plus souvent à une équerre de charpentier, sans que la lecture fasse l'unanimité. Le Shuowen jiezi le définit par l'ouvrage habile et y voit un homme qui tient le compas et l'équerre. De l'outil viennent les sens de « travail » et d'« ouvrier ».","en":"On oracle bones, 工 draws a tool, most often identified as a carpenter's square, though that reading is not unanimous. The Shuowen jiezi defines it as skilled work and sees in it a man holding compass and square. From the tool come the meanings “work” and “worker”.","roles":{}}}}}
