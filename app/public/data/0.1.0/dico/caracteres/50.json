ions":[{"categorie":"V","fr":"broyer, moudre ; étudier à fond"}]},"exemples":[],"origine":null},"言":{"c":"言","pinyin":"yán","lectures":["yán"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L2-0690","L3-0178","L5-0874","L6-0156","L6-0254","L6-0553","L6-1115","L7-0727","L7-1069","L7-1763","L7-1783","L7-2898","L7-3039","L7-4518","L7-4708","L7-4773","L7-4774","L7-4775","L7-4829","L7-4947","L7-4948","L7-5120","L7-5126","L7-5155","L7-5585"],"chemin":{"hsk":221,"lire":120},"sens":{"statut":"relu","glose":"parole, dire","acceptions":[]},"exemples":[],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 言 dessine une bouche 口 d'où sort une ligne, la parole qui s'en échappe. Le Shuowen jiezi distingue 言, dire les choses droit, et 语, discuter. Seul ou en bas d'un caractère, il garde sa forme pleine ; à gauche, il se simplifie en 讠, et dans 信, placé à droite, il reste entier.","en":"On oracle bones, 言 draws a mouth 口 with a line rising from it, speech coming out. The Shuowen jiezi tells 言, saying things straight, from 语, discussing. On its own or at the bottom of a character it keeps its full form; on the left it is simplified to 讠, and in 信, where it sits on the right, it stays whole.","roles":{}}},"阎":{"c":"阎","pinyin":"yán","lectures":["yán"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["门","⺈","臼"],"sources":["cjk-decomp"]},"mots":["L7-4783"],"chemin":{"hsk":1380,"lire":1373},"sens":{"statut":"relu","glose":"nom de famille ; porte de ruelle","acceptions":[{"categorie":"N","fr":"nom de famille"},{"categorie":"N","fr":"porte d'une ruelle (ancien)"}]},"exemples":[],"origine":null},"颜":{"c":"颜","pinyin":"yán","lectures":["yán"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["产","彡","页"],"sources":["cjk-decomp"]},"mots":["L2-0633","L4-0771","L7-3478"],"chemin":{"hsk":323,"lire":320},"sens":{"statut":"relu","glose":"visage, mine ; couleur","acceptions":[{"categorie":"N","fr":"visage, mine ; couleur"}]},"exemples":[],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi écrit 顏 et le glose « l'espace entre les sourcils » : 頁, la tête, et 彥 pour le son. 彦, écrit 产 et 彡, se lit yàn, la même syllabe que 颜, yán. Du front, on est passé au visage, puis à sa couleur, 颜色.","en":"The Shuowen jiezi writes 顏 and glosses it as “the space between the eyebrows”: 頁, the head, and 彥 for the sound. 彦, written 产 and 彡, is read yàn, the same syllable as 颜, yán. From the brow the meaning moved to the face, then to its colour, 颜色.","roles":{"产":"son","彡":"son","页":"sens"}}},"掩":{"c":"掩","pinyin":"yǎn","lectures":["yǎn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["扌","大","电"],"sources":["cjk-decomp"]},"mots":["L7-4785","L7-4786","L7-4787"],"chemin":{"hsk":1381,"lire":1374},"sens":{"statut":"relu","glose":"couvrir, cacher","acceptions":[{"categorie":"V","fr":"couvrir, cacher ; fermer"}]},"exemples":[],"origine":null},"演":{"c":"演","pinyin":"yǎn","lectures":["yǎn"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["氵","宀","一","由","八"],"sources":["cjk-decomp","surcharge"]},"mots":["L3-0051","L3-0142","L3-0826","L3-0827","L3-0828","L3-0829","L3-0830","L4-0854","L5-0009","L6-0717","L6-0932","L7-0553","L7-4793","L7-4794","L7-4795","L7-4796","L7-4797","L7-4798","L7-4799","L7-4800","L7-4801","L7-4802","L7-5130","L7-5458"],"chemin":{"hsk":455,"lire":448},"sens":{"statut":"relu","glose":"jouer (un rôle), représenter","acceptions":[{"categorie":"V","fr":"jouer, interpréter (un rôle) ; représenter"}]},"exemples":[{"zh":"他在电影里演一个老师。","pinyin":"Tā zài diànyǐng li yǎn yī ge lǎoshī.","fr":"Dans le film, il joue un professeur.","statut":"relu"}],"origine":null},"眼":{"c":"眼","pinyin":"yǎn","lectures":["yǎn"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["目","艮"],"sources":["cjk-decomp"]},"mots":["L2-0634","L2-0635","L3-0825","L4-0851","L4-0852","L4-0853","L5-0876","L6-0660","L6-0931","L7-0288","L7-1667","L7-2004","L7-2814","L7-3290"