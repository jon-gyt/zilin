r":"Ici, les fleurs ont des couleurs éclatantes.","statut":"relu"}],"origine":null},"雁":{"c":"雁","pinyin":"yàn","lectures":["yàn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["厂","亻","隹"],"sources":["cjk-decomp"]},"mots":["L7-0718"],"chemin":{"hsk":1382,"lire":1375},"sens":{"statut":"relu","glose":"oie sauvage","acceptions":[{"categorie":"N","fr":"oie sauvage"}]},"exemples":[],"origine":null},"验":{"c":"验","pinyin":"yàn","lectures":["yàn"],"niveau":3,"decomposition":null,"mots":["L3-0383","L3-0413","L3-0647","L3-0648","L3-0662","L3-0705","L5-0378","L7-0358","L7-1729","L7-4807","L7-4808","L7-4809"],"chemin":{"hsk":477,"lire":470},"sens":{"statut":"relu","glose":"examiner, vérifier, tester","acceptions":[{"categorie":"V","fr":"examiner, vérifier, tester"}]},"exemples":[{"zh":"医生让我去验血。","pinyin":"Yīshēng ràng wǒ qù yàn xiě.","fr":"Le médecin m'a envoyé faire une prise de sang.","statut":"relu"}],"origine":null},"央":{"c":"央","pinyin":"yāng","lectures":["yāng"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L5-1024"],"chemin":{"hsk":286,"lire":290},"sens":{"statut":"relu","glose":"centre, milieu","acceptions":[{"categorie":"N","fr":"centre, milieu"}]},"exemples":[{"zh":"湖的中央有一个小岛。","pinyin":"Hú de zhōngyāng yǒu yī ge xiǎo dǎo.","fr":"Au milieu du lac, il y a une petite île.","statut":"relu"}],"origine":null},"殃":{"c":"殃","pinyin":"yāng","lectures":["yāng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["歹","央"],"sources":["cjk-decomp"]},"mots":["L7-5204"],"chemin":{"hsk":1383,"lire":1376},"sens":{"statut":"relu","glose":"malheur, calamité","acceptions":[{"categorie":"N","fr":"malheur, calamité"}]},"exemples":[],"origine":null},"秧":{"c":"秧","pinyin":"yāng","lectures":["yāng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["禾","央"],"sources":["cjk-decomp"]},"mots":["L7-4812"],"chemin":{"hsk":1384,"lire":1377},"sens":{"statut":"relu","glose":"plant, semis","acceptions":[{"categorie":"N","fr":"plant, semis, jeune pousse (riz)"}]},"exemples":[],"origine":null},"扬":{"c":"扬","pinyin":"yáng","lectures":["yáng"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["扌","𠃓"],"sources":["cjk-decomp"]},"mots":["L4-0045","L7-0797","L7-1029","L7-1030","L7-1112","L7-1661","L7-4709","L7-4813","L7-4963","L7-5201","L7-5250"],"chemin":{"hsk":592,"lire":585},"sens":{"statut":"relu","glose":"lever, élever ; répandre","acceptions":[{"categorie":"V","fr":"lever, soulever ; répandre, propager"}]},"exemples":[{"zh":"风扬起了沙子。","pinyin":"Fēng yáng qǐ le shāzi.","fr":"Le vent a soulevé du sable.","statut":"relu"}],"origine":null},"杨":{"c":"杨","pinyin":"yáng","lectures":["yáng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["木","𠃓"],"sources":["cjk-decomp"]},"mots":["L7-4815"],"chemin":{"hsk":1384,"lire":1377},"sens":{"statut":"relu","glose":"peuplier","acceptions":[{"categorie":"N","fr":"peuplier ; nom de famille"}]},"exemples":[],"origine":null},"洋":{"c":"洋","pinyin":"yáng","lectures":["yáng"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["氵","羊"],"sources":["cjk-decomp"]},"mots":["L6-0367","L6-0934","L7-0554","L7-4262","L7-4439","L7-4816"],"chemin":{"hsk":873,"lire":866},"sens":{"statut":"relu","glose":"océan ; étranger, occidental","acceptions":[{"categorie":"N","fr":"océan"},{"categorie":"Adj","fr":"étranger, occidental ; moderne"}]},"exemples":[{"zh":"他穿得很洋。","pinyin":"Tā chuān de hěn yáng.","fr":"Il s'habille à l'occidentale.","statut":"relu"}],"origine":null},"羊":{"c":"羊","pinyin":"yáng","lectures":["yáng"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L3-0831","L7-4263"],"chemin":{"hsk":113,"lire":110},"sens":{"statut":"relu","glose":"mouton, chèvre","acceptions":[{"categorie":"N","fr":"mouton, chèvre"}]},"exemples":[{"zh":"他家有很多羊。","pinyin":"Tā jiā yǒu hěn duō yáng.","fr":"Sa famille élève beaucoup de moutons.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 羊 dessine une tête de mouton vue de face, avec deux cornes recourbées vers le bas. Le Shuowen jiezi le glose par 祥, « de bon augure », et y lit la tête, les cornes, les pattes et la queue. On le retrouve en haut de 美, que le Shuowen jiezi explique par la saveur du mouton, et à droite de 样, dont il donne le son.","en":"On oracle bones, 羊 draws a sheep's head seen from the front, with two horns curling down. The Shuowen jiezi glosses it as 祥, “auspicious”, and reads in it the head, horns, legs and tail. It turns up at the top of 美, which the Shuowen jiezi explains by the good taste of mutton, and on the right of 样, which takes its sound from it.","roles":{}}},"阳":{"c":"阳","pinyin":"yáng","lectures":["yáng"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["阝","日"],"sources":["cjk-decomp"]},"mots":["L2-0518","L3-0832","L4-0855","L6-0783","L7-3538","L7-4814"],"chemin":{"hsk":324,"lire":321},"sens":{"statut":"relu","glose":"soleil ; yang","acceptions":[{"categorie":"N","fr":"soleil ; principe yang"}]},"exemples":[],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi écrit 陽 et le glose « haut et lumineux » : 阝, le talus, et 昜 pour le son. Le versant exposé au soleil : la lumière, le yang. La forme simplifiée remplace 昜 par 日, le soleil.","en":"The Shuowen jiezi writes 陽 and glosses it as “high and bright”: 阝, the slope, and 昜 for the sound. The side of the hill facing the sun: light, yang. The simplified form replaces 昜 with 日, the sun.","roles":{"阝":"sens","日":"sens"}}},"仰":{"c":"仰","pinyin":"yǎng","lectures":["yǎng"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["亻","卬"],"sources":["cjk-decomp"]},"mots":["L6-0907","L6-0935","L7-2247","L7-3264","L7-5236"],"chemin":{"hsk":874,"lire":867},"sens":{"statut":"relu","glose":"lever la tête ; admirer","acceptions":[{"categorie":"V","fr":"lever la tête ; être sur le dos"},{"categorie":"V","fr":"admirer, respecter"}]},"exemples":[{"zh":"他仰着头看天上的星星。","pinyin":"Tā yǎng zhe tóu kàn tiān shang de xīngxing.","fr":"Il regarde les étoiles, la tête levée.","statut":"relu"}],"origine":null},"养":{"c":"养","pinyin":"yǎng","lectures":["yǎng"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["羊","八","丨","丨"],"sources":["cjk-decomp","surcharge"]},"mots":["L2-0636","L3-0848","L4-0480","L4-0553","L4-0856","L5-0014","L5-0859","L6-0750","L6-0936","L7-1196","L7-1197","L7-2081","L7-2672","L7-3554","L7-3927","L7-3951","L7-4319","L7-4671","L7-4817","L7-4818","L7-4819","L7-4820","L7-4821"],"chemin":{"hsk":324,"lire":321},"sens":{"statut":"relu","glose":"élever ; nourrir, entretenir","acceptions":[{"categorie":"V","fr":"élever des animaux, nourrir"},{"categorie":"V","fr":"entretenir, faire vivre ; se soigner"}]},"exemples":[{"zh":"我家养了一只狗。","pinyin":"Wǒ jiā yǎng le yī zhī gǒu.","fr":"Nous avons un chien.","statut":"relu"},{"zh":"他要养一家人。","pinyin":"Tā yào yǎng yī jiā rén.","fr":"Il doit faire vivre toute une famille.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi écrit 養 et le glose « nourrir » : 食, la nourriture, et 羊 pour le son. La forme simplifiée garde le haut de 羊 et réduit 食 à deux traits. 羊 se lit yáng, la même syllabe que 养, yǎng.","en":"The Shuowen jiezi writes 養 and glosses it as “to feed”: 食, food, and 羊 for the sound. The simplified form keeps the top of 羊 and reduces 食 to two strokes. 羊 is read yáng, the same syllable as 养, yǎng.","roles":{}}}}}
