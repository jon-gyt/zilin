N","fr":"trame (d'un tissu)"},{"categorie":"N","fr":"latitude"}]},"exemples":[],"origine":null},"萎":{"c":"萎","pinyin":"wěi","lectures":["wěi","wēi"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["卄","禾","女"],"sources":["cjk-decomp"]},"mots":["L7-4307"],"chemin":{"hsk":1325,"lire":1318},"sens":{"statut":"relu","glose":"se faner, se flétrir","acceptions":[{"categorie":"V","fr":"se faner, se flétrir ; décliner"}]},"exemples":[],"origine":null},"为":{"c":"为","pinyin":"wèi","lectures":["wèi","wéi"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L2-0065","L2-0465","L2-0570","L2-0571","L2-0625","L2-0657","L2-0667","L3-0043","L3-0088","L3-0751","L3-0752","L3-0757","L4-0241","L4-0486","L4-0999","L5-0694","L5-0781","L5-0782","L5-0783","L5-0784","L6-0859","L6-0860","L7-0292","L7-0297","L7-0721","L7-0896","L7-1241","L7-1728","L7-1883","L7-2009","L7-2971","L7-3223","L7-3442","L7-3976","L7-4291","L7-4375","L7-4381","L7-4525","L7-5055","L7-5570"],"chemin":{"hsk":252,"lire":82},"sens":{"statut":"relu","glose":"pour, faire, être","acceptions":[]},"exemples":[{"zh":"我为你高兴。","pinyin":"Wǒ wèi nǐ gāoxìng.","fr":"Je suis content pour toi.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 为 montre une main qui conduit un éléphant, pour le faire travailler. De là vient le sens de « faire, agir », puis ceux de « être, devenir » et, lu wèi, « pour ». La forme simplifiée 为 abrège en quatre traits la cursive de l'ancien 爲.","en":"On oracle bones, 为 shows a hand leading an elephant, putting it to work. From there came the sense of doing and acting, then of being or becoming, and, read wèi, of “for”. The simplified 为 condenses the cursive form of the old 爲 into four strokes.","roles":{}}},"位":{"c":"位","pinyin":"wèi","lectures":["wèi"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["亻","立"],"sources":["cjk-decomp"]},"mots":["L2-0103","L2-0572","L2-0769","L3-0234","L4-0183","L4-0757","L4-0758","L5-0069","L5-0864","L5-1009","L6-0227","L6-0304","L6-1093","L7-0420","L7-0598","L7-0672","L7-0781","L7-1762","L7-1951","L7-3132","L7-3396","L7-4111","L7-4314","L7-4427","L7-4726"],"chemin":{"hsk":314,"lire":313},"sens":{"statut":"relu","glose":"classif. poli des personnes ; place","acceptions":[{"categorie":"M","fr":"classificateur poli des personnes"},{"categorie":"N","fr":"place, position"}]},"exemples":[{"zh":"你们几位？","pinyin":"Nǐmen jǐ wèi?","fr":"Vous êtes combien ?","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi glose 位 par « les places à gauche et à droite dans la cour du palais » : 人 et 立. Une personne debout à sa place : la position, le rang. Par politesse, 位 compte aussi les personnes.","en":"The Shuowen jiezi glosses 位 as “the places left and right in the palace courtyard”: 人 and 立. A person standing in their place: position, rank. Out of politeness, 位 also counts people.","roles":{"亻":"sens","立":"sens"}}},"卫":{"c":"卫","pinyin":"wèi","lectures":["wèi"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L3-0755","L3-0756","L5-0013","L5-0791","L7-1074","L7-1573","L7-4308","L7-5566"],"chemin":{"hsk":363,"lire":359},"sens":{"statut":"relu","glose":"garder, défendre","acceptions":[{"categorie":"V","fr":"garder, défendre, protéger"}]},"exemples":[],"origine":null},"味":{"c":"味","pinyin":"wèi","lectures":["wèi"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["口","未"],"sources":["cjk-decomp"]},"mots":["L2-0573","L4-0759","L5-0902","L7-1163","L7-1797","L7-2148","L7-2433","L7-2713","L7-2827","L7-2961","L7-3219","L7-3388","L7-4315","L7-4530","L7-4891","L7-5142","L7-5177","L7-5548"],"chemin":{"hsk":314,"lire":313},"sens":{"statut":"relu","glose":"goût, saveur ; odeur","acceptions":[{"categorie":"N","fr":"goût, saveur ; odeur"}]},"exemples":[],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi glose 味 par « saveur » : la bouche, 口, et 未 pour le son. 未 se lit wèi, exactement comme 味. Ce que la bouche reconnaît : le goût.","en":"The Shuowen jiezi glosses 味 as “flavour”: the mouth, 口, and 未 for the sound. 未 is read wèi, exactly like 味. What the mouth recognises: taste.","roles":{"口":"sens","未":"son"}}},"喂":{"c":"喂","pinyin":"wèi","lectures":["wèi"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["口","田","𰀠"],"sources":["cjk-decomp","surcharge"]},"mots":["L2-0574","L4-0760","L7-4319"],"chemin":{"hsk":315,"lire":340},"sens":{"statut":"relu","glose":"allô ; nourrir","acceptions":[{"categorie":"Intj","fr":"allô ; hé !"},{"categorie":"V","fr":"nourrir, donner à manger"}]},"exemples":[{"zh":"喂，你好！","pinyin":"Wèi, nǐ hǎo!","fr":"Allô, bonjour !","statut":"relu"},{"zh":"我去喂猫。","pinyin":"Wǒ qù wèi māo.","fr":"Je vais donner à manger au chat.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"mnemotechnique","fr":"Pour s'en souvenir : à gauche, 口, la bouche. À droite, 畏, « craindre », écrit 田 sur 𰀠, qui se lit wèi, exactement comme 喂. Une bouche au son de 畏 : l'appel « allô », et donner la becquée.","en":"As a memory aid: on the left, 口, the mouth. On the right, 畏, “to fear”, written 田 over 𰀠, read wèi, exactly like 喂. A mouth with the sound of 畏: the call “hello”, and feeding someone.","roles":{"口":"sens","田":"son","𰀠":"son"}}},"慰":{"c":"慰","pinyin":"wèi","lectures":["wèi"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["尸","示","寸","心"],"sources":["cjk-decomp"]},"mots":["L5-0001","L5-0793","L7-4320","L7-4619"],"chemin":{"hsk":725,"lire":718},"sens":{"statut":"relu","glose":"consoler, réconforter","acceptions":[{"categorie":"V","fr":"consoler, réconforter, apaiser"}]},"exemples":[{"zh":"他去医院慰问病人。","pinyin":"Tā qù yīyuàn wèiwèn bìngrén.","fr":"Il est allé à l'hôpital réconforter les malades.","statut":"relu"}],"origine":null},"未":{"c":"未","pinyin":"wèi","lectures":["wèi"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L4-0755","L4-0756","L7-0642","L7-3258","L7-3583","L7-4309","L7-4310","L7-4311","L7-4312","L7-4313"],"chemin":{"hsk":202,"lire":219},"sens":{"statut":"relu","glose":"pas encore ; ne pas (écrit)","acceptions":[{"categorie":"Adv","fr":"pas encore ; ne pas : langue écrite"}]},"exemples":[{"zh":"他至今未回信。","pinyin":"Tā zhìjīn wèi huí xìn.","fr":"Il n'a toujours pas répondu à ma lettre.","statut":"relu"}],"origine":null},"畏":{"c":"畏","pinyin":"wèi","lectures":["wèi"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["田","𰀠"],"sources":["surcharge"]},"mots":["L7-4316","L7-4317"],"chemin":{"hsk":1326,"lire":1319},"sens":{"statut":"relu","glose":"craindre, redouter","acceptions":[{"categorie":"V","fr":"craindre, redouter ; révérer"}]},"exemples":[],"origine":null},"胃":{"c":"胃","pinyin":"wèi","lectures":["wèi"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["田","月"],"sources":["cjk-decomp"]},"mots":["L5-0792","L7-4318"],"chemin":{"hsk":724,"lire":717},"sens":{"statut":"relu","glose":"estomac","acceptions":[{"categorie":"N","fr":"estomac"}]},"exemples":[{"zh":"我胃不舒服，不想吃饭。","pinyin":"Wǒ wèi bù shūfu, bù xiǎng chī fàn.","fr":"J'ai mal à l'estomac, je n'ai pas envie de manger.","statut":"relu"}],"origine":null},"谓":{"c":"谓","pinyin":"wèi","lectures":["wèi"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["讠","田","月"],"sources":["cjk-decomp"]},"mots":["L4-0769","L7-2388","L7-3975"],"chemin":{"hsk":580,"lire":573},"sens":{"statut":"relu","glose":"dire, appeler","acceptions":[{"categorie":"V","fr":"dire, appeler, nommer"}]},"exemples":[],"origine":null},"魏":{"c":"魏","pinyin":"wèi","lectures":["wèi"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["禾","女","鬼"],"sources":["cjk-decomp"]},"mots":[],"chemin":{"hsk":1326,"lire":1319},"sens":{"statut":"relu","glose":"Wei (royaume) ; nom de famille","acceptions":[{"categorie":"N","fr":"Wei (royaume ancien)"},{"categorie":"N","fr":"nom de famille"}]},"exemples":[],"origine":null},"温":{"c":"温","pinyin":"wēn","lectures":["wēn"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["氵","日","皿"],"sources":["cjk-decomp"]},"mots":["L2-0432","L2-0575","L3-0758","L4-0394","L5-0267","L5-0794","L6-0211","L7-0396","L7-3646","L7-3865","L7-4063","L7-4321","L7-4322","L7-4323","L7-4324","L7-4325","L7-4326"],"chemin":{"hsk":315,"lire":314},"sens":{"statut":"relu","glose":"tiède ; température","acceptions":[{"categorie":"Adj","fr":"tiède, doux"},{"categorie":"N","fr":"température"}]},"exemples":[],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi en fait un nom de rivière : l'eau, 氵, et 昷 pour le son. 昷, écrit 日 sur 皿, se lit wēn, exactement comme 温. Le sens « tiède, doux » s'est imposé ; l'eau reste à gauche.","en":"The Shuowen jiezi makes it the name of a river: water, 氵, and 昷 for the sound. 昷, written 日 over 皿, is read wēn, exactly like 温. The meaning “warm, mild” took over; the water stays on the left.","roles":{"氵":"sens","日":"son","皿":"son"}}},"瘟":{"c":"瘟","pinyin":"wēn","lectures":["wēn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["疒","日","皿"],"sources":["cjk-decomp"]},"mots":["L7-4327"],"chemin":{"hsk":1327,"lire":1320},"sens":{"statut":"relu","glose":"épidémie, peste","acceptions":[{"categorie":"N","fr":"épidémie, maladie contagieuse, peste"}]},"exemples":[],"origine":null},"文":{"c":"文","pinyin":"wén","lectures":["wén"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0201","L1-0479","L2-0676","L2-0765","L3-0743","L3-0759","L3-0760","L3-0761","L3-0762","L3-0763","L3-0764","L4-0499","L5-0638","L5-0762","L5-0795","L6-0861","L7-3400","L7-3443","L7-4328","L7-4329","L7-4330","L7-4331","L7-4332","L7-4333","L7-4334","L7-4335","L7-4336"],"chemin":{"hsk":36,"lire":36},"sens":{"statut":"relu","glose":"écrit, langue, culture","acceptions":[]},"exemples":[{"zh":"他会说中文。","pinyin":"Tā huì shuō Zhōngwén.","fr":"Il parle chinois.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires et les bronzes, 文 montre un homme vu de face, la poitrine souvent marquée d'un motif, que l'on lit comme un tatouage. Le Shuowen jiezi le définit par des traits qui se croisent. Du motif tracé sur le corps, le sens est passé aux signes écrits, puis à la langue et à la culture.","en":"On oracle bones and bronzes, 文 shows a man seen from the front, his chest often marked with a pattern, read as a tattoo. The Shuowen jiezi defines it as crossing lines. From a pattern drawn on the body, the meaning moved to written signs, then to language and culture.","roles":{}}},"纹":{"c":"纹","pinyin":"wén","lectures":["wén","wèn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["纟","文"],"sources":["cjk-decomp"]},"mots":["L7-1713"],"chemin":{"hsk":1327,"lire":1320},"sens":{"statut":"relu","glose":"veine, motif, ride","acceptions":[{"categorie":"N","fr":"veine, rayure, motif ; ride"}]},"exemples":[{"zh":"老人的脸上有很多皱纹。","pinyin":"Lǎorén de liǎn shang yǒu hěn duō zhòuwén.","fr":"Le vieil homme a le visage creusé de rides.","statut":"relu"}],"origine":null},"蚊":{"c":"蚊","pinyin":"wén","lectures":["wén"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["虫","文"],"sources":["cjk-decomp"]},"mots":["L7-4338","L7-4339"],"chemin":{"hsk":1328,"lire":1321},"sens":{"statut":"relu","glose":"moustique","acceptions":[{"categorie":"N","fr":"moustique"}]},"exemples":[],"origine":null},"闻":{"c":"闻","pinyin":"wén","lectures":["wén"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["门","耳"],"sources":["cjk-decomp"]},"mots":["L2-0576","L2-0616","L7-0528","L7-0591","L7-1010","L7-1099","L7-1406","L7-1558","L7-2277","L7-2925","L7-4337","L7-5152"],"chemin":{"hsk":316,"lire":314},"sens":{"statut":"relu","glose":"sentir (une odeur) ; entendre","acceptions":[{"categorie":"V","fr":"sentir, flairer une odeur"},{"categorie":"V","fr":"entendre ; nouvelle"}]},"exemples":[{"zh":"你闻一下这个。","pinyin":"Nǐ wén yīxià zhège.","fr":"Sens un peu ça.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi glose 聞 par « entendre » : 耳, l'oreille, et 門 pour le son. Simplifié, 門 devient 门 ; il se lit mén et ne donne pas tout à fait le son de wén. Ce que l'oreille apprend : la nouvelle ; aujourd'hui, 闻 veut surtout dire « sentir une odeur ».","en":"The Shuowen jiezi glosses 聞 as “to hear”: 耳, the ear, and 門 for the sound. Simplified, 門 becomes 门; it is read mén and does not quite give the sound of wén. What the ear learns: news; today 闻 mostly means “to smell”.","roles":{"门":"forme","耳":"sens"}}},"吻":{"c":"吻","pinyin":"wěn","lectures":["wěn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["口","勿"],"sources":["cjk-decomp"]},"mots":["L7-4340","L7-4341"],"chemin":{"hsk":1328,"lire":1321},"sens":{"statut":"relu","glose":"embrasser ; baiser","acceptions":[{"categorie":"V","fr":"embrasser, donner un baiser"},{"categorie":"N","fr":"baiser"}]},"exemples":[{"zh":"妈妈吻了一下孩子的脸。","pinyin":"Māma wěn le yīxià háizi de liǎn.","fr":"La maman a posé un baiser sur la joue de l'enfant.","statut":"relu"}],"origine":null},"稳":{"c":"稳","pinyin":"wěn","lectures":["wěn"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["禾","⺈","彐","心"],"sources":["cjk-decomp"]},"mots":["L4-0562","L4-0761","L4-0762","L7-0019","L7-0434","L7-4343","L7-4344","L7-4345","L7-4346"],"chemin":{"hsk":581,"lire":574},"sens":{"statut":"relu","glose":"stable, ferme, sûr","acceptions":[{"categorie":"Adj","fr":"stable, ferme, sûr"}]},"exemples":[{"zh":"桌子放稳了吗？","pinyin":"Zhuōzi fàng wěn le ma?","fr":"La table est-elle bien d'aplomb ?","statut":"relu"}],"origine":null},"紊":{"c":"紊","pinyin":"wěn","lectures":["wěn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["文","糸"],"sources":["cjk-decomp"]},"mots":["L7-4342"],"chemin":{"hsk":1329,"lire":1322},"sens":{"statut":"relu","glose":"embrouillé, en désordre","acceptions":[{"categorie":"Adj","fr":"embrouillé, en désordre"}]},"exemples":[],"origine":null},"问":{"c":"问","pinyin":"wèn","lectures":["wèn"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["门","口"],"sources":["cjk-decomp"]},"mots":["L1-0299","L1-0379","L2-0577","L2-0578","L3-0191","L3-0701","L4-0763","L4-0834","L4-0875","L5-0294","L5-0793","L5-0867","L6-0263","L7-0269","L7-0453","L7-4347","L7-4348","L7-5391","L7-5521"],"chemin":{"hsk":7,"lire":9},"sens":{"statut":"relu","glose":"demander, interroger","acceptions":[]},"exemples":[{"zh":"你问他吧。","pinyin":"Nǐ wèn tā ba.","fr":"Demande-lui.","statut":"relu"},{"zh":"他问我几点了。","pinyin":"Tā wèn wǒ jǐ diǎn le.","fr":"Il m'a demandé l'heure.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"问 est un composé idéo-phonétique : 口, la bouche, donne le sens, et 门 donnait le son. C'est l'analyse du Shuowen jiezi, et la bouche y dit la parole qui interroge. Aujourd'hui, mén et wèn ont la même finale, et leur initiale, désormais différente, était autrefois la même.","en":"问 is a phono-semantic compound: 口, the mouth, gives the meaning, and 门 gave the sound. This is how the Shuowen jiezi analyses it, the mouth standing for speech that asks. Today mén and wèn share the same final, and their initials, now different, were once the same.","roles":{"门":"forme","口":"sens"}}},"翁":{"c":"翁","pinyin":"wēng","lectures":["wēng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["八","厶","习","习"],"sources":["cjk-decomp"]},"mots":["L7-1227"],"chemin":{"hsk":1329,"lire":1322},"sens":{"statut":"relu","glose":"vieil homme","acceptions":[{"categorie":"N","fr":"vieil homme"}]},"exemples":[],"origine":null},"涡":{"c":"涡","pinyin":"wō","lectures":["wō","guō"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["氵","口","内"],"sources":["cjk-decomp"]},"mots":["L7-4719"],"chemin":{"hsk":1330,"lire":1323},"sens":{"statut":"relu","glose":"tourbillon","acceptions":[{"categorie":"N","fr":"tourbillon, remous"}]},"exemples":[],"origine":null},"窝":{"c":"窝","pinyin":"wō","lectures":["wō"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["穴","口","内"],"sources":["cjk-decomp"]},"mots":["L7-4349"],"chemin":{"hsk":1330,"lire":1323},"sens":{"statut":"relu","glose":"nid, terrier ; repaire","acceptions":[{"categorie":"N","fr":"nid, gîte, terrier"},{"categorie":"N","fr":"repaire, planque"}]},"exemples":[{"zh":"树上有一个鸟窝。","pinyin":"Shù shang yǒu yī ge niǎowō.","fr":"Il y a un nid d'oiseau dans l'arbre.","statut":"relu"}],"origine":null},"我":{"c":"我","pinyin":"wǒ","lectures":["wǒ"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0380","L1-0381","L6-1113"],"chemin":{"hsk":56,"lire":56},"sens":{"statut":"relu","glose":"je, moi","acceptions":[]},"exemples":[{"zh":"我也去。","pinyin":"Wǒ yě qù.","fr":"J'y vais aussi.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 我 dessine une arme à long manche dont la lame porte des dents. Le mot « je, moi » se prononçait de façon proche et a emprunté ce caractère : l'arme n'a aucun lien de sens avec le pronom. Dans la forme actuelle, on reconnaît à droite 戈, la hallebarde ; la partie gauche ressemble à 扌, la main.","en":"On oracle bones, 我 draws a long-handled weapon with a toothed blade. The word for “I, me” sounded close to it and borrowed the character, so the weapon has no link in meaning with the pronoun. In the current form you can spot 戈, the dagger-axe, on the right; the left part looks like 扌, the hand.","roles":{}}},"卧":{"c":"卧","pinyin":"wò","lectures":["wò"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["臣","卜"],"sources":["cjk-decomp"]},"mots":["L5-0796","L6-0862","L7-4350"],"chemin":{"hsk":725,"lire":718},"sens":{"statut":"relu","glose":"être couché, s'allonger","acceptions":[{"categorie":"V","fr":"être couché, s'allonger"},{"categorie":"Adj","fr":"pour dormir (couchette, chambre)"}]},"exemples":[{"zh":"小猫卧在沙发上睡觉。","pinyin":"Xiǎo māo wò zài shāfā shang shuìjiào.","fr":"Le chaton dort couché sur le canapé.","statut":"relu"}],"origine":null},"握":{"c":"握","pinyin":"wò","lectures":["wò"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["扌","尸","至"],"sources":["cjk-decomp"]},"mots":["L3-0008","L3-0765","L5-0797","L5-0978"],"chemin":{"hsk":443,"lire":437},"sens":{"statut":"relu","glose":"serrer, tenir dans la main","acceptions":[{"categorie":"V","fr":"serrer, tenir dans la main"}]},"exemples":[{"zh":"他握着我的手。","pinyin":"Tā wò zhe wǒ de shǒu.","fr":"Il me tenait la main.","statut":"relu"}],"origine":null},"沃":{"c":"沃","pinyin":"wò","lectures":["wò"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["氵","夭"],"sources":["cjk-decomp"]},"mots":["L7-1102"],"chemin":{"hsk":1331,"lire":1324},"sens":{"statut":"relu","glose":"fertile ; irriguer","acceptions":[{"categorie":"Adj","fr":"fertile"},{"categorie":"V","fr":"irriguer"}]},"exemples":[],"origine":null},"乌":{"c":"乌","pinyin":"wū","lectures":["wū","wù"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L6-0863"],"chemin":{"hsk":756,"lire":749},"sens":{"statut":"relu","glose":"noir, sombre ; corbeau","acceptions":[{"categorie":"Adj","fr":"noir, sombre"},{"categorie":"N","fr":"corbeau"}]},"exemples":[],"origine":null},"呜":{"c":"呜","pinyin":"wū","lectures":["wū"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["口","乌"],"sources":["cjk-decomp"]},"mots":["L7-4353"],"chemin":{"hsk":1332,"lire":1325},"sens":{"statut":"relu","glose":"ouh (sanglot, sirène, vent)","acceptions":[{"categorie":"Phonetic","fr":"ouh, bruit d'un sanglot, d'une sirène, du vent"}]},"exemples":[],"origine":null},"屋":{"c":"屋","pinyin":"wū","lectures":["wū"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["尸","至"],"sources":["cjk-decomp"]},"mots":["L3-0189","L3-0766","L5-0800","L7-4354"],"chemin":{"hsk":444,"lire":437},"sens":{"statut":"relu","glose":"maison ; pièce, chambre","acceptions":[{"categorie":"N","fr":"maison ; pièce, chambre"}]},"exemples":[{"zh":"外面冷，快进屋吧。","pinyin":"Wàimian lěng, kuài jìn wū ba.","fr":"Il fait froid dehors, rentre vite.","statut":"relu"}],"origine":null},"巫":{"c":"巫","pinyin":"wū","lectures":["wū"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["工","人","人"],"sources":["cjk-decomp"]},"mots":["L7-4352"],"chemin":{"hsk":1331,"lire":1324},"sens":{"statut":"relu","glose":"sorcier, chaman","acceptions":[{"categorie":"N","fr":"sorcier, chaman"}]},"exemples":[],"origine":null},"污":{"c":"污","pinyin":"wū","lectures":["wū"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["氵","一","丂"],"sources":["cjk-decomp","surcharge"]},"mots":["L5-0798","L5-0799","L7-3994","L7-4351"],"chemin":{"hsk":726,"lire":719},"sens":{"statut":"relu","glose":"sale, souillé ; souiller","acceptions":[{"categorie":"Adj","fr":"sale, souillé"},{"categorie":"V","fr":"souiller, salir"},{"categorie":"N","fr":"saleté"}]},"exemples":[{"zh":"他因为贪污被抓了。","pinyin":"Tā yīnwèi tānwū bèi zhuā le.","fr":"Il a été arrêté pour corruption.","statut":"relu"}],"origine":null},"吴":{"c":"吴","pinyin":"wú","lectures":["wú"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["口","天"],"sources":["cjk-decomp"]},"mots":[],"chemin":{"hsk":1332,"lire":1325},"sens":{"statut":"relu","glose":"Wu (royaume) ; nom de famille","acceptions":[{"categorie":"N","fr":"Wu (royaume ancien, région de Suzhou)"},{"categorie":"N","fr":"nom de famille"}]},"exemples":[],"origine":null},"无":{"c":"无","pinyin":"wú","lectures":["wú","mó"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L4-0764","L4-0765","L4-0766","L4-0767","L4-0768","L4-0769","L4-0770","L5-0801","L5-0802","L6-0864","L6-0865","L6-0866","L7-0698","L7-0763","L7-0944","L7-1585","L7-2278","L7-2554","L7-2630","L7-2925","L7-2941","L7-3260","L7-3718","L7-4261","L7-4355","L7-4356","L7-4357","L7-4358","L7-4359","L7-4360","L7-4361","L7-4362","L7-4363","L7-4364","L7-4365","L7-4366","L7-4367","L7-4368","L7-4369","L7-4370","L7-4371","L7-4372","L7-4373","L7-4374","L7-4375","L7-4376","L7-4377","L7-4378","L7-4379","L7-4380","L7-4381","L7-4382","L7-4383","L7-4384","L7-4385","L7-4386","L7-4387","L7-4388","L7-4389","L7-4390","L7-4391","L7-4392","L7-4393","L7-4757","L7-4889","L7-4943","L7-4944","L7-5073","L7-5182","L7-5597"],"chemin":{"hsk":483,"lire":476},"sens":{"statut":"relu","glose":"ne pas avoir, sans","acceptions":[{"categorie":"V","fr":"ne pas avoir, être sans"}]},"exemples":[{"zh":"我对此无话可说。","pinyin":"Wǒ duì cǐ wú huà kě shuō.","fr":"Je n'ai rien à dire là-dessus.","statut":"relu"}],"origine":null},"五":{"c":"五","pinyin":"wǔ","lectures":["wǔ"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0382","L4-0771","L7-3511","L7-4394","L7-4395"],"chemin":{"hsk":54,"lire":53},"sens":{"statut":"relu","glose":"cinq","acceptions":[]},"exemples":[{"zh":"这个五块钱。","pinyin":"Zhège wǔ kuài qián.","fr":"Ça fait cinq yuans.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 五 s'écrit d'une croix en X entre deux traits horizontaux. Le Shuowen jiezi y lit le ciel et la terre, entre lesquels le yin et le yang se croisent. Dans la forme actuelle, les deux traits horizontaux sont restés, et la croix est devenue un trait vertical et un trait coudé.","en":"On oracle bones, 五 is written as an X between two horizontal strokes. The Shuowen jiezi reads the strokes as heaven and earth, with yin and yang crossing between them. In the current form the two horizontal strokes remain, and the cross has become an upright stroke and a bent one.","roles":{}}},"伍":{"c":"伍","pinyin":"wǔ","lectures":["wǔ"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["亻","五"],"sources":["cjk-decomp"]},"mots":["L6-0238"],"chemin":{"hsk":863,"lire":856},"sens":{"statut":"relu","glose":"rangs, troupe ; cinq (en comptabilité)","acceptions":[{"categorie":"N","fr":"rangs, troupe"},{"categorie":"Num","fr":"cinq : graphie des montants"}]},"exemples":[],"origine":null}}}
