2009","parts":["非","心"],"sources":["cjk-decomp"]},"mots":["L5-0019","L5-0020","L6-0025","L7-0127","L7-0128","L7-0129","L7-0130","L7-2380"],"chemin":{},"sens":{"statut":"relu","glose":"triste, affligé ; chagrin","acceptions":[{"categorie":"Adj","fr":"triste, affligé"},{"categorie":"N","fr":"chagrin, tristesse"}]},"exemples":[{"zh":"他对生活很悲观。","pinyin":"Tā duì shēnghuó hěn bēiguān.","fr":"Il voit la vie en noir.","statut":"relu"}],"origine":null},"杯":{"c":"杯","pinyin":"bēi","lectures":["bēi"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["木","不"],"sources":["cjk-decomp"]},"mots":["L1-0017","L1-0018","L2-0175","L3-0654","L7-2033"],"chemin":{"hsk":90,"lire":90},"sens":{"statut":"relu","glose":"tasse, verre","acceptions":[]},"exemples":[{"zh":"请给我一杯水。","pinyin":"Qǐng gěi wǒ yī bēi shuǐ.","fr":"Un verre d'eau, s'il vous plaît.","statut":"relu"},{"zh":"他喝了两杯茶。","pinyin":"Tā hē le liǎng bēi chá.","fr":"Il a bu deux tasses de thé.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"杯 est un composé idéo-phonétique : 木, le bois, donne le sens, et 不 donnait autrefois le son : bù ne partage plus avec bēi que l'initiale. La clé rappelle les coupes en bois, souvent laquées, courantes dans la Chine ancienne. Le Shuowen jiezi enregistre la forme 桮, où 否 tient la place de 不.","en":"杯 is a phono-semantic compound: 木, wood, gives the meaning, and 不 once gave the sound: bù now shares only the initial of bēi. The wood radical recalls the wooden cups, often lacquered, that were common in ancient China. The Shuowen jiezi records it as 桮, with 否 in place of 不.","roles":{"木":"sens","不":"forme"}}},"碑":{"c":"碑","pinyin":"bēi","lectures":["bēi"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["石","卑"],"sources":["cjk-decomp"]},"mots":["L7-0131","L7-1911","L7-2422","L7-2568","L7-2946"],"chemin":{},"sens":{"statut":"relu","glose":"stèle","acceptions":[{"categorie":"N","fr":"stèle, monument commémoratif"}]},"exemples":[{"zh":"山下立着一块石碑。","pinyin":"Shān xià lì zhe yī kuài shíbēi.","fr":"Au pied de la montagne se dresse une pierre gravée.","statut":"relu"}],"origine":null},"北":{"c":"北","pinyin":"běi","lectures":["běi"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["匕","匕"],"sources":["cjk-decomp"]},"mots":["L1-0019","L1-0020","L1-0021","L2-0016","L2-0130","L2-0581","L3-0029","L5-0021","L5-0520"],"chemin":{"hsk":103,"lire":98},"sens":{"statut":"relu","glose":"nord","acceptions":[]},"exemples":[{"zh":"北京在中国的北边。","pinyin":"Běijīng zài Zhōngguó de běibian.","fr":"Pékin est dans le nord de la Chine.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 北 montre deux hommes dos à dos. Le Shuowen jiezi le glose par « se tourner le dos », sens repris plus tard par 背, « le dos », qui ajoute 月 sous 北. Le sens de « nord » est venu par emprunt, et les deux hommes sont devenus dans l'écriture actuelle deux formes proches de 匕.","en":"On oracle bones, 北 shows two men standing back to back. The Shuowen jiezi glosses it as “to turn one's back”, a sense later taken over by 背, “back”, which adds 月 under 北. The meaning “north” came by borrowing, and in today's script the two men have become two shapes close to 匕.","roles":{}}},"倍":{"c":"倍","pinyin":"bèi","lectures":["bèi"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["亻","立","口"],"sources":["cjk-decomp"]},"mots":["L4-0032"],"chemin":{},"sens":{"statut":"relu","glose":"fois (multiplication)","acceptions":[{"categorie":"M","fr":"fois : pour multiplier une quantité"}]},"exemples":[{"zh":"他的钱是我的两倍。","pinyin":"Tā de qián shì wǒ de liǎng bèi.","fr":"Il a deux fois plus d'argent que moi.","statut":"relu"}],"origine":null},"备":{"c":"备","pinyin":"bèi","lectures":["bèi"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["夂","田"],"sources":["cjk-decomp"]},"mots":["L1-0486","L3-0619","L4-0424","L5-0544","L5-0933","L6-1107","L7-0133","L7-0134","L7-0135","L7-0521","L7-0569","L7-1675","L7-1676","L7-2134","L7-4243","L7-5218"],"chemin":{"hsk":110},"sens":{"statut":"relu","glose":"préparer, se munir de","acceptions":[{"categorie":"V","fr":"préparer, se munir de"}]},"exemples":[],"origine":null},"惫":{"c":"惫","pinyin":"bèi","lectures":["bèi"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["夂","田","心"],"sources":["cjk-decomp"]},"mots":["L7-3099","L7-3100"],"chemin":{},"sens":{"statut":"relu","glose":"épuisé","acceptions":[{"categorie":"Adj","fr":"épuisé, exténué"}]},"exemples":[],"origine":null},"狈":{"c":"狈","pinyin":"bèi","lectures":["bèi"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["犭","贝"],"sources":["cjk-decomp"]},"mots":["L7-2521"],"chemin":{},"sens":{"statut":"relu","glose":"animal légendaire (en composé)","acceptions":[{"categorie":"N","fr":"animal légendaire, compagnon du loup (en composé)"}]},"exemples":[{"zh":"他们俩狼狈为奸。","pinyin":"Tāmen liǎ lángbèi-wéijiān.","fr":"Ces deux-là sont de mèche pour faire le mal.","statut":"relu"}],"origine":null},"背":{"c":"背","pinyin":"bèi","lectures":["bèi","bēi"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["匕","匕","月"],"sources":["cjk-decomp"]},"mots":["L2-0017","L3-0028","L3-0030","L3-0031","L4-0031","L5-0018","L6-0026","L6-0027","L7-0136","L7-0137","L7-0138","L7-4292"],"chemin":{},"sens":{"statut":"relu","glose":"réciter ; dos ; porter sur le dos","acceptions":[{"categorie":"V","fr":"réciter par cœur"},{"categorie":"N","fr":"dos"},{"categorie":"V","fr":"porter sur le dos","pinyin":"bēi"}]},"exemples":[{"zh":"你能背这个课文吗？","pinyin":"Nǐ néng bèi zhège kèwén ma?","fr":"Tu peux réciter ce texte ?","statut":"relu"},{"zh":"他背着一个大包。","pinyin":"Tā bēi zhe yī ge dà bāo.","fr":"Il porte un gros sac sur le dos.","statut":"relu"}],"origine":null},"被":{"c":"被","pinyin":"bèi","lectures":["bèi"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["衤","皮"],"sources":["cjk-decomp"]},"mots":["L3-0032","L3-0033","L4-0033","L5-0022","L6-0028","L7-0139"],"chemin":{},"sens":{"statut":"relu","glose":"par (passif) ; couverture","acceptions":[{"categorie":"Prep","fr":"par : marque le passif"},{"categorie":"N","fr":"couverture, couette"}]},"exemples":[{"zh":"我的钱包被人拿走了。","pinyin":"Wǒ de qiánbāo bèi rén ná zǒu le.","fr":"Quelqu'un a pris mon portefeuille.","statut":"relu"}],"origine":null},"贝":{"c":"贝","pinyin":"bèi","lectures":["bèi"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L4-0025","L7-0132"],"chemin":{"hsk":141,"lire":127},"sens":{"statut":"relu","glose":"coquillage, cauri","acceptions":[]},"exemples":[],"origine":{"statut":"relu","etiquette":"atteste","fr":"贝 est la forme simplifiée de 貝, le coquillage. Sur les os oraculaires, 貝 dessine un cauri, le coquillage ouvert en deux lèvres, et le Shuowen jiezi rappelle que les anciens s'en servaient comme monnaie. Il marque la richesse, l'achat et la vente, comme dans 贵, cher, ou 买, acheter.","en":"贝 is the simplified form of 貝, shell. On oracle bones, 貝 draws a cowrie, the shell opening in two lips, and the Shuowen jiezi recalls that the ancients used such shells as money. It marks wealth, buying and selling, as in 贵, expensive, or 买, to buy.","roles":{}}},"辈":{"c":"辈","pinyin":"bèi","lectures":["bèi"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["非","车"],"sources":["cjk-decomp"]},"mots":["L5-0023","L5-0888","L7-3253","L7-5251"],"chemin":{},"sens":{"statut":"relu","glose":"génération ; toute une vie","acceptions":[{"categorie":"N","fr":"génération (dans une famille, un métier)"},{"categorie":"N","fr":"vie, existence (dans « toute une vie »)"}]},"exemples":[{"zh":"我们家有四辈人住在一起。","pinyin":"Wǒmen jiā yǒu sì bèi rén zhù zài yīqǐ.","fr":"Chez nous, quatre générations vivent sous le même toit.","statut":"relu"}],"origine":null},"奔":{"c":"奔","pinyin":"bēn","lectures":["bēn","bèn"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["大","十","卄"],"sources":["cjk-decomp"]},"mots":["L6-0029","L7-0140","L7-0141","L7-0149","L7-0906","L7-1322","L7-4157","L7-5357"],"chemin":{},"sens":{"statut":"relu","glose":"courir, se précipiter ; se diriger vers","acceptions":[{"categorie":"V","fr":"courir, se précipiter"},{"categorie":"V","fr":"se diriger vers, aller droit à","pinyin":"bèn"}]},"exemples":[{"zh":"他一下车就奔医院去了。","pinyin":"Tā yī xià chē jiù bèn yīyuàn qù le.","fr":"À peine descendu de voiture, il a filé à l'hôpital.","statut":"relu"}],"origine":null},"本":{"c":"本","pinyin":"běn","lectures":["běn"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0022","L1-0023","L1-0200","L2-0022","L3-0034","L3-0035","L3-0036","L3-0237","L3-0314","L3-0315","L4-0034","L5-0024","L5-0103","L5-0422","L5-1053","L6-0030","L6-0031","L6-0032","L6-0033","L6-0034","L6-0035","L7-0142","L7-0143","L7-0144","L7-0145","L7-0146","L7-0147","L7-0148","L7-0203","L7-1860","L7-2481","L7-4824","L7-5137","L7-5543"],"chemin":{"hsk":78,"lire":76},"sens":{"statut":"relu","glose":"racine, origine, classificateur (livres)","acceptions":[]},"exemples":[{"zh":"我买了三本书。","pinyin":"Wǒ mǎi le sān běn shū.","fr":"J'ai acheté trois livres.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les bronzes, 本 est un arbre, 木, dont le pied porte une marque qui désigne les racines. Le Shuowen jiezi l'analyse de même, comme 木 avec un trait placé en bas. De la racine, le sens s'est étendu à l'origine d'une chose, puis au cahier et au livre, que 本 sert aussi à compter.","en":"On bronzes, 本 is a tree, 木, with a mark at its foot pointing to the roots. The Shuowen jiezi analyses it the same way, as 木 with a stroke placed low. From “root” the meaning spread to the origin of things, then to notebooks and books, which 本 is also used to count.","roles":{}}},"笨":{"c":"笨","pinyin":"bèn","lectures":["bèn"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["⺮","本"],"sources":["cjk-decomp"]},"mots":["L4-0035","L7-0150","L7-0151"],"chemin":{},"sens":{"statut":"relu","glose":"bête, lent ; maladroit","acceptions":[{"categorie":"Adj","fr":"bête, lent d'esprit"},{"categorie":"Adj","fr":"maladroit, gauche"}]},"exemples":[{"zh":"我太笨了，又说错了。","pinyin":"Wǒ tài bèn le, yòu shuō cuò le.","fr":"Que je suis bête, je me suis encore trompé.","statut":"relu"}],"origine":null},"崩":{"c":"崩","pinyin":"bēng","lectures":["bēng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["山","月","月"],"sources":["cjk-decomp"]},"mots":["L7-0152"],"chemin":{},"sens":{"statut":"relu","glose":"s'effondrer, s'écrouler","acceptions":[{"categorie":"V","fr":"s'effondrer, s'écrouler"}]},"exemples":[],"origine":null},"绷":{"c":"绷","pinyin":"bēng","lectures":["bēng","běng","bèng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["纟","月","月"],"sources":["cjk-decomp"]},"mots":["L7-0153","L7-0154"],"chemin":{},"sens":{"statut":"relu","glose":"tendre ; faire la tête","acceptions":[{"categorie":"V","fr":"tendre, être tendu"},{"categorie":"V","fr":"se crisper, faire la tête","pinyin":"běng"}]},"exemples":[{"zh":"把绳子绷紧。","pinyin":"Bǎ shéngzi bēng jǐn.","fr":"Tire bien sur la corde.","statut":"relu"},{"zh":"他绷着脸不说话。","pinyin":"Tā běng zhe liǎn bù shuōhuà.","fr":"Il fait la tête sans rien dire.","statut":"relu"}],"origine":null},"蹦":{"c":"蹦","pinyin":"bèng","lectures":["bèng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["口","止","山","月","月"],"sources":["cjk-decomp"]},"mots":["L7-0155"],"chemin":{},"sens":{"statut":"relu","glose":"sauter, bondir","acceptions":[{"categorie":"V","fr":"sauter, bondir"}]},"exemples":[{"zh":"孩子高兴得蹦了起来。","pinyin":"Háizi gāoxìng de bèng le qilai.","fr":"L'enfant a sauté de joie.","statut":"relu"}],"origine":null}}}
