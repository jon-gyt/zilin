"oie"}]},"exemples":[{"zh":"河边有几只白鹅。","pinyin":"Hé biān yǒu jǐ zhī bái é.","fr":"Il y a quelques oies blanches au bord de la rivière.","statut":"relu"}],"origine":null},"厄":{"c":"厄","pinyin":"è","lectures":["è"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["厂","㔾"],"sources":["cjk-decomp"]},"mots":["L7-0994"],"chemin":{},"sens":{"statut":"relu","glose":"malheur, adversité","acceptions":[{"categorie":"N","fr":"malheur, adversité"}]},"exemples":[],"origine":null},"恶":{"c":"恶","pinyin":"è","lectures":["è","ě","wù","wū"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["亚","心"],"sources":["cjk-decomp"]},"mots":["L4-0213","L6-1136","L7-0526","L7-0995","L7-0996","L7-0997","L7-0998","L7-0999","L7-2389","L7-4359","L7-4585","L7-4661"],"chemin":{},"sens":{"statut":"relu","glose":"méchant, mauvais ; détester","acceptions":[{"categorie":"Adj","fr":"méchant, mauvais, féroce"},{"categorie":"V","fr":"détester, avoir en horreur","pinyin":"wù"}]},"exemples":[{"zh":"这只狗很恶。","pinyin":"Zhè zhī gǒu hěn è.","fr":"Ce chien est agressif.","statut":"relu"}],"origine":null},"遏":{"c":"遏","pinyin":"è","lectures":["è"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["辶","日","勹","人","𠃊"],"sources":["cjk-decomp","surcharge"]},"mots":["L7-1000"],"chemin":{},"sens":{"statut":"relu","glose":"arrêter, contenir","acceptions":[{"categorie":"V","fr":"arrêter, contenir"}]},"exemples":[],"origine":null},"饿":{"c":"饿","pinyin":"è","lectures":["è"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["饣","我"],"sources":["cjk-decomp"]},"mots":["L1-0096","L7-1850","L7-3451"],"chemin":{"hsk":165},"sens":{"statut":"relu","glose":"avoir faim ; affamer","acceptions":[{"categorie":"Adj","fr":"qui a faim, affamé"},{"categorie":"V","fr":"laisser sans manger, affamer"}]},"exemples":[{"zh":"我饿了。","pinyin":"Wǒ è le.","fr":"J'ai faim.","statut":"relu"},{"zh":"你饿不饿？","pinyin":"Nǐ è bu è?","fr":"Tu as faim ?","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi écrit 餓 et le glose « avoir faim » : la nourriture, 食, et 我 pour le son. 我 se lisait alors d'une façon proche de 餓 ; aujourd'hui wǒ et è ne sonnent plus pareil. Simplifié, 食 devient 饣 à gauche ; c'est lui qui dit qu'on parle de manger.","en":"The Shuowen jiezi writes 餓 and glosses it as “hungry”: food, 食, and 我 for the sound. 我 was then pronounced close to 餓; today wǒ and è no longer sound alike. Simplified, 食 becomes 饣 on the left; it is what tells you this is about eating.","roles":{"饣":"sens","我":"forme"}}},"鳄":{"c":"鳄","pinyin":"è","lectures":["è"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["鱼","口","口","一","丂"],"sources":["cjk-decomp","surcharge"]},"mots":["L7-1001"],"chemin":{},"sens":{"statut":"relu","glose":"crocodile","acceptions":[{"categorie":"N","fr":"crocodile"}]},"exemples":[],"origine":null},"恩":{"c":"恩","pinyin":"ēn","lectures":["ēn"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["囗","大","心"],"sources":["cjk-decomp"]},"mots":["L6-0247","L7-1002","L7-1003","L7-1004","L7-1005","L7-1259"],"chemin":{},"sens":{"statut":"relu","glose":"bienfait, grâce","acceptions":[{"categorie":"N","fr":"bienfait, faveur ; affection"}]},"exemples":[],"origine":null},"儿":{"c":"儿","pinyin":"ér","lectures":["ér"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0097","L1-0142","L1-0235","L1-0244","L1-0252","L1-0257","L1-0262","L1-0277","L1-0278","L1-0371","L1-0402","L1-0432","L1-0433","L1-0434","L1-0437","L1-0467","L2-0044","L2-0180","L2-0236","L2-0330","L2-0388","L2-0611","L2-0649","L2-0684","L2-0686","L3-0423","L3-0432","L4-0214","L4-0505","L4-0522","L4-0526","L4-0759","L4-0897","L4-0900","L5-0087","L5-0162","L5-0221","L5-0274","L5-0326","L5-0840","L5-0893","L6-0194","L6-0248","L6-0332","L6-0545","L6-0719","L7-0226","L7-0367","L7-0680","L7-0716","L7-0928","L7-1321","L7-1825","L7-2532","L7-2561","L7-2811","L7-2954","L7-2979","L7-3447","L7-3985","L7-3993","L7-4248","L7-4506","L7-4614","L7-4884","L7-5010","L7-5289"],"chemin":{"hsk":10,"lire":15},"sens":{"statut":"relu","glose":"enfant, fils, suffixe -r","acceptions":[]},"exemples":[],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 兒, la forme traditionnelle de 儿, dessine un enfant à la tête large, le haut du crâne encore ouvert. Le Shuowen jiezi le définit comme un petit enfant dont la fontanelle ne s'est pas encore refermée. La forme simplifiée n'a gardé que le bas du dessin, les deux jambes.","en":"On oracle bones, 兒, the traditional form of 儿, draws a child with a large head, the top of the skull still open. The Shuowen jiezi defines it as a small child whose fontanelle has not yet closed. The simplified form keeps only the lower part of the drawing, the two legs.","roles":{}}},"而":{"c":"而","pinyin":"ér","lectures":["ér"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L2-0153","L4-0215","L4-0216","L4-0230","L4-0597","L5-0145","L5-0904","L6-0735","L7-0075","L7-0262","L7-0270","L7-0271","L7-0301","L7-1006","L7-1922","L7-2169","L7-2229","L7-2390","L7-3170","L7-3327","L7-3378","L7-3924","L7-4213","L7-4216","L7-4490","L7-4518","L7-4883","L7-4978","L7-5560","L7-5585"],"chemin":{},"sens":{"statut":"relu","glose":"et ; mais, tandis que","acceptions":[{"categorie":"Conj","fr":"et ; mais, tandis que"}]},"exemples":[{"zh":"这个菜好吃而不贵。","pinyin":"Zhège cài hǎochī ér bù guì.","fr":"Ce plat est bon, et pas cher.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi glose 而 par « poils des joues » : le caractère dessine une barbe qui pend. Le trait du haut est le menton, les traits du bas, les poils. Le sens de mot de liaison, « et, mais », vient d'un emprunt.","en":"The Shuowen jiezi glosses 而 as “cheek hair”: the character draws a hanging beard. The top stroke is the chin, the strokes below are the hairs. Its use as a linking word, “and, but”, comes from a borrowing.","roles":{}}},"尔":{"c":"尔","pinyin":"ěr","lectures":["ěr"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["⺈","小"],"sources":["cjk-decomp"]},"mots":["L5-0535","L7-1281"],"chemin":{},"sens":{"statut":"relu","glose":"tu, ton (langue ancienne)","acceptions":[{"categorie":"Pron","fr":"tu, ton (langue ancienne)"},{"categorie":"Suffix","fr":"suffixe d'adverbe, dans ǒu'ěr"}]},"exemples":[{"zh":"他喜欢打高尔夫球。","pinyin":"Tā xǐhuan dǎ gāo'ěrfūqiú.","fr":"Il aime jouer au golf.","statut":"relu"}],"origine":null},"耳":{"c":"耳","pinyin":"ěr","lectures":["ěr"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L4-0217","L5-0222","L7-0629","L7-1007","L7-1008","L7-1009","L7-1010","L7-2049","L7-2874","L7-5165"],"chemin":{"hsk":151},"sens":{"statut":"relu","glose":"oreille","acceptions":[{"categorie":"N","fr":"oreille"}]},"exemples":[],"origine":null},"饵":{"c":"饵","pinyin":"ěr","lectures":["ěr"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["饣","耳"],"sources":["cjk-decomp"]},"mots":["L7-5087"],"chemin":{},"sens":{"statut":"relu","glose":"appât","acceptions":[{"categorie":"N","fr":"appât, amorce"}]},"exemples":[],"origine":null},"二":{"c":"二","pinyin":"èr","lectures":["èr"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0098","L4-0218","L5-0223","L7-0944","L7-1011","L7-1012","L7-2090","L7-4921"],"chemin":{"hsk":11,"lire":19},"sens":{"statut":"relu","glose":"deux","acceptions":[]},"exemples":[{"zh":"我住在二楼。","pinyin":"Wǒ zhù zài èr lóu.","fr":"J'habite au premier étage.","statut":"relu"},{"zh":"二月很冷。","pinyin":"Èryuè hěn lěng.","fr":"Il fait froid en février.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 二 est fait de deux traits horizontaux de même longueur, comme 一 en a un et 三 trois. Dans l'écriture actuelle, le trait du haut est devenu plus court que celui du bas. 二 sert pour compter et dans les nombres ; devant un classificateur, on emploie en général 两.","en":"On oracle bones, 二 is made of two horizontal strokes of equal length, as 一 has one and 三 three. In today's script the upper stroke has become shorter than the lower one. 二 is used for counting and in numbers; before a measure word, 两 is generally used instead.","roles":{}}},"发":{"c":"发","pinyin":"fā","lectures":["fā","fà"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L2-0068","L2-0154","L2-0155","L2-0551","L3-0171","L3-0172","L3-0173","L3-0174","L3-0175","L3-0176","L3-0177","L3-0178","L3-0179","L3-0406","L3-0439","L3-0608","L4-0219","L4-0220","L4-0221","L5-0224","L5-0225","L5-0226","L5-0227","L5-0573","L6-0023","L6-0181","L6-0249","L6-0250","L6-0251","L6-0252","L6-0253","L6-0254","L6-0255","L6-0930","L7-0064","L7-0534","L7-1013","L7-1014","L7-1015","L7-1016","L7-1017","L7-1018","L7-1019","L7-1020","L7-1021","L7-1022","L7-1023","L7-1024","L7-1025","L7-1026","L7-1027","L7-1028","L7-1029","L7-1030","L7-1031","L7-1032","L7-1033","L7-1035","L7-1217","L7-1768","L7-1866","L7-2101","L7-2333","L7-2334","L7-2837","L7-3094","L7-3240","L7-3473","L7-3515","L7-4170","L7-4947","L7-4984","L7-5088","L7-5166","L7-5553"],"chemin":{},"sens":{"statut":"relu","glose":"envoyer ; émettre ; cheveux","acceptions":[{"categorie":"V","fr":"envoyer, expédier ; distribuer"},{"categorie":"V","fr":"émettre, produire ; se développer"},{"categorie":"N","fr":"cheveux","pinyin":"fà"}]},"exemples":[{"zh":"我给你发了一个短信。","pinyin":"Wǒ gěi nǐ fā le yī ge duǎnxìn.","fr":"Je t'ai envoyé un SMS.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi a deux caractères : 發, « tirer à l'arc », avec 弓, et 髮, « les cheveux ». La simplification les écrit tous deux 发, d'après une forme cursive de 發. 发 veut donc dire « envoyer, émettre », lu fā, et « cheveux », lu fà.","en":"The Shuowen jiezi has two characters: 發, “to shoot an arrow”, with 弓, and 髮, “hair”. Simplification writes both as 发, from a cursive form of 發. So 发 means “to send, to emit”, read fā, and “hair”, read fà.","roles":{}}},"乏":{"c":"乏","pinyin":"fá","lectures":["fá"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["丿","之"],"sources":["cjk-decomp","surcharge"]},"mots":["L5-0611"],"chemin":{},"sens":{"statut":"relu","glose":"manquer de ; fatigué","acceptions":[{"categorie":"V","fr":"manquer de"},{"categorie":"Adj","fr":"fatigué, las"}]},"exemples":[{"zh":"走了一天，大家都很疲乏。","pinyin":"Zǒu le yī tiān, dàjiā dōu hěn pífá.","fr":"Après une journée de marche, tout le monde est épuisé.","statut":"relu"}],"origine":null},"伐":{"c":"伐","pinyin":"fá","lectures":["fá"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["亻","戈"],"sources":["cjk-decomp"]},"mots":["L7-0306"],"chemin":{},"sens":{"statut":"relu","glose":"abattre ; attaquer","acceptions":[{"categorie":"V","fr":"abattre des arbres ; attaquer"}]},"exemples":[],"origine":null},"罚":{"c":"罚","pinyin":"fá","lectures":["fá"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["罒","讠","刂"],"sources":["cjk-decomp"]},"mots":["L5-0130","L5-0228","L5-0229","L7-0466"],"chemin":{},"sens":{"statut":"relu","glose":"punir ; mettre à l'amende","acceptions":[{"categorie":"V","fr":"punir, sanctionner ; mettre à l'amende"}]},"exemples":[{"zh":"他开车太快，被罚了两百块。","pinyin":"Tā kāichē tài kuài, bèi fá le liǎngbǎi kuài.","fr":"Il roulait trop vite et a eu deux cents yuans d'amende.","statut":"relu"}],"origine":null},"阀":{"c":"阀","pinyin":"fá","lectures":["fá"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["门","亻","戈"],"sources":["cjk-decomp"]},"mots":["L7-1034"],"chemin":{},"sens":{"statut":"relu","glose":"valve ; clan puissant","acceptions":[{"categorie":"N","fr":"valve, vanne"},{"categorie":"N","fr":"clan puissant, magnat"}]},"exemples":[],"origine":null},"法":{"c":"法","pinyin":"fǎ","lectures":["fǎ"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["氵","去"],"sources":["cjk-decomp"]},"mots":["L2-0009","L2-0159","L2-0313","L2-0597","L2-0771","L3-0287","L4-0222","L4-0223","L4-0224","L4-0225","L4-0505","L4-0765","L4-0902","L5-0230","L5-0231","L5-0699","L5-0703","L5-0721","L5-0785","L5-0884","L6-0256","L6-0257","L6-0985","L7-1097","L7-2628","L7-3600","L7-3898","L7-4503","L7-4542","L7-4641","L7-5353"],"chemin":{"lire":89},"sens":{"statut":"relu","glose":"loi, moyen","acceptions":[]},"exemples":[{"zh":"我们没法去。","pinyin":"Wǒmen méi fǎ qù.","fr":"Nous n'avons aucun moyen d'y aller.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les bronzes, le caractère s'écrit 灋 : l'eau, 水, l'animal légendaire 廌 et 去, « écarter ». Le Shuowen jiezi l'explique ainsi : la loi est égale comme la surface de l'eau, et le 廌 touche de sa corne celui qui n'est pas droit pour l'écarter. La forme 法 a laissé tomber 廌 et ne garde que l'eau et 去.","en":"On bronzes the character is written 灋: water, 水, the legendary beast 廌, and 去, “to remove”. The Shuowen jiezi explains that law is level like the surface of water, and that the 廌 butts the dishonest party with its horn to drive him away. The form 法 dropped 廌, keeping only the water and 去.","roles":{"氵":"sens","去":"sens"}}},"帆":{"c":"帆","pinyin":"fān","lectures":["fān","fán"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["巾","凡"],"sources":["cjk-decomp"]},"mots":["L7-1036","L7-1037","L7-4920"],"chemin":{},"sens":{"statut":"relu","glose":"voile de bateau","acceptions":[{"categorie":"N","fr":"voile de bateau"}]},"exemples":[{"zh":"船上挂着白色的帆。","pinyin":"Chuán shang guà zhe báisè de fān.","fr":"Le bateau porte une toile blanche.","statut":"relu"}],"origine":null}}}
