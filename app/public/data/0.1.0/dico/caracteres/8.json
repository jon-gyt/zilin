,"L7-0831","L7-0832","L7-0833","L7-0834","L7-0835","L7-0836","L7-0837","L7-0838","L7-1032","L7-1040","L7-1080","L7-1333","L7-1335","L7-2191","L7-2238","L7-2254","L7-2343","L7-2418","L7-2735","L7-2758","L7-2938","L7-2947","L7-3708","L7-3918","L7-3963","L7-4070","L7-4071","L7-4075","L7-5092","L7-5140","L7-5389"],"chemin":{"hsk":92,"lire":96},"sens":{"statut":"relu","glose":"terre, sol, lieu ; particule adverbiale","acceptions":[{"categorie":"N","fr":"terre, sol ; lieu, endroit"},{"categorie":"Aux","fr":"particule qui fait d'un mot un complément de manière","pinyin":"de"}]},"exemples":[{"zh":"他高兴地说。","pinyin":"Tā gāoxìng de shuō.","fr":"Il dit, tout content.","statut":"relu"},{"zh":"地上有一本书。","pinyin":"Dìshang yǒu yī běn shū.","fr":"Il y a un livre par terre.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"地 est un composé idéo-phonétique : 土, la terre, donne le sens, et 也 donnait autrefois le son, plus proche en chinois ancien qu'aujourd'hui. Le Shuowen jiezi le définit par opposition au ciel, comme le lieu où sont disposés tous les êtres. Prononcé de, le même caractère sert aussi de particule, placée après un mot pour dire la manière.","en":"地 is a phono-semantic compound: 土, earth, gives the meaning, and 也 once gave the sound, which was closer in Old Chinese than it is today. The Shuowen jiezi defines it in contrast with heaven, as the place where all beings are laid out. Read de, the same character is also a particle placed after a word to express manner.","roles":{"土":"sens","也":"forme"}}},"帝":{"c":"帝","pinyin":"dì","lectures":["dì"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["⿳亠丷冖","巾"],"sources":["surcharge"]},"mots":["L6-0393","L6-0714","L7-0840","L7-0841"],"chemin":{},"sens":{"statut":"relu","glose":"empereur ; dieu suprême","acceptions":[{"categorie":"N","fr":"empereur"},{"categorie":"N","fr":"dieu suprême"}]},"exemples":[],"origine":null},"弟":{"c":"弟","pinyin":"dì","lectures":["dì"],"niveau":1,"decomposition":{"norme