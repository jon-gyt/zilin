-0033","L6-0040"],"chemin":{"hsk":484,"lire":477},"sens":{"statut":"relu","glose":"fermer, clore","acceptions":[{"categorie":"V","fr":"fermer, clore"}]},"exemples":[{"zh":"请闭上眼睛。","pinyin":"Qǐng bì shang yǎnjing.","fr":"Ferme les yeux, s'il te plaît.","statut":"relu"}],"origine":null},"编":{"c":"编","pinyin":"biān","lectures":["biān"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["纟","户","𠕁"],"sources":["cjk-decomp"]},"mots":["L4-0041","L5-0035","L5-0036","L6-0042","L7-0177","L7-0178","L7-0179","L7-0180","L7-0181","L7-1235","L7-5060","L7-5451"],"chemin":{"hsk":484,"lire":477},"sens":{"statut":"relu","glose":"tresser ; rédiger ; inventer","acceptions":[{"categorie":"V","fr":"tresser, tisser"},{"categorie":"V","fr":"rédiger, composer ; inventer une histoire"}]},"exemples":[{"zh":"别编故事了！","pinyin":"Bié biān gùshi le!","fr":"Arrête de raconter des histoires !","statut":"relu"}],"origine":null},"边":{"c":"边","pinyin":"biān","lectures":["biān","bian"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["辶","力"],"sources":["cjk-decomp"]},"mots":["L1-0020","L1-0085","L1-0148","L1-0214","L1-0255","L1-0267","L1-0282","L1-0292","L1-0317","L1-0368","L1-0385","L1-0391","L1-0436","L1-0448","L1-0465","L1-0497","L2-0024","L2-0212","L2-0366","L2-0475","L4-0479","L5-0034","L6-0041","L6-0864","L7-0070","L7-0174","L7-0175","L7-0176","L7-0739","L7-0975","L7-3291","L7-3847","L7-5437"],"chemin":{"hsk":109,"lire":118},"sens":{"statut":"relu","glose":"côté, bord","acceptions":[]},"exemples":[{"zh":"他坐在我左边。","pinyin":"Tā zuò zài wǒ zuǒbian.","fr":"Il est assis à ma gauche.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le caractère traditionnel 邊 associe 辶, la marche, à 臱, qui servait d'élément phonétique. Le Shuowen jiezi y voit la marche le long d'un escarpement, d'où les sens de « bord », puis de « côté ». L'écriture courante a remplacé le composant compliqué 臱 par 力, qui ne porte ici ni sens ni son.","en":"The traditional form 邊 pairs 辶, walking, with 臱, which served as the sound element. The Shuowen jiezi describes it as walking along the edge of a cliff, hence “edge” and then “side”. Everyday handwriting replaced the complicated 臱 with 力, which carries neither meaning nor sound here.","roles":{"辶":"sens","力":"forme"}}},"鞭":{"c":"鞭","pinyin":"biān","lectures":["biān"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["革","亻","更"],"sources":["cjk-decomp"]},"mots":["L7-0182","L7-0183"],"chemin":{"hsk":923,"lire":916},"sens":{"statut":"relu","glose":"fouet ; chapelet de pétards","acceptions":[{"categorie":"N","fr":"fouet"},{"categorie":"N","fr":"chapelet de pétards"}]},"exemples":[],"origine":null},"扁":{"c":"扁","pinyin":"biǎn","lectures":["biǎn","piān"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["户","𠕁"],"sources":["cjk-decomp"]},"mots":["L6-0043"],"chemin":{"hsk":760,"lire":753},"sens":{"statut":"relu","glose":"plat, aplati","acceptions":[{"categorie":"Adj","fr":"plat, aplati"}]},"exemples":[{"zh":"箱子被压扁了。","pinyin":"Xiāngzi bèi yā biǎn le.","fr":"La valise a été écrasée.","statut":"relu"}],"origine":null},"贬":{"c":"贬","pinyin":"biǎn","lectures":["biǎn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["贝","丿","之"],"sources":["cjk-decomp","surcharge"]},"mots":["L7-0184"],"chemin":{"hsk":923,"lire":916},"sens":{"statut":"relu","glose":"déprécier, dévaloriser","acceptions":[{"categorie":"V","fr":"déprécier, dévaloriser ; rétrograder"}]},"exemples":[],"origine":null},"便":{"c":"便","pinyin":"biàn","lectures":["biàn","pián"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["亻","更"],"sources":["cjk-decomp"]},"mots":["L2-0157","L2-0158","L2-0414","L2-0511","L5-0038","L5-0039","L5-0040","L5-0897","L6-0047","L6-0048","L6-0057","L7-0190","L7-0191","L7-0192","L7-0193","L7-1141","L7-1886","L7-3873"],"chemin":{"hsk":226,"lire":235},"sens":{"statut":"relu","glose":"commode ; alors, aussitôt","acceptions":[{"categorie":"Adj","fr":"commode, pratique"},{"categorie":"Adv","fr":"alors, aussitôt : langue écrite"},{"categorie":"Adj","fr":"bon marché, dans piányi","pinyin":"pián"}]},"exemples":[{"zh":"他一到家便睡了。","pinyin":"Tā yī dào jiā biàn shuì le.","fr":"Dès qu'il est rentré, il s'est endormi.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi glose 便 par « à l'aise » et l'écrit avec 人 et 更, changer. Il explique : quand quelqu'un est mal à l'aise, on change les choses pour lui. On lit toujours 亻 à gauche et 更 à droite ; lu pián dans 便宜, il veut dire « bon marché ».","en":"The Shuowen jiezi glosses 便 as “at ease” and writes it with 人 and 更, to change. It explains: when someone is uncomfortable, one changes things for them. You still read 亻 on the left and 更 on the right; read pián in 便宜, it means “cheap”.","roles":{"亻":"sens","更":"sens"}}},"变":{"c":"变","pinyin":"biàn","lectures":["biàn"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["亦","又"],"sources":["cjk-decomp"]},"mots":["L2-0025","L2-0026","L2-0174","L3-0042","L3-0043","L3-0950","L5-0037","L6-0044","L6-0045","L6-0046","L7-0185","L7-0186","L7-0187","L7-0188","L7-0189","L7-1719","L7-3236","L7-4793","L7-4918"],"chemin":{"hsk":278,"lire":282},"sens":{"statut":"relu","glose":"changer, se transformer","acceptions":[{"categorie":"V","fr":"changer, se transformer"}]},"exemples":[{"zh":"天气变了。","pinyin":"Tiānqì biàn le.","fr":"Le temps a tourné.","statut":"relu"},{"zh":"他变高了。","pinyin":"Tā biàn gāo le.","fr":"Il a grandi.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi écrit 變 et le glose « changer » : 攴, la main qui agit, et 䜌 pour le son. La forme simplifiée remplace 䜌 par 亦 et le bas par 又. Ni 亦 ni 又 ne disent plus le son ni le sens : 变 se retient comme un tout.","en":"The Shuowen jiezi writes 變 and glosses it as “to change”: 攴, the acting hand, and 䜌 for the sound. The simplified form replaces 䜌 with 亦 and the lower part with 又. Neither 亦 nor 又 gives sound or meaning any more: 变 is learnt as a whole.","roles":{"亦":"forme","又":"forme"}}},"辨":{"c":"辨","pinyin":"biàn","lectures":["biàn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["辛","辛","丿","丶"],"sources":["cjk-decomp","surcharge"]},"mots":["L7-0195","L7-0196","L7-1115"],"chemin":{"hsk":924,"lire":917},"sens":{"statut":"relu","glose":"distinguer, discerner","acceptions":[{"categorie":"V","fr":"distinguer, discerner"}]},"exemples":[],"origine":null},"辩":{"c":"辩","pinyin":"biàn","lectures":["biàn"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["辛","辛","讠"],"sources":["cjk-decomp"]},"mots":["L4-0042","L7-0197","L7-0198","L7-0199","L7-0677"],"chemin":{"hsk":490,"lire":483},"sens":{"statut":"relu","glose":"débattre, argumenter","acceptions":[{"categorie":"V","fr":"débattre, argumenter, se justifier"}]},"exemples":[{"zh":"他们为这件事辩了很久。","pinyin":"Tāmen wèi zhè jiàn shì biàn le hěn jiǔ.","fr":"Ils se sont longtemps disputés sur cette affaire.","statut":"relu"}],"origine":null},"辫":{"c":"辫","pinyin":"biàn","lectures":["biàn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["辛","辛","纟"],"sources":["cjk-decomp"]},"mots":["L7-0200"],"chemin":{"hsk":924,"lire":917},"sens":{"statut":"relu","glose":"tresse, natte","acceptions":[{"categorie":"N","fr":"tresse, natte"}]},"exemples":[],"origine":null},"遍":{"c":"遍","pinyin":"biàn","lectures":["biàn"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["辶","户","𠕁"],"sources":["cjk-decomp"]},"mots":["L2-0027","L3-0542","L6-0049","L7-0194"],"chemin":{"hsk":224,"lire":234},"sens":{"statut":"relu","glose":"fois (du début à la fin)","acceptions":[{"categorie":"M","fr":"fois : une action faite en entier, du début à la fin"}]},"exemples":[{"zh":"请再说一遍。","pinyin":"Qǐng zài shuō yī biàn.","fr":"Pouvez-vous le redire ?","statut":"relu"},{"zh":"这本书我看了三遍。","pinyin":"Zhè běn shū wǒ kàn le sān biàn.","fr":"J'ai lu ce livre trois fois.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi écrit 徧, « faire le tour », avec 彳, la marche, et 扁 pour le son ; 遍 en est la variante avec 辶. 扁, écrit 户 et 𠕁, se lit biǎn, la même syllabe que 遍, biàn. Faire le tour complet : 遍 compte les fois où l'on fait une chose du début à la fin.","en":"The Shuowen jiezi writes 徧, “to go all round”, with 彳, walking, and 扁 for the sound; 遍 is its variant with 辶. 扁, written 户 and 𠕁, is read biǎn, the same syllable as 遍, biàn. Going all the way round: 遍 counts the times something is done from start to finish.","roles":{"辶":"sens","户":"son","𠕁":"son"}}},"标":{"c":"标","pinyin":"biāo","lectures":["biāo"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["木","示"],"sources":["cjk-decomp"]},"mots":["L3-0044","L3-0045","L3-0498","L4-0043","L5-0647","L5-0710","L5-1013","L7-0201","L7-0202","L7-0203","L7-0204","L7-0205","L7-0206","L7-0207","L7-0406","L7-0676","L7-5259"],"chemin":{"hsk":348,"lire":345},"sens":{"statut":"relu","glose":"marquer, indiquer ; marque, signe","acceptions":[{"categorie":"V","fr":"marquer, indiquer"},{"categorie":"N","fr":"marque, signe"}]},"exemples":[{"zh":"请把重要的地方标出来。","pinyin":"Qǐng bǎ zhòngyào de dìfang biāo chūlai.","fr":"Marque les passages importants, s'il te plaît.","statut":"relu"}],"origine":null},"飙":{"c":"飙","pinyin":"biāo","lectures":["biāo"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["犬","犬","犬","风"],"sources":["cjk-decomp"]},"mots":["L7-0208"],"chemin":{"hsk":925,"lire":918},"sens":{"statut":"relu","glose":"bourrasque ; monter en flèche","acceptions":[{"categorie":"N","fr":"bourrasque, tourbillon"},{"categorie":"V","fr":"monter en flèche, filer à toute allure"}]},"exemples":[],"origine":null},"表":{"c":"表","pinyin":"biǎo","lectures":["biǎo"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["龶","𧘇"],"sources":["cjk-decomp"]},"mots":["L2-0028","L2-0029","L2-0497","L3-0046","L3-0047","L3-0048","L3-0049","L3-0050","L3-0051","L3-0132","L3-0133","L3-0171","L4-0044","L4-0045","L6-0050","L7-0209","L7-0210","L7-0211","L7-0212","L7-0213","L7-0214","L7-3702","L7-4174","L7-4230","L7-4894"],"chemin":{"hsk":225,"lire":234},"sens":{"statut":"relu","glose":"montre ; tableau, formulaire","acceptions":[{"categorie":"N","fr":"montre, compteur"},{"categorie":"N","fr":"tableau, formulaire"}]},"exemples":[{"zh":"我的表坏了。","pinyin":"Wǒ de biǎo huài le.","fr":"Ma montre est cassée.","statut":"relu"},{"zh":"请写一下这个表。","pinyin":"Qǐng xiě yīxià zhège biǎo.","fr":"Remplissez ce formulaire, s'il vous plaît.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi glose 表 par « vêtement de dessus » et l'écrit avec 衣 et 毛, la fourrure. La fourrure portée par-dessus : on lit 龶 en haut, et le bas de 衣, 𧘇. De ce qui se voit dehors est venu « surface, montrer », puis le tableau et la montre.","en":"The Shuowen jiezi glosses 表 as “outer garment” and writes it with 衣 and 毛, fur. Fur worn on the outside: you read 龶 on top and the lower part of 衣, 𧘇. From what shows on the outside came “surface, to show”, then the table and the watch.","roles":{"龶":"sens","𧘇":"sens"}}},"憋":{"c":"憋","pinyin":"biē","lectures":["biē"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["㡀","𠂉","乂","心"],"sources":["cjk-decomp"]},"mots":["L7-0215"],"chemin":{"hsk":925,"lire":918},"sens":{"statut":"relu","glose":"retenir, contenir ; étouffant","acceptions":[{"categorie":"V","fr":"retenir, contenir : souffle, envie, colère"},{"categorie":"Adj","fr":"étouffant, oppressé"}]},"exemples":[{"zh":"他憋了一肚子气。","pinyin":"Tā biē le yī dùzi qì.","fr":"Il a ravalé toute sa colère.","statut":"relu"}],"origine":null},"别":{"c":"别","pinyin":"bié","lectures":["bié","biè"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["口","力","刂"],"sources":["cjk-decomp"]},"mots":["L1-0025","L1-0026","L1-0027","L2-0522","L3-0196","L3-0226","L3-0571","L3-0811","L4-0046","L4-0271","L5-0083","L7-0195","L7-0216","L7-0217","L7-0218","L7-0219","L7-0220","L7-0221","L7-0222","L7-0270","L7-0670","L7-1879","L7-2023","L7-2305","L7-2549","L7-3052","L7-3707","L7-3931"],"chemin":{"hsk":109,"lire":119},"sens":{"statut":"relu","glose":"ne pas (défense), autre, quitter","acceptions":[]},"exemples":[{"zh":"别说话！","pinyin":"Bié shuōhuà!","fr":"Tais-toi !","statut":"relu"},{"zh":"你别走。","pinyin":"Nǐ bié zǒu.","fr":"Ne pars pas.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Au petit sceau, 别 associe 冎, des os, et 刀, un couteau : on sépare la chair des os. Le Shuowen jiezi le glose par « découper, séparer », d'où les sens de « quitter » et de « distinguer ». Dans la forme actuelle, les os sont devenus 口 sur 力, et le couteau s'écrit 刂 sur le côté.","en":"In small seal script, 别 pairs 冎, bones, with 刀, a knife: flesh is being cut away from the bone. The Shuowen jiezi glosses it as cutting apart, hence “to leave” and “to tell apart”. In today's form the bones have become 口 over 力, and the knife is written 刂 at the side.","roles":{"口":"forme","力":"forme","刂":"sens"}}},"宾":{"c":"宾","pinyin":"bīn","lectures":["bīn"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["宀","丘","八"],"sources":["cjk-decomp","surcharge"]},"mots":["L5-0041","L6-0420","L7-1506","L7-2502"],"chemin":{"hsk":619,"lire":612},"sens":{"statut":"relu","glose":"hôte, invité","acceptions":[{"categorie":"N","fr":"hôte, invité"}]},"exemples":[{"zh":"欢迎各位来宾！","pinyin":"Huānyíng gèwèi láibīn!","fr":"Bienvenue à tous nos invités !","statut":"relu"}],"origine":null},"彬":{"c":"彬","pinyin":"bīn","lectures":["bīn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["木","木","彡"],"sources":["cjk-decomp"]},"mots":["L7-0223"],"chemin":{"hsk":926,"lire":919},"sens":{"statut":"relu","glose":"raffiné, élégant","acceptions":[{"categorie":"Adj","fr":"raffiné, élégant"}]},"exemples":[],"origine":null},"滨":{"c":"滨","pinyin":"bīn","lectures":["bīn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["氵","宀","丘","八"],"sources":["cjk-decomp","surcharge"]},"mots":["L7-0224","L7-1546"],"chemin":{"hsk":926,"lire":919},"sens":{"statut":"relu","glose":"rive, bord de l'eau","acceptions":[{"categorie":"N","fr":"rive, bord de l'eau"}]},"exemples":[],"origine":null},"缤":{"c":"缤","pinyin":"bīn","lectures":["bīn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["纟","宀","丘","八"],"sources":["cjk-decomp","surcharge"]},"mots":["L7-0225"],"chemin":{"hsk":927,"lire":920},"sens":{"statut":"relu","glose":"multicolore","acceptions":[{"categorie":"Adj","fr":"multicolore, en désordre gracieux"}]},"exemples":[],"origine":null},"兵":{"c":"兵","pinyin":"bīng","lectures":["bīng"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["丘","八"],"sources":["surcharge"]},"mots":["L4-0050","L4-0645","L7-1459"],"chemin":{"hsk":498,"lire":491},"sens":{"statut":"relu","glose":"soldat ; armée","acceptions":[{"categorie":"N","fr":"soldat ; troupes, armée"}]},"exemples":[{"zh":"他当了三年兵。","pinyin":"Tā dāng le sān nián bīng.","fr":"Il a fait trois ans de service militaire.","statut":"relu"}],"origine":null},"冰":{"c":"冰","pinyin":"bīng","lectures":["bīng"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["冫","水"],"sources":["cjk-decomp"]},"mots":["L4-0047","L4-0048","L4-0049","L7-0226","L7-0227","L7-1721","L7-2112"],"chemin":{"hsk":485,"lire":478},"sens":{"statut":"relu","glose":"glace","acceptions":[{"categorie":"N","fr":"glace"},{"categorie":"V","fr":"rafraîchir, glacer"}]},"exemples":[{"zh":"河上结冰了。","pinyin":"Hé shang jié bīng le.","fr":"La rivière a gelé.","statut":"relu"}],"origine":null},"丙":{"c":"丙","pinyin":"bǐng","lectures":["bǐng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L7-0228"],"chemin":{"hsk":217,"lire":187},"sens":{"statut":"relu","glose":"troisième (tronc céleste)","acceptions":[]},"exemples":[{"zh":"甲、乙、丙三个人都去了。","pinyin":"Jiǎ, yǐ, bǐng sān gè rén dōu qù le.","fr":"Les trois personnes, A, B et C, y sont toutes allées.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"丙 est le troisième des dix troncs célestes, et c'est déjà ainsi qu'il s'emploie sur les os oraculaires ; ce que la forme dessinait reste discuté. Il sert aujourd'hui à dire « le troisième », comme C dans une liste. Dans 病, il donne le son, bìng pour bǐng.","en":"丙 is the third of the ten heavenly stems, and that is already how it is used on oracle bones; what the shape once drew is still debated. Today it means “the third”, like C in a list. In 病 it gives the sound, bìng for bǐng.","roles":{}}},"柄":{"c":"柄","pinyin":"bǐng","lectures":["bǐng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["木","丙"],"sources":["cjk-decomp"]},"mots":["L7-0041"],"chemin":{"hsk":927,"lire":920},"sens":{"statut":"relu","glose":"manche, poignée ; prise","acceptions":[{"categorie":"N","fr":"manche, poignée"},{"categorie":"N","fr":"prise, motif de critique ou de moquerie"}]},"exemples":[],"origine":null},"秉":{"c":"秉","pinyin":"bǐng","lectures":["bǐng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L7-0229"],"chemin":{"hsk":918,"lire":911},"sens":{"statut":"relu","glose":"tenir ; présider à","acceptions":[{"categorie":"V","fr":"tenir en main ; présider à"}]},"exemples":[],"origine":null},"饼":{"c":"饼","pinyin":"bǐng","lectures":["bǐng"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["饣","丷","开"],"sources":["cjk-decomp"]},"mots":["L5-0042","L5-0043","L5-0945"],"chemin":{"hsk":620,"lire":613},"sens":{"statut":"relu","glose":"galette, crêpe ; gâteau rond","acceptions":[{"categorie":"N","fr":"galette, crêpe ; gâteau plat et rond"}]},"exemples":[{"zh":"早上我吃了一个鸡蛋饼。","pinyin":"Zǎoshang wǒ chī le yī ge jīdàn bǐng.","fr":"Ce matin, j'ai mangé une galette aux œufs.","statut":"relu"}],"origine":null},"并":{"c":"并","pinyin":"bìng","lectures":["bìng","bīng"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["丷","开"],"sources":["cjk-decomp"]},"mots":["L3-0052","L3-0053","L4-0051","L5-0317","L7-0230","L7-0231","L7-0232","L7-0233","L7-4523"],"chemin":{"hsk":349,"lire":346},"sens":{"statut":"relu","glose":"pas du tout ; et, de plus ; réunir","acceptions":[{"categorie":"Adv","fr":"absolument (pas) : renforce une négation"},{"categorie":"Conj","fr":"et, et de plus"},{"categorie":"V","fr":"réunir, mettre ensemble"}]},"exemples":[{"zh":"这个问题并不难。","pinyin":"Zhège wèntí bìng bù nán.","fr":"Cette question n'est pas du tout difficile.","statut":"relu"},{"zh":"他同意了，并马上去做了。","pinyin":"Tā tóngyì le, bìng mǎshàng qù zuò le.","fr":"Il a accepté et s'y est mis tout de suite.","statut":"relu"}],"origine":null},"病":{"c":"病","pinyin":"bìng","lectures":["bìng"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["疒","丙"],"sources":["cjk-decomp"]},"mots":["L1-0028","L1-0029","L1-0193","L1-0329","L3-0476","L5-0044","L6-0051","L6-0052","L6-0249","L6-0414","L6-0903","L6-1081","L7-0008","L7-0169","L7-0234","L7-0235","L7-0541","L7-0588","L7-1766","L7-2206","L7-4022","L7-4599","L7-5366"],"chemin":{"hsk":217,"lire":187},"sens":{"statut":"relu","glose":"maladie, être malade","acceptions":[]},"exemples":[{"zh":"她病了三天。","pinyin":"Tā bìng le sān tiān.","fr":"Elle a été malade trois jours.","statut":"relu"},{"zh":"他的病好了。","pinyin":"Tā de bìng hǎo le.","fr":"Il est guéri.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi analyse 病 comme un composé idéo-phonétique, 疒 pour le sens et 丙 pour le son, et le définit comme une maladie qui s'aggrave. Sur les os oraculaires, la forme d'où vient 疒 montre une personne couchée sur un lit ; elle sert de clé aux noms de maladies. 丙 se lit bǐng, un son proche de bìng, qui ne diffère que par le ton.","en":"The Shuowen jiezi analyses 病 as a meaning-sound compound, with 疒 for the meaning and 丙 for the sound, and defines it as an illness that grows worse. On oracle bones, the form behind 疒 shows a person lying on a bed; it became the radical for the names of illnesses. 丙 is read bǐng, close to bìng, differing only in tone.","roles":{"疒":"sens","丙":"son"}}},"剥":{"c":"剥","pinyin":"bō","lectures":["bō","bāo"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["彐","氺","刂"],"sources":["cjk-decomp"]},"mots":["L7-0093","L7-0243","L7-0244"],"chemin":{"hsk":928,"lire":921},"sens":{"statut":"relu","glose":"éplucher, écorcer ; dépouiller","acceptions":[{"categorie":"V","fr":"éplucher, écorcer, écaler","pinyin":"bāo"},{"categorie":"V","fr":"dépouiller, priver : en composé"}]},"exemples":[{"zh":"他剥了一个鸡蛋。","pinyin":"Tā bāo le yī gè jīdàn.","fr":"Il a écalé un œuf.","statut":"relu"}],"origine":null},"拨":{"c":"拨","pinyin":"bō","lectures":["bō"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["扌","发"],"sources":["cjk-decomp"]},"mots":["L6-0053","L7-0236","L7-0237","L7-0238"],"chemin":{"hsk":760,"lire":753},"sens":{"statut":"relu","glose":"tourner du doigt, composer ; allouer","acceptions":[{"categorie":"V","fr":"pousser, tourner du doigt ; composer : un numéro"},{"categorie":"V","fr":"allouer, attribuer : des fonds"}]},"exemples":[{"zh":"他拨了一个电话号码。","pinyin":"Tā bō le yī ge diànhuà hàomǎ.","fr":"Il a fait un numéro de téléphone.","statut":"relu"}],"origine":null},"播":{"c":"播","pinyin":"bō","lectures":["bō"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["扌","釆","田"],"sources":["cjk-decomp"]},"mots":["L3-0054","L3-0055","L3-0110","L3-0270","L3-0907","L6-0056","L7-0500","L7-4794","L7-5489"],"chemin":{"hsk":373,"lire":368},"sens":{"statut":"relu","glose":"diffuser, émettre ; semer","acceptions":[{"categorie":"V","fr":"diffuser, émettre"},{"categorie":"V","fr":"semer"}]},"exemples":[{"zh":"电视上正在播新闻。","pinyin":"Diànshì shang zhèngzài bō xīnwén.","fr":"La télé passe les informations.","statut":"relu"}],"origine":null},"波":{"c":"波","pinyin":"bō","lectures":["bō"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["氵","皮"],"sources":["cjk-decomp"]},"mots":["L6-0054","L6-0055","L6-0857","L7-0140","L7-0239","L7-0240","L7-0241","L7-0242","L7-1147"],"chemin":{"hsk":761,"lire":754},"sens":{"statut":"relu","glose":"vague, onde","acceptions":[{"categorie":"N","fr":"vague, onde"}]},"exemples":[],"origine":null}}}
