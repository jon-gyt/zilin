],"sources":["surcharge"]},"mots":["L1-0103","L1-0104","L1-0105","L2-0162","L2-0163","L3-0055","L3-0192","L3-0407","L4-0235","L5-0235","L5-0236","L5-0400","L6-0251","L7-0055","L7-0663","L7-1085","L7-1086","L7-1087","L7-1088","L7-1089","L7-1090","L7-1237","L7-3048","L7-3414","L7-3757","L7-4114","L7-5071","L7-5246"],"chemin":{"hsk":112},"sens":{"statut":"relu","glose":"poser, mettre ; lâcher","acceptions":[{"categorie":"V","fr":"poser, mettre, placer"},{"categorie":"V","fr":"lâcher, libérer ; avoir congé"}]},"exemples":[{"zh":"请放在这儿。","pinyin":"Qǐng fàng zài zhèr.","fr":"Posez-le ici, s'il vous plaît.","statut":"relu"}],"origine":null},"啡":{"c":"啡","pinyin":"fēi","lectures":["fēi"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["口","非"],"sources":["cjk-decomp"]},"mots":["L3-0405"],"chemin":{},"sens":{"statut":"relu","glose":"syllabe de transcription : café","acceptions":[{"categorie":"N","fr":"syllabe de transcription : café"}]},"exemples":[],"origine":null},"绯":{"c":"绯","pinyin":"fēi","lectures":["fēi"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["纟","非"],"sources":["cjk-decomp"]},"mots":["L7-1099"],"chemin":{},"sens":{"statut":"relu","glose":"rouge vif","acceptions":[{"categorie":"Adj","fr":"rouge vif, écarlate"}]},"exemples":[],"origine":null},"非":{"c":"非","pinyin":"fēi","lectures":["fēi"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0108","L4-0236","L5-0127","L7-0230","L7-1095","L7-1096","L7-1097","L7-1098","L7-2876","L7-2919","L7-3751","L7-3924","L7-4360","L7-4369"],"chemin":{"hsk":41,"lire":41},"sens":{"statut":"relu","glose":"ne pas être, non, faux","acceptions":[]},"exemples":[{"zh":"你非来不可。","pinyin":"Nǐ fēi lái bù kě.","fr":"Il faut absolument que tu viennes.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Les formes anciennes de 非 montrent déjà deux rangées de traits symétriques, placées dos à dos. Le Shuowen jiezi le tire des ailes de 飛, « voler », tournées en sens contraire, d'où l'idée de « s'opposer », puis de « ne pas être ». Le caractère moderne garde cette symétrie : deux traits verticaux, chacun bordé de trois petits traits tournés vers l'extérieur.","en":"In early script, 非 already shows two symmetrical rows of strokes set back to back. The Shuowen jiezi derives it from the wings of 飛, “to fly”, spread in opposite directions, hence “to go against” and then “not to be”. The modern character keeps that symmetry: two upright strokes, each lined with three short strokes pointing outward.","roles":{}}},"飞":{"c":"飞","pinyin":"fēi","lectures":["fēi"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0106","L1-0107","L2-0430","L3-0193","L6-0272","L6-0273","L7-0262","L7-1091","L7-1092","L7-1093","L7-1094"],"chemin":{"hsk":84,"lire":84},"sens":{"statut":"relu","glose":"voler","acceptions":[]},"exemples":[{"zh":"飞机飞得很高。","pinyin":"Fēijī fēi de hěn gāo.","fr":"L'avion vole très haut.","statut":"relu"},{"zh":"我明天飞北京。","pinyin":"Wǒ míngtiān fēi Běijīng.","fr":"Demain, je prends l'avion pour Pékin.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi range 飛, forme traditionnelle de 飞, parmi les pictogrammes : un oiseau qui s'élève, les ailes déployées. Dans le petit sceau, des plumes s'ouvrent de part et d'autre d'un corps dressé. La forme simplifiée 飞 n'en garde que le haut, un crochet et deux traits courts.","en":"The Shuowen jiezi lists 飛, the traditional form of 飞, among pictograms: a bird rising with its wings spread. In small seal script, feathers open out on both sides of an upright body. The simplified 飞 keeps only the top of it, a hook and two short strokes.","roles":{}}},"肥":{"c":"肥","pinyin":"féi","lectures":["féi"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":["月","巴"],"sources":["cjk-decomp"]},"mots":["L4-0237","L4-0379","L7-1100","L7-1101","L7-1102","L7-1103","L7-1725"],"chemin":{},"sens":{"statut":"relu","glose":"gras ; ample ; engrais","acceptions":[{"categorie":"Adj","fr":"gras : viande, animal"},{"categorie":"Adj","fr":"ample, large : vêtement"},{"categorie":"N","fr":"engrais"}]},"exemples":[{"zh":"这件衣服太肥了。","pinyin":"Zhè jiàn yīfu tài féi le.","fr":"Ce vêtement est trop grand.","statut":"relu"}],"origine":null},"匪":{"c":"匪","pinyin":"fěi","lectures":["fěi"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["匚","非"],"sources":["cjk-decomp"]},"mots":["L7-4181"],"chemin":{},"sens":{"statut":"relu","glose":"bandit, brigand","acceptions":[{"categorie":"N","fr":"bandit, brigand"}]},"exemples":[],"origine":null},"诽":{"c":"诽","pinyin":"fěi","lectures":["fěi"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["讠","非"],"sources":["cjk-decomp"]},"mots":["L7-1104"],"chemin":{},"sens":{"statut":"relu","glose":"calomnier","acceptions":[{"categorie":"V","fr":"calomnier"}]},"exemples":[],"origine":null},"废":{"c":"废","pinyin":"fèi","lectures":["fèi"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["广","发"],"sources":["cjk-decomp"]},"mots":["L6-1138","L7-0075","L7-0112","L7-1105","L7-1106","L7-1107","L7-1108","L7-1109","L7-1110","L7-1111","L7-4199"],"chemin":{},"sens":{"statut":"relu","glose":"hors d'usage ; abolir","acceptions":[{"categorie":"Adj","fr":"hors d'usage, usé, de rebut"},{"categorie":"V","fr":"abolir, abandonner"}]},"exemples":[{"zh":"这些都是废纸。","pinyin":"Zhèxiē dōu shì fèi zhǐ.","fr":"Ce ne sont que des vieux papiers.","statut":"relu"}],"origine":null},"沸":{"c":"沸","pinyin":"fèi","lectures":["fèi"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["氵","弗"],"sources":["cjk-decomp"]},"mots":["L7-1112","L7-1113"],"chemin":{},"sens":{"statut":"relu","glose":"bouillir","acceptions":[{"categorie":"V","fr":"bouillir"}]},"exemples":[],"origine":null},"肺":{"c":"肺","pinyin":"fèi","lectures":["fèi"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["月","巿"],"sources":["cjk-decomp"]},"mots":["L6-0274"],"chemin":{},"sens":{"statut":"relu","glose":"p