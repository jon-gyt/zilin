composition":{"norme":"GF 0014-2009","parts":["丨","丨","又","月"],"sources":["cjk-decomp","surcharge"]},"mots":["L7-3641"],"chemin":{},"sens":{"statut":"relu","glose":"rein","acceptions":[{"categorie":"N","fr":"rein"}]},"exemples":[{"zh":"他的肾有点儿问题。","pinyin":"Tā de shèn yǒudiǎnr wèntí.","fr":"Il a un petit problème rénal.","statut":"relu"}],"origine":null},"升":{"c":"升","pinyin":"shēng","lectures":["shēng"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L3-0617","L3-0627","L4-0314","L5-0672","L6-0726","L6-0727","L6-0728","L6-0797","L6-1070","L7-0208","L7-1795","L7-2173","L7-3055","L7-3646"],"chemin":{},"sens":{"statut":"relu","glose":"monter, s'élever ; litre","acceptions":[{"categorie":"V","fr":"monter, s'élever ; être promu"},{"categorie":"M","fr":"litre"}]},"exemples":[{"zh":"太阳升起来了。","pinyin":"Tàiyáng shēng qilai le.","fr":"Le soleil s'est levé.","statut":"relu"},{"zh":"我买了两升水。","pinyin":"Wǒ mǎi le liǎng shēng shuǐ.","fr":"J'ai acheté deux litres d'eau.","statut":"relu"}],"origine":null},"声":{"c":"声","pinyin":"shēng","lectures":["shēng"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["士","𠃜"],"sources":["cjk-decomp"]},"mots":["L2-0097","L2-0480","L2-0603","L3-0228","L3-0635","L5-0480","L5-0674","L5-0833","L6-0883","L6-0893","L6-1044","L7-1695","L7-1749","L7-1811","L7-2897","L7-3660","L7-3661","L7-3662","L7-4301","L7-4607","L7-4757","L7-4937","L7-4959","L7-5075","L7-5214"],"chemin":{},"sens":{"statut":"relu","glose":"son, voix ; classif. des cris","acceptions":[{"categorie":"N","fr":"son, bruit ; voix"},{"categorie":"M","fr":"classificateur des cris et des sons"}]},"exemples":[{"zh":"他叫了一声。","pinyin":"Tā jiào le yī shēng.","fr":"Il a poussé un cri.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi écrit 聲 et le glose « son » : 耳, l'oreille, et 殸, la pierre musicale, pour le son. Le son de la pierre qu'on frappe, reçu par l'oreille. La forme simplifiée ne garde que le haut, 士 sur 𠃜.","en":"The Shuowen jiezi writes 聲 and glosses it as “sound”: 耳, the ear, and 殸, the musical stone, for the sound. The sound of a struck stone, received by the ear. The simplified form keeps only the top, 士 over 𠃜.","roles":{"士":"forme","𠃜":"forme"}}},"牲":{"c":"牲","pinyin":"shēng","lectures":["shēng"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["牛","生"],"sources":["cjk-decomp"]},"mots":["L6-0872","L7-3663"],"chemin":{},"sens":{"statut":"relu","glose":"bétail ; animal de sacrifice","acceptions":[{"categorie":"N","fr":"bétail ; animal de sacrifice"}]},"exemples":[],"origine":null},"生":{"c":"生","pinyin":"shēng","lectures":["shēng"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0063","L1-0265","L1-0281","L1-0329","L1-0330","L1-0331","L1-0398","L1-0407","L1-0419","L1-0429","L1-0482","L2-0072","L2-0314","L2-0362","L2-0477","L2-0478","L2-0479","L2-0662","L3-0075","L3-0176","L3-0593","L3-0628","L3-0629","L3-0630","L3-0631","L3-0632","L3-0633","L3-0634","L3-0755","L3-0756","L4-0038","L4-0848","L5-0673","L5-0979","L6-0197","L6-0389","L6-0729","L6-0734","L6-0858","L6-0945","L6-1022","L7-2368","L7-2736","L7-2918","L7-2929","L7-3318","L7-3518","L7-3647","L7-3648","L7-3649","L7-3650","L7-3651","L7-3652","L7-3653","L7-3654","L7-3655","L7-3656","L7-3657","L7-3658","L7-3659","L7-4029","L7-4078","L7-4183","L7-4627","L7-4784","L7-4820","L7-5422","L7-5557","L7-5635"],"chemin":{"hsk":18,"lire":14},"sens":{"statut":"relu","glose":"naître, vivre, cru","acceptions":[]},"exemples":[{"zh":"她生了一个女儿。","pinyin":"Tā shēng le yī ge nǚ'ér.","fr":"Elle a eu une fille.","statut":"relu"},{"zh":"这个菜是生的。","pinyin":"Zhège cài shì shēng de.","fr":"Ce plat est cru.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 生 montre une jeune pousse qui sort d'un trait horizontal figurant le sol. Le Shuowen jiezi le glose par « avancer » et y voit les plantes qui sortent de terre. Du sens « pousser, naître », le caractère est passé à « vivre », puis à « cru » et à « inconnu », ce qui n'a pas encore été travaillé ou fréquenté.","en":"On oracle bones, 生 shows a young shoot rising from a horizontal stroke that stands for the ground. The Shuowen jiezi glosses it as “to advance” and sees in it plants coming up out of the earth. From “to sprout, to be born” the meaning spread to “to live”, then to “raw” and “unfamiliar”, whatever has not yet been worked or known.","roles":{}}},"绳":{"c":"绳","pinyin":"shéng","lectures":["shéng"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["纟","口","电"],"sources":["cjk-decomp"]},"mots":["L7-3664"],"chemin":{},"sens":{"statut":"relu","glose":"corde","acceptions":[{"categorie":"N","fr":"corde, ficelle"}]},"exemples":[],"origine":null},"省":{"c":"省","pinyin":"shěng","lectures":["shěng","xǐng"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["少","目"],"sources":["cjk-decomp"]},"mots":["L2-0481","L2-0482","L4-0401","L6-0730","L7-1060","L7-3665","L7-3666"],"chemin":{},"sens":{"statut":"relu","glose":"province ; économiser","acceptions":[{"categorie":"N","fr":"province"},{"categorie":"V","fr":"économiser, épargner ; omettre"}]},"exemples":[{"zh":"中国有很多省。","pinyin":"Zhōngguó yǒu hěn duō shěng.","fr":"La Chine compte de nombreuses provinces.","statut":"relu"},{"zh":"坐地铁可以省很多时间。","pinyin":"Zuò dìtiě kěyǐ shěng hěn duō shíjiān.","fr":"Le métro fait gagner beaucoup de temps.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi glose 省 par « regarder » et l'écrit avec 眉, le sourcil sur l'œil, abrégé, et 屮. On lit aujourd'hui 少 sur 目. Examiner de près : lu xǐng, s'examiner ; lu shěng, économiser, et la province qu'on inspecte.","en":"The Shuowen jiezi glosses 省 as “to look at” and writes it with a shortened 眉, the brow over the eye, and 屮. Today you read 少 over 目. To look closely: read xǐng, to reflect on oneself; read shěng, to save, and the province one inspects.","roles":{"少":"forme","目":"sens"}}},"剩":{"c":"剩","pinyin":"shèng","lectures":["shèng"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["禾","匕","匕","刂"],"sources":["cjk-decomp"]},"mots":["L5-0676","L5-0677","L7-1536","L7-3674"],"chemin":{},"sens":{"statut":"relu","glose":"rester, être de reste","acceptions":[{"categorie":"V","fr":"rester, être de reste"}]},"exemples":[{"zh":"钱包里只剩十块钱了。","pinyin":"Qiánbāo li zhǐ shèng shí kuài qián le.","fr":"Il ne reste que dix yuans dans mon portefeuille.","statut":"relu"}],"origine":null},"圣":{"c":"圣","pinyin":"shèng","lectures":["shèng"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["又","土"],"sources":["cjk-decomp"]},"mots":["L6-0731","L7-3631","L7-3667"],"chemin":{},"sens":{"statut":"relu","glose":"saint, sacré ; sage","acceptions":[{"categorie":"Adj","fr":"saint, sacré"},{"categorie":"N","fr":"sage, saint"}]},"exemples":[],"origine":null},"盛":{"c":"盛","pinyin":"shèng","lectures":["shèng","chéng"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["万","戈","皿"],"sources":["cjk-decomp"]},"mots":["L6-0099","L6-0732","L7-0464","L7-1145","L7-2801","L7-3670","L7-3671","L7-3672","L7-3673","L7-4277"],"chemin":{},"sens":{"statut":"relu","glose":"florissant, abondant ; servir (un bol)","acceptions":[{"categorie":"Adj","fr":"florissant, abondant ; grandiose"},{"categorie":"V","fr":"servir, remplir : un bol, un plat","pinyin":"chéng"}]},"exemples":[{"zh":"请给我盛一碗饭。","pinyin":"Qǐng gěi wǒ chéng yī wǎn fàn.","fr":"Sers-moi un bol de riz, s'il te plaît.","statut":"relu"}],"origine":null},"胜":{"c":"胜","pinyin":"shèng","lectures":["shèng","shēng"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["月","生"],"sources":["cjk-decomp"]},"mots":["L3-0636","L3-0637","L4-0930","L5-0675","L6-0588","L7-1843","L7-3382","L7-3668","L7-3669","L7-4988"],"chemin":{},"sens":{"statut":"relu","glose":"gagner, vaincre ; surpasser","acceptions":[{"categorie":"V","fr":"gagner, vaincre, l'emporter"},{"categorie":"V","fr":"surpasser, valoir mieux que"}]},"exemples":[{"zh":"我们队胜了。","pinyin":"Wǒmen duì shèng le.","fr":"Notre équipe a gagné.","statut":"relu"}],"origine":null}}}
