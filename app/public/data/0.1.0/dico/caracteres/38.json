7-4542"],"chemin":{},"sens":{"statut":"relu","glose":"installer, établir ; supposer","acceptions":[{"categorie":"V","fr":"installer, établir, créer"},{"categorie":"V","fr":"supposer"}]},"exemples":[{"zh":"这个公司在北京设了一个办公室。","pinyin":"Zhège gōngsī zài Běijīng shè le yī ge bàngōngshì.","fr":"Cette entreprise a ouvert un bureau à Pékin.","statut":"relu"}],"origine":null},"谁":{"c":"谁","pinyin":"shéi","lectures":["shéi","shuí"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["讠","隹"],"sources":["cjk-decomp"]},"mots":["L1-0325","L7-3607"],"chemin":{"hsk":105,"lire":101},"sens":{"statut":"relu","glose":"qui","acceptions":[]},"exemples":[{"zh":"这是谁的书？","pinyin":"Zhè shì shéi de shū?","fr":"À qui est ce livre ?","statut":"relu"},{"zh":"谁来了？","pinyin":"Shéi lái le?","fr":"Qui est arrivé ?","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi décrit 誰, forme traditionnelle, comme un composé idéo-phonétique : 言, la parole, pour le sens, et 隹 pour le son. Sa glose en fait dès l'origine un mot de question, « qui, lequel ». Les lectures ont divergé depuis : 隹 se lit zhuī, 谁 se lit shuí ou shéi.","en":"The Shuowen jiezi describes 誰, the traditional form, as a sound-meaning compound: 言, speech, gives the meaning and 隹 gives the sound. Its gloss makes it a question word from the start, “who, which one”. The readings have drifted apart since: 隹 is zhuī, while 谁 is shuí or shéi.","roles":{"讠":"sens","隹":"forme"}}},"伸":{"c":"伸","pinyin":"shēn","lectures":["shēn"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["亻","申"],"sources":["cjk-decomp"]},"mots":["L5-0665","L5-0871","L7-3611","L7-3612","L7-3613"],"chemin":{},"sens":{"statut":"relu","glose":"étendre, tendre, allonger","acceptions":[{"categorie":"V","fr":"étendre, tendre, allonger (un membre)"}]},"exemples":[{"zh":"他伸出手来和我握手。","pinyin":"Tā shēn chū shǒu lái hé wǒ wòshǒu.","fr":"Il m'a tendu la main pour me saluer.","statut":"relu"}],"origine":null},"深":{"c":"深","pinyin":"shēn","lectures":["shēn"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["氵","冖","八","木"],"sources":["cjk-decomp"]},"mots":["L3-0624","L3-0625","L3-0626","L4-0631","L5-0666","L5-0667","L6-0723","L6-0724","L7-1325","L7-1933","L7-3621","L7-3622","L7-3623","L7-3624","L7-3625","L7-3626","L7-3627","L7-3628","L7-3629","L7-5545","L7-5591"],"chemin":{},"sens":{"statut":"relu","glose":"profond ; foncé ; intime","acceptions":[{"categorie":"Adj","fr":"profond"},{"categorie":"Adj","fr":"foncé (couleur) ; difficile, poussé"},{"categorie":"Adj","fr":"intime, étroit (relation)"}]},"exemples":[{"zh":"这条河很深。","pinyin":"Zhè tiáo hé hěn shēn.","fr":"On n'a pas pied dans cette rivière.","statut":"relu"},{"zh":"我喜欢深颜色。","pinyin":"Wǒ xǐhuan shēn yánsè.","fr":"J'aime les couleurs foncées.","statut":"relu"}],"origine":null},"申":{"c":"申","pinyin":"shēn","lectures":["shēn"],"niveau":4,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L4-0627","L7-0504","L7-3608","L7-3609","L7-3610"],"chemin":{},"sens":{"statut":"relu","glose":"exposer, déclarer","acceptions":[{"categorie":"V","fr":"exposer, déclarer"}]},"exemples":[],"origine":null},"绅":{"c":"绅","pinyin":"shēn","lectures":["shēn"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["纟","申"],"sources":["cjk-decomp"]},"mots":["L7-3620"],"chemin":{},"sens":{"statut":"relu","glose":"notable, gentilhomme","acceptions":[{"categorie":"N","fr":"notable, gentilhomme"}]},"exemples":[],"origine":null},"身":{"c":"身","pinyin":"shēn","lectures":["shēn"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L1-0326","L1-0327","L2-0457","L2-0475","L3-0623","L3-0962","L4-0382","L4-0628","L4-0629","L4-0630","L4-0978","L5-0900","L5-1027","L6-0033","L7-0348","L7-0546","L7-0742","L7-0919","L7-0943","L7-1726","L7-1816","L7-3304","L7-3317","L7-3438","L7-3614","L7-3615","L7-3616","L7-3617","L7-3618","L7-3619","L7-3962","L7-4069","L7-4161","L7-4215","L7-4912","L7-4999"],"chemin":{"hsk":61,"lire":168},"sens":{"statut":"relu","glose":"corps","acceptions":[]},"exemples":[],"origine":{"statut":"relu","etiquette":"atteste","fr":"Sur les os oraculaires, 身 dessine le corps d'une personne vue de profil, le ventre arrondi, parfois marqué d'un point : beaucoup y voient une femme enceinte. Le Shuowen jiezi le définit comme le corps. On le retrouve dans 谢, à l'intérieur de 射, où il a pris, dans l'écriture, la place d'un arc.","en":"On oracle bones, 身 draws a person's body in profile, the belly rounded, sometimes marked with a dot: many see a pregnant woman in it. The Shuowen jiezi defines it as the body. It turns up in 谢, inside 射, where writing put it in place of a bow.","roles":{}}},"什":{"c":"什","pinyin":"shén","lectures":["shén","shí"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["亻","十"],"sources":["cjk-decomp"]},"mots":["L1-0114","L1-0234","L1-0328","L2-0476","L2-0571"],"chemin":{"hsk":89,"lire":96},"sens":{"statut":"relu","glose":"quoi (suivi de me)","acceptions":[{"categorie":"Pron","fr":"quoi, que : premier élément de shénme"}]},"exemples":[],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi rattache 什 à l'homme, 亻, et au nombre dix, 十. Il désignait un groupe de dix hommes, et se lisait alors shí, comme 十. Aujourd'hui il sert surtout dans 什么, « quoi », où il se lit shén.","en":"The Shuowen jiezi links 什 to a person, 亻, and to the number ten, 十. It named a group of ten men and was then read shí, like 十. Today it is mostly used in 什么, “what”, where it is read shén.","roles":{"亻":"sens","十":"sens"}}},"神":{"c":"神","pinyin":"shén","lectures":["shén"],"niveau":3,"decomposition":{"norme":"GF 0014-2009","parts":["礻","申"],"sources":["cjk-decomp"]},"mots":["L3-0386","L3-0387","L4-0632","L4-0633","L5-0668","L5-0669","L5-0670","L5-0671","L7-2206","L7-2299","L7-2680","L7-3630","L7-3631","L7-3632","L7-3633","L7-4791"],"chemin":{},"sens":{"statut":"relu","glose":"dieu, esprit ; prodigieux","acceptions":[{"categorie":"N","fr":"dieu, divini