":"retiré, écarté ; peu courant"}]},"exemples":[],"origine":null},"媲":{"c":"媲","pinyin":"pì","lectures":["pì"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["女","囟","匕","匕"],"sources":["cjk-decomp"]},"mots":["L7-3105"],"chemin":{},"sens":{"statut":"relu","glose":"égaler","acceptions":[{"categorie":"V","fr":"égaler, rivaliser avec"}]},"exemples":[],"origine":null},"譬":{"c":"譬","pinyin":"pì","lectures":["pì"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["尸","口","辛","言"],"sources":["cjk-decomp"]},"mots":["L7-3107","L7-3108"],"chemin":{},"sens":{"statut":"relu","glose":"comparer ; exemple","acceptions":[{"categorie":"V","fr":"comparer ; donner pour exemple"}]},"exemples":[],"origine":null},"辟":{"c":"辟","pinyin":"pì","lectures":["pì","bì","pī"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["尸","口","辛"],"sources":["cjk-decomp"]},"mots":["L7-2340","L7-2343"],"chemin":{},"sens":{"statut":"relu","glose":"ouvrir, frayer ; réfuter","acceptions":[{"categorie":"V","fr":"ouvrir, frayer (un chemin)"},{"categorie":"V","fr":"réfuter, démentir"}]},"exemples":[{"zh":"他的分析很精辟。","pinyin":"Tā de fēnxī hěn jīngpì.","fr":"Son analyse est d'une grande pertinence.","statut":"relu"}],"origine":null},"偏":{"c":"偏","pinyin":"piān","lectures":["piān"],"niveau":6,"decomposition":{"norme":"GF 0014-2009","parts":["亻","户","𠕁"],"sources":["cjk-decomp"]},"mots":["L6-0621","L7-3110","L7-3111","L7-3112","L7-3113","L7-3114","L7-3115","L7-3116"],"chemin":{},"sens":{"statut":"relu","glose":"de travers, partial ; obstinément","acceptions":[{"categorie":"Adj","fr":"penché, de travers ; partial"},{"categorie":"Adv","fr":"obstinément, justement, contre toute attente"}]},"exemples":[{"zh":"我不让他去，他偏要去。","pinyin":"Wǒ bù ràng tā qù, tā piān yào qù.","fr":"Je lui ai interdit d'y aller, mais il tient à y aller.","statut":"relu"}],"origine":null},"篇":{"c":"篇","pinyin":"piān","lectures":["piān"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["⺮","户","𠕁"],"sources":["cjk-decomp"]},"mots":["L2-0413","L7-3117"],"chemin":{},"sens":{"statut":"relu","glose":"classif. des textes","acceptions":[{"categorie":"M","fr":"classificateur des textes : article, essai"}]},"exemples":[{"zh":"这篇课文很长。","pinyin":"Zhè piān kèwén hěn cháng.","fr":"Ce texte est très long.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi glose 篇 par « écrit » : 竹, les lamelles de bambou, et 扁 pour le son. 扁, écrit 户 et 𠕁, se lit biǎn : il ne donne plus tout à fait le son de piān. Un ensemble de lamelles liées forme un texte : 篇 compte les articles.","en":"The Shuowen jiezi glosses 篇 as “writing”: 竹, bamboo slips, and 扁 for the sound. 扁, written 户 and 𠕁, is read biǎn: it no longer quite gives the sound of piān. A bundle of bound slips makes a text: 篇 counts articles and essays.","roles":{"⺮":"sens","户":"forme","𠕁":"forme"}}},"片":{"c":"片","pinyin":"piàn","lectures":["piàn","piān"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":[],"sources":[]},"mots":["L2-0415","L2-0552","L2-0641","L2-0678","L2-0719","L4-0076","L4-0195","L4-0523","L4-0557","L4-0805","L6-0237","L6-0758","L7-0708","L7-1910","L7-2057","L7-2325","L7-3109","L7-3118","L7-4616"],"chemin":{},"sens":{"statut":"relu","glose":"tranche ; classif. des choses plates","acceptions":[{"categorie":"M","fr":"classificateur des choses plates ou étendues : tranche, étendue"},{"categorie":"N","fr":"morceau plat, tranche"}]},"exemples":[{"zh":"我吃了两片面包。","pinyin":"Wǒ chī le liǎng piàn miànbāo.","fr":"J'ai mangé deux tartines.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi glose 片 par « bois fendu » : la moitié droite de 木. Un tronc fendu en deux donne une planche, un morceau plat. 片 compte les choses plates ou étendues : une tranche, une étendue.","en":"The Shuowen jiezi glosses 片 as “split wood”: the right half of 木. A trunk split in two gives a plank, a flat piece. 片 counts flat or spread-out things: a slice, a stretch.","roles":{}}},"骗":{"c":"骗","pinyin":"piàn","lectures":["piàn"],"niveau":5,"decomposition":{"norme":"GF 0014-2009","parts":["马","户","𠕁"],"sources":["cjk-decomp"]},"mots":["L5-0553","L5-0554","L7-3119","L7-3182","L7-3795","L7-5228"],"chemin":{},"sens":{"statut":"relu","glose":"tromper, duper, escroquer","acceptions":[{"categorie":"V","fr":"tromper, duper, escroquer ; mentir à"}]},"exemples":[{"zh":"你别骗我了。","pinyin":"Nǐ bié piàn wǒ le.","fr":"Arrête de me raconter des histoires.","statut":"relu"}],"origine":null},"飘":{"c":"飘","pinyin":"piāo","lectures":["piāo"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["覀","示","风"],"sources":["cjk-decomp"]},"mots":["L7-3121"],"chemin":{},"sens":{"statut":"relu","glose":"flotter, voltiger ; léger","acceptions":[{"categorie":"V","fr":"flotter, voltiger, onduler au vent"},{"categorie":"Adj","fr":"léger, flottant ; frivole"}]},"exemples":[{"zh":"雪花在空中飘。","pinyin":"Xuěhuā zài kōngzhōng piāo.","fr":"Les flocons tourbillonnent dans l'air.","statut":"relu"}],"origine":null},"漂":{"c":"漂","pinyin":"piào","lectures":["piào","piāo","piǎo"],"niveau":2,"decomposition":{"norme":"GF 0014-2009","parts":["氵","覀","示"],"sources":["cjk-decomp"]},"mots":["L2-0416","L7-3120"],"chemin":{},"sens":{"statut":"relu","glose":"flotter ; beau (dans piàoliang)","acceptions":[{"categorie":"V","fr":"flotter, dériver","pinyin":"piāo"},{"categorie":"Adj","fr":"beau, dans piàoliang"}]},"exemples":[{"zh":"河上漂着一条船。","pinyin":"Hé shang piāo zhe yī tiáo chuán.","fr":"Un bateau flotte sur la rivière.","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi glose 漂 par « flotter » : l'eau, 氵, et 票 pour le son. 票, écrit 覀 sur 示, se lit piào, la même syllabe que 漂. Lu piāo, c'est flotter ; dans 漂亮, lu piào, c'est être beau.","en":"The Shuowen jiezi glosses 漂 as “to float”: water, 氵, and 票 for the sound. 票, written 覀 over 示, is read piào, the same syllable as 漂. Read piāo, it means to float; in 漂亮, read piào, it means pretty.","roles":{"氵":"sens","覀":"son","示":"son"}}},"票":{"c":"票","pinyin":"piào","lectures":["piào"],"niveau":1,"decomposition":{"norme":"GF 0014-2009","parts":["覀","示"],"sources":["cjk-decomp"]},"mots":["L1-0043","L1-0163","L1-0240","L1-0285","L3-0537","L3-0857","L4-0220","L5-0074","L6-0337","L6-0819","L6-0827","L7-0405","L7-3122","L7-3800","L7-5160","L7-5342"],"chemin":{"hsk":169,"lire":152},"sens":{"statut":"relu","glose":"billet, bulletin de vote","acceptions":[]},"exemples":[{"zh":"你有票吗？","pinyin":"Nǐ yǒu piào ma?","fr":"Tu as un billet ?","statut":"relu"}],"origine":{"statut":"relu","etiquette":"atteste","fr":"Le Shuowen jiezi range 票 sous le feu, écrit alors avec 火 en bas, et le définit par des flammes qui s'envolent. Au fil des écritures, le feu s'est changé en 示 et le haut s'est réduit à 覀, deux éléments qui ne portent plus ni sens ni son. Le sens de billet, de bulletin, est un emploi plus tardif du caractère.","en":"The Shuowen jiezi files 票 under fire, written then with 火 at the bottom, and defines it as flames flying upward. Over the centuries the fire turned into 示 and the top shrank to 覀, two parts that no longer carry meaning or sound. The sense of ticket or ballot is a later use of the character.","roles":{"覀":"forme","示":"forme"}}},"撇":{"c":"撇","pinyin":"piē","lectures":["piē","piě"],"niveau":7,"decomposition":{"norme":"GF 0014-2009","parts":["扌","㡀","𠂉","乂"],"sources":["cjk-decomp"]},"mots":["L7-3123"],"chemin":{},"sens":{"statut":"relu","glose":"abandonner ; lancer ; trait oblique","acceptions":[{"categorie":"V","fr":"laisser de côté, abandonner"},{"categorie":"V","fr":"lancer ; tordre la bouche","pinyin":"piě"},{"categorie":"N","fr":"trait tombant vers la gauche (calligraphie)","pinyin":"piě"}]},"exemples":[{"zh":"他撇下家人一个人走了。","pinyin":"Tā piēxià jiārén yī ge rén zǒu le.","fr":"Il a laissé sa famille derrière lui et est parti seul.","statut":"relu"},{"zh":"这个字的第一笔是撇。","pinyin":"Zhège zì de dì-yī bǐ shì piě.","fr":"Le premier trait de ce caractère descend vers la 