  {
   "c": "那",
   "pinyin": "nà",
   "lectures": [
    "nà",
    "nā",
    "nǎ",
    "nǎi",
    "nè",
    "něi",
    "nèi"
   ],
   "fr": "cela, celui-là, là-bas",
   "en": "that, that one, over there",
   "parts": [
