   "statut": "relu"
  },
  {
   "c": "穿",
   "pinyin": "chuān",
   "lectures": [
    "chuān"
   ],
   "fr": "porter, mettre, traverser",
   "en": "to wear, to put on, to pierce",
   "parts": [
    "穴",
    "牙"
   ],
   "nouveau": [
    1
   ],
   "sources": [
    "cjk-decomp"
   ],
   "role": "sens",
   "roles": {
    "牙": "sens",
    "穴": "sens"
   },
   "origine_fr": "Le Shuowen jiezi glose 穿 par « percer de part en part » et le décrit comme des dents, 牙, dans un trou, 穴. On lit toujours 穴 en haut et 牙 en bas. De percer un passage, on est passé à y glisser le corps : 穿 veut dire aussi « enfiler un vêtement ».",
   "origine_en": "The Shuowen jiezi glosses 穿 as “to pierce through” and describes it as teeth, 牙, in a hole, 穴. You still read 穴 at the top and 牙 at the bottom. From boring a passage, the meaning moved to slipping one's body through: 穿 also means “to put on clothes”.",
   "etiquette": "atteste",
   "memo_fr": null,
   "memo_en": null,
   "mots": [
    {
     "hanzi": "穿衣",
     "pinyin": "chuānyī",
     "fr": "s'habiller",
     "en": "to get dressed",
     "audio": null
    },
    {
     "hanzi": "穿过",
     "pinyin": "chuānguò",
     "fr": "traverser",
     "en": "to go through, to cross",
     "audio": null
    }
   ],
   "phrase": {
    "hanzi": "今天很冷，多穿点衣服。",
    "pinyin": "Jīntiān hěn lěng, duō chuān diǎn yīfu.",
    "fr": "Il fait très froid aujourd'hui, habille-toi chaudement.",
    "en": "It is very cold today, put on more clothes.",
    "audio": null
   },
