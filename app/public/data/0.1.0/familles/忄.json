 "racine": {
  "c": "忄",
  "pinyin": "xin",
  "fr": "cœur (clé)",
  "en": "heart (radical)",
  "origine": "忄 est la forme de 心, le cœur, quand il se dresse à gauche d'un caractère ; on l'appelle 竖心旁, et la norme le nomme 竖心. Sur les os oraculaires et les bronzes, 心 dessine un cœur avec ses cavités, et la pensée chinoise ancienne y loge les sentiments autant que la réflexion. Il marque ce qu'on éprouve et ce qu'on comprend, comme dans 快, 忙 ou 懂.",
  "etiquette": "atteste"
 },
 "fiches": [
  {
