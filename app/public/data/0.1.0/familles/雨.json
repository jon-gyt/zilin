  },
  {
   "c": "零",
   "pinyin": "líng",
   "lectures": [
    "líng"
   ],
   "fr": "zéro, reste, fragment",
   "en": "zero, remainder, fraction",
   "parts": [
    "雨",
    "人",
    "丶",
